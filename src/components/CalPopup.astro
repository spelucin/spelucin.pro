---
import { Icon } from 'astro-icon/components';

interface Props {
  buttonLabel?: string;
  buttonClass?: string;
}

const { buttonLabel = 'Agendar una llamada', buttonClass = 'btn btn-secondary' } = Astro.props;
---

<div class="cal-popup-root">
  <button type="button" class={buttonClass} data-open-calpop aria-haspopup="dialog">
    {buttonLabel}
    <Icon name="tabler:arrow-right" width="16" height="16" aria-hidden="true" />
  </button>

  <dialog id="calPopup" class="cal-popup" aria-labelledby="calPopupTitle">
    <div class="cal-popup-inner">
      <header class="cal-popup-header">
        <div>
          <span class="font-mono text-[11px] tracking-[0.14em] uppercase text-primary">Agenda una llamada</span>
          <h3 id="calPopupTitle" class="text-[20px] font-semibold tracking-tight mt-1">Diagnóstico — 30 minutos</h3>
        </div>
        <button class="case-close" data-close-calpop aria-label="Cerrar">
          <Icon name="tabler:x" width="20" height="20" aria-hidden="true" />
        </button>
      </header>
      <div class="cal-popup-body">
        <div id="my-cal-inline-diagnostico"></div>
      </div>
    </div>
  </dialog>
</div>

<script type="text/javascript" is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "diagnostico", { origin: "https://app.cal.com" });
  Cal.config = Cal.config || {};
  Cal.config.forwardQueryParams = true;

  Cal.ns.diagnostico("inline", {
    elementOrSelector: "#my-cal-inline-diagnostico",
    config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
    calLink: "spelucin/diagnostico",
  });

  Cal.ns.diagnostico("ui", {
    cssVarsPerTheme: { light: { "cal-brand": "#60a5fa" }, dark: { "cal-brand": "#60a5fa" } },
    hideEventTypeDetails: false,
    layout: "month_view",
  });

  const openBtn = document.querySelector('[data-open-calpop]');
  const dialog = document.getElementById('calPopup');
  const closeBtn = document.querySelector('[data-close-calpop]');

  if (openBtn && dialog) {
    openBtn.addEventListener('click', () => {
      if (typeof dialog.showModal === 'function') dialog.showModal();
    });
    if (closeBtn) closeBtn.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .cal-popup {
    width: calc(100% - 32px);
    max-width: 760px;
    max-height: min(88vh, 820px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-primary-28);
    border-radius: 16px;
    background: var(--color-card);
    box-shadow: 0 24px 80px rgba(6, 10, 18, 0.7), 0 0 0 1px rgba(6, 10, 18, 0.6);
    color: var(--color-foreground);
    opacity: 0;
    transform: translateY(18px) scale(0.975);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cal-popup[open] { opacity: 1; transform: translateY(0) scale(1); }
  .cal-popup::backdrop {
    background: rgba(5, 8, 14, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .cal-popup[open]::backdrop { opacity: 1; }
  body:has(.cal-popup[open]) { overflow: hidden; }

  .cal-popup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    border-bottom: 1px solid var(--color-primary-10);
  }
  .cal-popup-body {
    max-height: calc(min(88vh, 820px) - 90px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 24px;
  }
  .cal-popup-body #my-cal-inline-diagnostico {
    width: 100%;
    height: 640px;
    min-height: 640px;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .cal-popup-body #my-cal-inline-diagnostico { height: 720px; min-height: 720px; }
  }

  .case-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-primary-4);
    color: var(--color-foreground);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .case-close:hover { background: var(--color-primary-10); border-color: var(--color-primary-35); }
</style>
