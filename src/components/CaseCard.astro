---
import VisualPanel from './VisualPanel.astro';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'trabajos'>;
  index?: string;
}

const { entry, index } = Astro.props;
const { data } = entry;
const image = data.image ?? '/assets/dashboard-mock-card.jpg';
---

<article class="case-card group overflow-hidden grid md:grid-cols-[320px_1fr] lg:grid-cols-[400px_1fr] h-full">
  <a
    href={`/portafolio/${entry.id}/`}
    class="relative h-[200px] md:h-auto border-b md:border-b-0 md:border-r border-primary-10 block"
    aria-label={`Ver caso: ${data.title}`}
  >
    <VisualPanel src={image} alt={`Vista de ${data.title}`} index={index} label={data.scope ?? data.category} />
  </a>

  <div class="flex flex-col justify-center p-8 md:p-10">
    <h3 class="text-[22px] md:text-[24px] font-semibold tracking-tight leading-[1.25]">
      <a href={`/portafolio/${entry.id}/`} class="hover:text-primary transition-colors">{data.title}</a>
    </h3>
    <p class="mt-3 text-[15px] leading-[1.6] text-muted-foreground max-w-[520px]">{data.description}</p>

    <div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-6">
      {data.tools.slice(0, 3).map((tool) => (
        <span class="tool-label">{tool}</span>
      ))}
    </div>

    <a
      href={`/portafolio/${entry.id}/`}
      class="card-action self-start mt-7"
      aria-label={`Ver caso: ${data.title}`}
    >
      Ver caso
      <Icon name="tabler:arrow-right" width="14" height="14" aria-hidden="true" />
    </a>
  </div>
</article>

<style>
  .case-card {
    border: 1px solid var(--color-primary-10);
    border-radius: var(--radius-sm);
    background: var(--color-card);
    transition: border-color 0.2s ease;
  }
  .case-card:hover {
    border-color: var(--color-primary-20);
  }
  .tool-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-55);
  }
  .card-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 600;
    transition: gap 0.2s ease;
  }
  .card-action svg { flex-shrink: 0; }
  .card-action:hover { gap: 9px; }
</style>
