---
import { getCaseStudies } from '../lib/content';

const caseStudies = await getCaseStudies();
const items = caseStudies.map(cs => cs.testimonial).filter(Boolean);
---

<section class="testimonials-section testimonials-service-section">
  <div class="max-w-5xl mx-auto px-6">
    <div style="display: flex; flex-direction: column; gap: 2rem">
      {items.map((t, i) => (
        <div
          class="reveal-stagger"
          style={`background: linear-gradient(135deg, rgba(21,96,189,0.03) 0%, rgba(21,96,189,0.01) 100%); border-radius: 1rem; padding: 2rem; border: 1px solid rgba(21,96,189,0.06)`}
        >
          <div class="testimonial-service-content">
            <div class="testimonial-topline"><span>Cliente</span><span>01</span></div>
            <div class="testimonial-service-quote">
              <p>{t.quote}</p>
            </div>

            <div class="testimonial-author">
              <div class="testimonial-avatar">
                <span>{t.name.charAt(0)}</span>
              </div>
              <div class="testimonial-author-copy">
                <span>{t.name}</span>
                <span>{t.role} · {t.store}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .testimonials-service-section { padding-top: 3rem; }
  .testimonial-service-content { display: flex; flex-direction: column; min-height: 16rem; }
  .testimonial-service-quote { flex: 1; padding: 1.5rem 0 2rem; }
  .testimonial-service-quote p { margin: 0; color: var(--color-foreground-70) !important; font: 500 1rem/1.7 'DM Sans', sans-serif; }
</style>
