---
import { Icon } from 'astro-icon/components';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHead from './SectionHead.astro';
import type { Translations } from '../i18n/types';
import { site } from '../data/site';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
---

<SiteHeader t={t} />

<main id="main-content">
  <section class="page-hero reveal">
    <div class="container-site">
      <p class="hero-eyebrow hero-eyebrow--status">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span>{t.contactPage.availability}</span>
      </p>
      <h1 class="hero-title">{t.contactPage.heading}</h1>
      <p class="hero-intro">{t.contactPage.sub}</p>

      <div class="actions">
        <a
          class="action-card action-card--primary"
          href={site.cal}
          data-cal-modal
          data-calendar
          data-calendar-location="contact"
          data-cta
          data-cta-location="contact"
        >
          <div class="action-card-icon">
            <Icon name="tabler:calendar-event" width="24" height="24" aria-hidden="true" />
          </div>
          <div class="action-card-content">
            <span class="action-label">{t.contactPage.calLabel}</span>
            <span class="action-value">cal.com/spelucin</span>
          </div>
          <span class="action-arrow">
            <Icon name="tabler:arrow-up-right" width="20" height="20" aria-hidden="true" />
          </span>
        </a>

        <a class="action-card" href={`mailto:${site.email}`} data-lead>
          <div class="action-card-icon">
            <Icon name="tabler:mail" width="24" height="24" aria-hidden="true" />
          </div>
          <div class="action-card-content">
            <span class="action-label">{t.contactPage.emailLabel}</span>
            <span class="action-value">{site.email}</span>
          </div>
          <span class="action-arrow">
            <Icon name="tabler:arrow-up-right" width="20" height="20" aria-hidden="true" />
          </span>
        </a>

        <a
          class="action-card"
          href={site.linkedin}
          target="_blank"
          rel="noopener"
          data-cta
          data-cta-location="contact"
        >
          <div class="action-card-icon">
            <Icon name="tabler:brand-linkedin" width="24" height="24" aria-hidden="true" />
          </div>
          <div class="action-card-content">
            <span class="action-label">{t.contactPage.linkedinLabel}</span>
            <span class="action-value">/in/spelucin</span>
          </div>
          <span class="action-arrow">
            <Icon name="tabler:arrow-up-right" width="20" height="20" aria-hidden="true" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="process section-block reveal">
    <div class="container-site">
      <SectionHead
        index={t.process.index}
        heading={t.lang === 'es' ? 'Así empieza el trabajo.' : 'This is how the work starts.'}
        intro={t.lang === 'es' ? 'Primero entendemos el problema. Después decidimos qué vale la pena construir.' : 'First we understand the problem. Then we decide what is worth building.'}
      />

      <ol class="process-grid">
        {t.process.steps.map((step, i) => (
          <li class="process-card">
            <div class="process-card-header">
              <span class="step-num">0{i + 1}</span>
              <Icon name="tabler:check" width="16" height="16" aria-hidden="true" />
            </div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</main>

<SiteFooter t={t} />

<script>
  import '../scripts/reveal';
</script>

<style>
  .hero-eyebrow--status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #28c840;
    box-shadow: 0 0 10px #28c840;
  }

  .actions {
    display: grid;
    gap: 16px;
    margin-top: 48px;
  }
  .action-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 28px;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    color: var(--color-foreground);
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .action-card:hover {
    border-color: var(--color-primary-35);
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(4, 8, 16, 0.4);
  }
  .action-card--primary {
    border-color: var(--color-primary-28);
    background: linear-gradient(135deg, rgba(15, 18, 25, 0.95), rgba(21, 96, 189, 0.1));
  }
  .action-card--primary:hover {
    border-color: var(--color-primary);
  }

  .action-card-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-md);
    background: var(--color-primary-4);
    color: var(--color-primary);
    flex-shrink: 0;
  }
  .action-card-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
  }
  .action-label {
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .action-value {
    color: var(--color-foreground-55);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .action-arrow {
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }
  .action-card:hover .action-arrow {
    transform: translate(3px, -3px);
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .process-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-md);
    background: var(--color-card);
    transition: border-color 0.2s ease;
  }
  .process-card:hover {
    border-color: var(--color-primary-35);
  }
  .process-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .step-num {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .process-card-header svg {
    color: var(--color-primary-35);
  }
  .process-card h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .process-card p {
    margin: 0;
    color: var(--color-foreground-55);
    font-size: 14.5px;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .actions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .action-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 28px;
    }
    .action-arrow {
      position: absolute;
      top: 24px;
      right: 24px;
    }
    .process-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }
  }
</style>
