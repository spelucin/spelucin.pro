<button
  class="theme-toggle"
  type="button"
  aria-label="Activar modo oscuro"
  aria-pressed="false"
  title="Activar modo oscuro"
>
  <svg class="theme-icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/>
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
  <svg class="theme-icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="sr-only">Cambiar tema</span>
</button>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

  const applyToggleState = (theme: string) => {
    const isDark = theme === 'dark';
    const label = isDark ? 'Activar modo claro' : 'Activar modo oscuro';
    toggles.forEach((toggle) => {
      toggle.setAttribute('aria-pressed', String(isDark));
      toggle.setAttribute('aria-label', label);
      toggle.setAttribute('title', label);
    });
    document.querySelectorAll<HTMLElement>('.theme-toggle-mobile-label').forEach((el) => {
      el.textContent = isDark ? 'Modo claro' : 'Modo oscuro';
    });
  };

  const currentTheme = () => document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

  applyToggleState(currentTheme());

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const theme = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      localStorage.setItem('theme', theme);
      applyToggleState(theme);
    });
  });

  window.addEventListener('storage', (event) => {
    if (event.key !== 'theme' || !event.newValue) return;
    document.documentElement.dataset.theme = event.newValue;
    applyToggleState(event.newValue);
  });
</script>
