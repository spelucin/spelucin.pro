---
import type { CaseStudyWithSeo } from '../lib/content';
import IconArrowRight from './IconArrowRight.astro';

interface Props {
  cs: CaseStudyWithSeo;
  index?: number;
}

const { cs, index = 0 } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const meta = [cs.industry, cs.platform, cs.market, cs.timeline].filter(Boolean).join(' · ');
---

<a
  href={`/casos-de-estudio/${cs.slug}/`}
  class="case-card track-case-study"
  data-cs-name={cs.client}
  data-cs-slug={cs.slug}
  data-cs-industry={cs.industry}
>
  <div class="case-card-media">
    {cs.cover ? (
      <img src={cs.cover} alt={cs.client} loading="lazy" />
    ) : (
      <div class="case-card-placeholder" aria-hidden="true">
        <span>{number}</span>
      </div>
    )}
  </div>

  <div class="case-card-body">
    <div class="case-card-meta">
      <span class="case-card-index">{number}</span>
      <span class="case-card-meta-text">{meta}</span>
    </div>

    <h2 class="case-card-title">{cs.client}</h2>

    <p class="case-card-description">{cs.shortDescription || cs.summary}</p>

    <div class="case-card-foot">
      <div class="case-card-stats">
        {cs.results.slice(0, 3).map((m) => (
          <div class="case-card-stat">
            <span class="case-card-stat-value">{m.value}</span>
            <span class="case-card-stat-label">{m.label}</span>
          </div>
        ))}
      </div>
      <span class="case-card-arrow" aria-hidden="true">
        <IconArrowRight size={16} />
      </span>
    </div>
  </div>
</a>

<script>
  document.querySelectorAll('.track-case-study').forEach((el) => {
    el.addEventListener('click', () => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'case_study_click',
        case_study_name: el.getAttribute('data-cs-name') || '',
        case_study_slug: el.getAttribute('data-cs-slug') || '',
        case_study_industry: el.getAttribute('data-cs-industry') || '',
      });
    });
  });
</script>

<style is:global>
  .case-card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    border: 1px solid var(--color-primary-10);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 240ms ease,
      box-shadow 240ms ease;
  }
  .case-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary-35);
    box-shadow: var(--shadow-elevated);
  }
  .case-card:active {
    transform: translateY(-1px) scale(0.995);
  }

  .case-card-media {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: var(--color-primary-6);
  }
  .case-card-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .case-card:hover .case-card-media img {
    transform: scale(1.045);
  }

  .case-card-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background-image: var(--dot-grid);
    background-size: 24px 24px;
    color: var(--color-primary-35);
  }
  .case-card-placeholder span {
    font: 600 3rem/1 var(--font-mono);
    letter-spacing: -0.03em;
  }

  .case-card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.85rem;
    padding: 2.25rem 2.5rem;
    min-width: 0;
  }

  .case-card-meta {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    width: 100%;
  }
  .case-card-index {
    flex-shrink: 0;
    color: var(--color-primary);
    font: 600 0.72rem/1.2 var(--font-mono);
    letter-spacing: 0.1em;
  }
  .case-card-meta-text {
    color: var(--color-foreground-40);
    font: 500 0.68rem/1.2 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-card-title {
    margin: 0;
    color: var(--color-foreground);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .case-card-description {
    margin: 0;
    color: var(--color-prose-muted);
    font-size: 0.925rem;
    line-height: 1.7;
    max-width: 52ch;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .case-card-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    margin-top: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-primary-8);
  }
  .case-card-stats {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
  }
  .case-card-stat + .case-card-stat {
    border-left: 1px solid var(--color-primary-10);
    padding-left: 1.75rem;
  }
  .case-card-stat-value {
    display: block;
    color: var(--color-primary);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 0.35rem;
  }
  .case-card-stat-label {
    display: block;
    color: var(--color-foreground-40);
    font: 500 0.62rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-card-arrow {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border: 1px solid var(--color-primary-20);
    border-radius: 9999px;
    background: var(--color-primary-4);
    color: var(--color-primary);
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 220ms ease,
      border-color 220ms ease,
      color 220ms ease;
  }
  .case-card:hover .case-card-arrow {
    transform: translateX(4px);
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-foreground);
  }

  @media (max-width: 767px) {
    .case-card {
      grid-template-columns: 1fr;
    }
    .case-card-media {
      aspect-ratio: 16 / 9;
      min-height: auto;
    }
    .case-card-body {
      padding: 1.5rem 1.25rem;
    }
    .case-card-stats {
      gap: 1.25rem;
    }
    .case-card-stat + .case-card-stat {
      padding-left: 1.25rem;
    }
    .case-card-foot {
      flex-wrap: wrap;
      align-items: center;
    }
  }
</style>
