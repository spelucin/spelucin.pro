---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHead from './SectionHead.astro';
import BookCall from './BookCall.astro';
import Faq from './Faq.astro';
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
---

<SiteHeader t={t} />

<main id="main-content">
  <section class="page-hero reveal">
    <div class="container-site">
      <p class="hero-eyebrow">{t.services.hero.badge}</p>
      <h1 class="hero-title">{t.services.hero.headline} <span class="text-primary">{t.services.hero.highlight}</span></h1>
      <p class="hero-intro">{t.services.hero.sub}</p>
    </div>
  </section>

  <section class="components section-block reveal">
    <div class="container-site">
      <SectionHead
        heading={t.services.components.heading}
        highlight={t.services.components.highlight}
        intro={t.services.components.intro}
      />

      <div class="components-grid">
        {t.services.components.items.map((item, i) => (
          <article class="component-card">
            <span class="row-number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <ul class="chips-list" role="list">
              {item.tags.map((tag) => (
                <li class="chip">{tag}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Faq
    heading={t.services.faq.heading}
    highlight={t.services.faq.highlight}
    items={t.services.faq.items}
  />

  <BookCall t={t} location="services" />
</main>

<SiteFooter t={t} />

<script>
  import '../scripts/reveal';
</script>

<style>
  .components-grid { display: grid; gap: 18px; }
  .component-card { display: flex; flex-direction: column; gap: 12px; padding: 26px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-md); background: var(--color-card); transition: border-color 0.2s ease, transform 0.2s ease; }
  .component-card:hover { border-color: var(--color-primary-35); transform: translateY(-2px); }
  .row-number { color: var(--color-primary); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; }
  .component-card h3 { margin: 0; font-size: 20px; font-weight: 650; letter-spacing: -0.02em; }
  .component-card p { margin: 0; color: var(--color-foreground-55); font-size: 15px; line-height: 1.6; flex-grow: 1; }
  .chips-list { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; padding: 0; list-style: none; }

  @media (min-width: 768px) {
    .components-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .components { padding-top: 48px; }
  .component-card { min-height: 260px; border-radius: var(--radius-sm); box-shadow: 6px 6px 0 rgba(96, 165, 250, 0.05); }
  .component-card:nth-child(2) { transform: translateY(24px); }
  .component-card:nth-child(2):hover { transform: translateY(20px); }
  .component-card:nth-child(5) { transform: translateY(24px); }
  .component-card:nth-child(5):hover { transform: translateY(20px); }

  @media (max-width: 767px) {
    .component-card:nth-child(2), .component-card:nth-child(5) { transform: none; }
    .component-card:nth-child(2):hover, .component-card:nth-child(5):hover { transform: translateY(-2px); }
  }
</style>
