---
import { Icon } from 'astro-icon/components';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHead from './SectionHead.astro';
import StatsBlocks from './StatsBlocks.astro';
import BookCall from './BookCall.astro';
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
---

<SiteHeader t={t} />

<main id="main-content">
  <section class="page-hero reveal">
    <div class="container-site">
      <p class="hero-eyebrow">{t.services.hero.badge}</p>
      <h1 class="hero-title">{t.services.hero.headline} <span class="text-primary">{t.services.hero.highlight}</span></h1>
      <p class="hero-intro">{t.services.hero.sub}</p>
    </div>
  </section>

  <section class="components section-block reveal">
    <div class="container-site">
      <SectionHead
        index={t.services.components.index}
        heading={t.services.components.heading}
        highlight={t.services.components.highlight}
        intro={t.services.components.intro}
      />

      <div class="components-grid">
        {t.services.components.items.map((item, i) => (
          <article class="component-card">
            <span class="row-number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <ul class="chips-list" role="list">
              {item.tags.map((tag) => (
                <li class="chip">{tag}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="proof section-block reveal">
    <div class="container-site">
      <SectionHead
        index={t.services.proof.index}
        heading={t.services.proof.heading}
        highlight={t.services.proof.highlight}
        intro={t.services.proof.intro}
      />

      <StatsBlocks stats={t.services.proof.stats} />
    </div>
  </section>

  <section class="faq section-block reveal">
    <div class="container-site faq-container">
      <SectionHead
        flush
        index={t.services.faq.index}
        heading={t.services.faq.heading}
        highlight={t.services.faq.highlight}
      />

      <div class="faq-list">
        {t.services.faq.items.map((item, i) => (
          <details>
            <summary>
              <span class="faq-q-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-q">{item.q}</span>
              <Icon name="tabler:plus" width="18" height="18" aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <BookCall t={t} location="services" />
</main>

<SiteFooter t={t} />

<script>
  import '../scripts/reveal';
</script>

<style>
  .components-grid { display: grid; gap: 18px; }
  .component-card { display: flex; flex-direction: column; gap: 12px; padding: 26px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-md); background: var(--color-card); transition: border-color 0.2s ease, transform 0.2s ease; }
  .component-card:hover { border-color: var(--color-primary-35); transform: translateY(-2px); }
  .row-number { color: var(--color-primary); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; }
  .component-card h3 { margin: 0; font-size: 20px; font-weight: 650; letter-spacing: -0.02em; }
  .component-card p { margin: 0; color: var(--color-foreground-55); font-size: 15px; line-height: 1.6; flex-grow: 1; }
  .chips-list { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; padding: 0; list-style: none; }

  .faq-container { display: grid; gap: 48px; }
  .faq-list { border-top: 1px solid var(--color-primary-14); }
  .faq-list details { border-bottom: 1px solid var(--color-primary-14); }
  .faq-list summary { display: grid; grid-template-columns: 44px 1fr auto; gap: 18px; align-items: baseline; padding: 22px 0; list-style: none; cursor: pointer; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-q-num { color: var(--color-primary); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; }
  .faq-q { color: var(--color-foreground); font-size: 18px; font-weight: 550; letter-spacing: -0.015em; }
  .faq-list summary svg { align-self: center; color: var(--color-primary-35); transition: transform 0.2s ease, color 0.2s ease; }
  .faq-list details[open] summary svg { transform: rotate(45deg); color: var(--color-primary); }
  .faq-list details p { grid-column: 2 / 4; max-width: 58ch; margin: -4px 0 26px; color: var(--color-foreground-55); font-size: 15px; line-height: 1.6; }

  @media (min-width: 768px) {
    .components-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
