---
import Eyebrow from './Eyebrow.astro';
import { rule } from '../data';

const testimonials = [
  {
    quote:
      'Alex es un profesional SEO con gran conocimiento técnico y sentido crítico. Tuvimos la oportunidad de optimizar un sitio enfocado en una vertical complicada como lo es banca. Se enfoca en las necesidades del negocio y en conjunto desarrollamos una estrategia de posicionamiento orgánico efectiva. También debo destacar su compromiso y la forma profesional en que lleva sus proyectos.',
    name: 'Miguel Huahuala',
    role: 'Content Lead en Scotiabank',
    context: 'Miguel trabajó con Alex en distintas empresas',
  },
  {
    quote:
      'Alex es un excelente profesional con un extenso conocimiento a nivel técnico. Se capacita constantemente en SEO y en temas de tecnología complementarios a este, logrando intersecciones de conocimiento fascinantes sin perder el foco en el crecimiento del negocio y los objetivos del cliente.',
    name: 'Darío Vergara',
    role: 'SEO Lead en Attach Media',
    context: 'Alex supervisaba a Darío',
  },
  {
    quote:
      'Alex tiene un gran manejo y análisis SEO orientado a los resultados en posicionamiento. Así mismo, su compromiso y orientación al servicio nos dio seguridad en cada etapa del proyecto.',
    name: 'Alexis Pinedo',
    role: 'Product Manager en LeaseIn',
    context: 'Alex fue proveedor de Alexis',
  },
];
---

<section class="testimonials-section">
  <div class="max-w-5xl mx-auto px-6 reveal">
    <div class="editorial-rule" />

    <div class="testimonials-heading">
      <Eyebrow>Testimonios</Eyebrow>
      <h2>
        Lo que dicen quienes trabajaron conmigo.
      </h2>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((t, i) => (
        <div class={`testimonial-glass reveal-stagger${i === 0 ? ' testimonial-wide' : ''}`}>
          <div class="testimonial-topline">
            <span>0{i + 1}</span>
            <span>Recomendación</span>
          </div>
          <p class="testimonial-quote">{t.quote}</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">
              <span>{t.name.charAt(0)}</span>
            </div>
            <div class="testimonial-author-copy">
              <span>{t.name}</span>
              <span>{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .testimonials-section {
    padding: 7rem 0 8rem;
    background: var(--color-background);
  }
  .testimonials-heading {
    padding-top: 2rem;
    margin-bottom: 2.75rem;
  }
  .testimonials-heading h2 {
    max-width: 20ch;
    margin: 0.6rem 0 0;
    color: var(--color-foreground) !important;
    font: 700 clamp(2rem, 4vw, 3.5rem)/1.02 'DM Sans', sans-serif;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .testimonial-glass {
    position: relative;
    min-height: 18rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-card);
    font-family: 'DM Sans', sans-serif;
    transition: border-color 180ms ease, transform 180ms ease, background 180ms ease;
  }
  .testimonial-glass:hover {
    border-color: var(--color-primary-35);
    background: #18202b;
    transform: translateY(-3px);
  }
  .testimonial-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-primary);
    font: 600 0.65rem/1 'DM Sans', sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .testimonial-topline span:last-child { color: var(--color-foreground-40); }
  .testimonial-quote {
    flex: 1;
    margin: 1.5rem 0 2rem;
    max-width: 64ch;
    color: var(--color-foreground-70) !important;
    font: 500 1.02rem/1.65 'DM Sans', sans-serif;
    letter-spacing: -0.012em;
  }
  .testimonial-wide .testimonial-quote { max-width: 78ch; font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.55; }
  .testimonial-author { display: flex; align-items: center; gap: 0.75rem; }
  .testimonial-avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    border: 1px solid var(--color-primary-35);
    border-radius: 0.65rem;
    background: var(--color-secondary);
    color: var(--color-primary);
    font: 700 0.9rem/1 'DM Sans', sans-serif;
  }
  .testimonial-author-copy { display: flex; flex-direction: column; gap: 0.2rem; }
  .testimonial-author-copy span:first-child { color: var(--color-foreground); font: 600 0.85rem/1.2 'DM Sans', sans-serif; }
  .testimonial-author-copy span:last-child { color: var(--color-foreground-50); font: 400 0.72rem/1.3 'DM Sans', sans-serif; }
  @media (min-width: 768px) {
    .testimonial-wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 767px) {
    .testimonials-section { padding: 5rem 0 6rem; }
    .testimonials-grid { grid-template-columns: 1fr; }
    .testimonial-wide { grid-column: auto; }
  }
</style>
