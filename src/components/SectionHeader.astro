---
interface Props {
  title: string;
  accent?: string;
  subtitle?: string;
  eyebrow?: string;
}

const { title, accent, subtitle, eyebrow } = Astro.props;
---

<div class="max-w-[720px] mb-16 text-left reveal">
  {eyebrow && (
    <p class="font-mono text-[13px] tracking-[0.14em] uppercase text-primary mb-3">{eyebrow}</p>
  )}
  <h2 class="text-[26px] md:text-[32px] font-semibold tracking-tight leading-[1.2]">
    {title}{accent && <> <span class="text-primary">{accent}</span></>}
  </h2>
  {subtitle && <p class="mt-[18px] text-base leading-[1.6] text-muted-foreground">{subtitle}</p>}
</div>
