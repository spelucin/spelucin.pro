---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="sprint-positioning">
  <div class="max-w-5xl mx-auto px-6 reveal">
    <div class="sprint-positioning-grid">
      <div class="sprint-positioning-lead">
        <div class="sprint-positioning-icon" aria-hidden="true">
          <slot name="icon" />
        </div>
        <p>{title}</p>
      </div>
      <p class="sprint-positioning-description">{description}</p>
    </div>
  </div>
</section>

<style is:global>
  .sprint-positioning {
    padding: 6rem 0;
    background: var(--color-background);
  }
  .sprint-positioning-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 3rem;
    align-items: center;
  }
  .sprint-positioning-lead p {
    max-width: 28ch;
    margin: 0;
    color: var(--color-foreground-70) !important;
    font: 500 1.2rem/1.55 'DM Sans', sans-serif;
    letter-spacing: -0.025em;
  }
  .sprint-positioning-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--color-primary-35);
    border-radius: 0.65rem;
    background: var(--color-primary-8);
    color: var(--color-primary);
  }
  .sprint-positioning-icon svg { width: 1.45rem; height: 1.45rem; }
  .sprint-positioning-description {
    max-width: 58ch;
    margin: 0;
    color: var(--color-prose-muted) !important;
    font: 400 0.95rem/1.75 'DM Sans', sans-serif;
  }
  @media (max-width: 767px) {
    .sprint-positioning { padding: 4.5rem 0; }
    .sprint-positioning-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
