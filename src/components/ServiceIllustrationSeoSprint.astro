---
// Shopify SEO Sprint: audit dashboard with technical/strategy KPIs,
// prioritized findings and a 90-day action plan.
---
<svg viewBox="0 0 320 280" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: auto; display: block">
  <defs>
    <linearGradient id="seoBar" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f8fbff" />
      <stop offset="100%" stop-color="#f0f6ff" />
    </linearGradient>
    <linearGradient id="seoGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1560bd" stop-opacity="0.05" />
      <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.04" />
    </linearGradient>
  </defs>

  {/* Browser frame */}
  <rect x="10" y="8" width="300" height="220" rx="10" fill="#fff" stroke="rgba(21,96,189,0.18)" stroke-width="1.5" />
  <rect x="10" y="8" width="300" height="34" rx="10" fill="url(#seoBar)" />
  <rect x="10" y="32" width="300" height="10" fill="url(#seoBar)" />

  {/* Traffic lights */}
  <circle cx="28" cy="25" r="4" fill="rgba(255,95,87,0.7)" />
  <circle cx="42" cy="25" r="4" fill="rgba(255,189,46,0.7)" />
  <circle cx="56" cy="25" r="4" fill="rgba(39,201,63,0.7)" />

  {/* URL bar */}
  <rect x="72" y="17" width="200" height="16" rx="8" fill="rgba(21,96,189,0.06)" stroke="rgba(21,96,189,0.10)" stroke-width="0.8" />
  <text x="82" y="28.5" font-family="DM Sans, sans-serif" font-size="8" fill="rgba(21,96,189,0.45)" font-weight="500">tu-tienda.mx/sprint</text>

  {/* Divider */}
  <line x1="10" y1="42" x2="310" y2="42" stroke="rgba(21,96,189,0.10)" stroke-width="1" />

  {/* Title row */}
  <text x="22" y="60" font-family="DM Sans, sans-serif" font-size="8.5" fill="rgba(13,31,60,0.75)" font-weight="700" letter-spacing="0.06em">SHOPIFY SEO SPRINT</text>
  <rect x="246" y="48" width="54" height="15" rx="7.5" fill="rgba(21,96,189,0.10)" />
  <text x="273" y="58.5" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="7" fill="#1560bd" font-weight="700">Sprint</text>

  {/* KPI cards */}
  <rect x="22" y="66" width="135" height="34" rx="7" fill="rgba(21,96,189,0.04)" stroke="rgba(21,96,189,0.08)" stroke-width="0.8" />
  <text x="30" y="79" font-family="DM Sans, sans-serif" font-size="6.5" fill="rgba(13,31,60,0.40)" font-weight="700" letter-spacing="0.06em">TÉCNICO</text>
  <text x="30" y="95" font-family="DM Sans, sans-serif" font-size="16" fill="#c0392b" font-weight="700">8</text>
  <text x="44" y="95" font-family="DM Sans, sans-serif" font-size="7" fill="rgba(13,31,60,0.40)" font-weight="500">errores</text>

  <rect x="163" y="66" width="135" height="34" rx="7" fill="rgba(124,58,237,0.03)" stroke="rgba(124,58,237,0.10)" stroke-width="0.8" />
  <text x="171" y="79" font-family="DM Sans, sans-serif" font-size="6.5" fill="rgba(13,31,60,0.40)" font-weight="700" letter-spacing="0.06em">ESTRATEGIA</text>
  <text x="171" y="95" font-family="DM Sans, sans-serif" font-size="16" fill="#7c3aed" font-weight="700">14</text>
  <text x="185" y="95" font-family="DM Sans, sans-serif" font-size="7" fill="rgba(13,31,60,0.40)" font-weight="500">oportunidades</text>

  {/* Findings table */}
  <rect x="22" y="108" width="276" height="18" rx="4" fill="rgba(21,96,189,0.04)" />
  <text x="30" y="120" font-family="DM Sans, sans-serif" font-size="6.5" fill="rgba(13,31,60,0.50)" font-weight="700" letter-spacing="0.05em">HALLAZGO</text>
  <text x="208" y="120" font-family="DM Sans, sans-serif" font-size="6.5" fill="rgba(13,31,60,0.50)" font-weight="700" letter-spacing="0.05em">IMPACTO</text>
  <text x="272" y="120" font-family="DM Sans, sans-serif" font-size="6.5" fill="rgba(13,31,60,0.50)" font-weight="700" letter-spacing="0.05em">PRIOR.</text>

  <rect x="22" y="126" width="276" height="14" fill="rgba(21,96,189,0.02)" />
  <text x="30" y="136" font-family="monospace" font-size="6.5" fill="rgba(13,31,60,0.65)">Canibalización de colecciones</text>
  <rect x="206" y="127" width="34" height="12" rx="6" fill="rgba(192,57,43,0.10)" />
  <text x="223" y="135.5" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="6" fill="#c0392b" font-weight="600">Alto</text>
  <rect x="266" y="127" width="24" height="12" rx="4" fill="rgba(21,96,189,0.08)" />
  <text x="278" y="135.5" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="6.5" fill="rgba(13,31,60,0.50)" font-weight="700">P1</text>

  <rect x="22" y="140" width="276" height="14" fill="transparent" />
  <text x="30" y="150" font-family="monospace" font-size="6.5" fill="rgba(13,31,60,0.65)">Páginas delgadas sin contenido</text>
  <rect x="206" y="141" width="34" height="12" rx="6" fill="rgba(192,57,43,0.10)" />
  <text x="223" y="149.5" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="6" fill="#c0392b" font-weight="600">Alto</text>
  <rect x="266" y="141" width="24" height="12" rx="4" fill="rgba(21,96,189,0.08)" />
  <text x="278" y="149.5" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="6.5" fill="rgba(13,31,60,0.50)" font-weight="700">P1</text>

  <rect x="22" y="154" width="276" height="14" fill="rgba(21,96,189,0.02)" />
  <text x="30" y="164" font-family="monospace" font-size="6.5" fill="rgba(13,31,60,0.65)">URLs duplicadas por facetas</text>
  <rect x="206" y="155" width="34" height="12" rx="6" fill="rgba(180,130,0,0.10)" />
  <text x="223" y="163.5" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="6" fill="rgba(180,130,0,0.85)" font-weight="600">Medio</text>
  <rect x="266" y="155" width="24" height="12" rx="4" fill="rgba(21,96,189,0.08)" />
  <text x="278" y="163.5" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="6.5" fill="rgba(13,31,60,0.50)" font-weight="700">P2</text>

  {/* Divider */}
  <line x1="22" y1="172" x2="298" y2="172" stroke="rgba(21,96,189,0.06)" stroke-width="1" />

  {/* Plan de acción */}
  <text x="22" y="186" font-family="DM Sans, sans-serif" font-size="6.5" fill="rgba(13,31,60,0.40)" font-weight="700" letter-spacing="0.06em">PLAN DE ACCIÓN 90 DÍAS</text>

  {/* Timeline */}
  <rect x="34" y="200" width="244" height="3" rx="1.5" fill="rgba(21,96,189,0.10)" />
  <path d="M57 196 L63 196 L60 199 Z" fill="#1560bd" />
  <circle cx="60" cy="201.5" r="5" fill="#1560bd" />
  <circle cx="120" cy="201.5" r="5" fill="rgba(21,96,189,0.20)" />
  <circle cx="180" cy="201.5" r="5" fill="rgba(21,96,189,0.20)" />
  <circle cx="240" cy="201.5" r="5" fill="rgba(21,96,189,0.20)" />

  <text x="60" y="211" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="5.5" fill="#1560bd" font-weight="700">Q1</text>
  <text x="120" y="211" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="5.5" fill="rgba(13,31,60,0.35)" font-weight="600">Q2</text>
  <text x="180" y="211" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="5.5" fill="rgba(13,31,60,0.35)" font-weight="600">Q3</text>
  <text x="240" y="211" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="5.5" fill="rgba(13,31,60,0.35)" font-weight="600">Q4</text>

  {/* Unification footer */}
  <rect x="22" y="214" width="276" height="14" rx="7" fill="url(#seoGrad)" stroke="rgba(21,96,189,0.08)" stroke-width="0.6" />
  <text x="30" y="223.5" font-family="DM Sans, sans-serif" font-size="6.5" fill="rgba(13,31,60,0.50)">Auditoría Técnica + Estrategia → un solo plan priorizado</text>
</svg>
