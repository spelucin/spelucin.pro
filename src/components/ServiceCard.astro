---
interface Props {
  slug: string;
  name: string;
  price: string;
  description: string;
  deliverables: string[];
  learnMoreSlug?: string;
}

const { slug, name, price, description, deliverables, learnMoreSlug } = Astro.props;
---

<div class="service-editorial-card reveal">
  <div class="service-card-header">
    <h3 class="service-card-title">{name}</h3>
    <div class="service-card-price">{price}</div>
  </div>
  
  <p class="service-card-description">{description}</p>
  
  <div class="service-card-divider" aria-hidden="true"></div>
  
  <div class="service-card-deliverables">
    <div class="deliverables-title">Entregables típicos:</div>
    <ul class="deliverables-list">
      {deliverables.map((item) => (
        <li class="deliverables-item">
          <svg class="deliverable-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="service-card-footer">
    {learnMoreSlug ? (
      <a href={`/escritura/${learnMoreSlug}/`} class="service-card-learn-more">
        Aprende más sobre {name.toLowerCase()} &rarr;
      </a>
    ) : (
      <div style="flex: 1;"></div>
    )}
    <a href="/contacto/" class="btn btn-secondary btn-sm">
      Reservar consulta
    </a>
  </div>
</div>

<style is:global>
  .service-editorial-card {
    padding: 2.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s, border-color 0.2s;
  }
  .service-editorial-card:hover {
    border-color: var(--color-primary);
  }

  .service-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .service-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-foreground);
    letter-spacing: -0.025em;
    margin: 0;
    line-height: 1.2;
  }

  .service-card-price {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-primary);
    background: rgba(21, 96, 189, 0.08);
    padding: 0.25rem 0.625rem;
    border-radius: 99px;
    white-space: nowrap;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  html.dark .service-card-price {
    background: rgba(77, 143, 224, 0.12);
  }

  .service-card-description {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-prose);
    margin: 0 0 1.5rem;
    flex-grow: 1;
  }

  .service-card-divider {
    height: 1px;
    background: var(--color-border);
    margin-bottom: 1.5rem;
  }

  .service-card-deliverables {
    margin-bottom: 2rem;
  }

  .deliverables-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
    margin-bottom: 0.75rem;
  }

  .deliverables-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .deliverables-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-prose-muted);
  }

  .deliverable-check {
    color: var(--color-primary);
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .service-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .service-card-learn-more {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .service-card-learn-more:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .service-editorial-card {
      padding: 1.5rem;
    }
    .service-card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .service-card-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
    .service-card-footer .btn {
      text-align: center;
      justify-content: center;
    }
  }
</style>
