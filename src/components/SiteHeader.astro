---
import { Icon } from 'astro-icon/components';
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const currentLang = t.lang;
const homeHref = currentLang === 'es' ? '/' : '/en/';
---

<header class="site-header">
  <div class="container-site header-inner">
    <a href={homeHref} class="brand" aria-label={t.hero.role}>
      <img src="/assets/logo.svg" alt="" width="20" height="20" loading="eager" />
      <span>Alex Spelucin</span>
    </a>

    <nav class="nav-desktop" aria-label={t.header.navAria}>
      {t.nav.map((item) => (
        <a href={item.href} data-nav-link>
          <span class="nav-index" aria-hidden="true">{item.index}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-right">
      <nav class="lang" aria-label={t.header.langLabel}>
        <a href="/" lang="es" hreflang="es" aria-current={currentLang === 'es' ? 'true' : undefined}>ES</a>
        <a href="/en/" lang="en" hreflang="en" aria-current={currentLang === 'en' ? 'true' : undefined}>EN</a>
      </nav>

      <details class="menu-mobile">
        <summary aria-label={t.header.menuOpen} aria-expanded="false">
          <span class="menu-toggle" aria-hidden="true">
            <span class="menu-toggle-icon menu-toggle-icon--open">
              <Icon name="tabler:menu-deep" width="22" height="22" />
            </span>
            <span class="menu-toggle-icon menu-toggle-icon--close">
              <Icon name="tabler:x" width="22" height="22" />
            </span>
          </span>
        </summary>
        <nav class="menu-mobile-panel" aria-label={t.header.navAria}>
          {t.nav.map((item) => (
            <a href={item.href}>
              <span class="nav-index" aria-hidden="true">{item.index}</span>
              <span>{item.label}</span>
              <span class="panel-arrow" aria-hidden="true">
                <Icon name="tabler:chevron-right" width="18" height="18" />
              </span>
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const links = document.querySelectorAll('[data-nav-link]');
  const targets = Array.from(links)
    .map((link) => document.querySelector(link.getAttribute('href')!))
    .filter((el): el is Element => el !== null);

  if (targets.length > 1) {
    const setActive = (id: string) => {
      links.forEach((link) => {
        const active = link.getAttribute('href') === `#${id}`;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: '-30% 0px -60% 0px', threshold: 0 },
    );
    targets.forEach((section) => observer.observe(section));

    const lastLink = links[links.length - 1];
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8) {
            setActive(lastLink.getAttribute('href')!.slice(1));
          }
          ticking = false;
        });
      },
      { passive: true },
    );
  }

  const menu = document.querySelector<HTMLDetailsElement>('.menu-mobile');
  const summary = menu?.querySelector('summary');
  menu?.addEventListener('toggle', () => {
    summary?.setAttribute('aria-expanded', String(menu.open));
  });

  document.querySelectorAll('.menu-mobile-panel a').forEach((link) => {
    link.addEventListener('click', () => {
      const details = link.closest('details');
      if (details) details.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 64px;
    background: rgba(10, 13, 20, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-primary-8);
  }

  .header-inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }
  .brand img { flex-shrink: 0; }
  .brand:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 3px;
    border-radius: 5px;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 26px;
  }
  .nav-desktop a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 4px 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground-65);
    transition: color 0.2s ease;
  }
  .nav-desktop a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-primary);
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s ease;
  }
  .nav-desktop a:hover { color: var(--color-foreground); }
  .nav-desktop a:hover::after,
  .nav-desktop a.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-desktop a.is-active {
    color: var(--color-foreground);
  }
  .nav-index {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--color-primary-35);
    transition: color 0.2s ease;
  }
  .nav-desktop a:hover .nav-index,
  .nav-desktop a.is-active .nav-index {
    color: var(--color-primary);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--color-primary-14);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .lang a {
    padding: 4px 10px;
    border-radius: 999px;
    color: var(--color-foreground-55);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .lang a:hover { color: var(--color-foreground); }
  .lang a[aria-current='true'] {
    background: var(--color-primary-10);
    color: var(--color-primary);
  }

  .menu-mobile { position: static; }
  .menu-mobile summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    color: var(--color-foreground);
    background: transparent;
    cursor: pointer;
    list-style: none;
    transition: background 0.2s ease;
    margin-right: -8px;
  }
  .menu-mobile summary::-webkit-details-marker { display: none; }
  .menu-mobile summary:hover,
  .menu-mobile[open] summary {
    background: var(--color-primary-8);
  }

  .menu-toggle {
    position: relative;
    display: block;
    width: 22px;
    height: 22px;
  }
  .menu-toggle-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity 0.16s ease, transform 0.2s ease;
  }
  .menu-toggle-icon--close {
    opacity: 0;
    transform: rotate(45deg) scale(0.4);
  }
  .menu-mobile[open] .menu-toggle-icon--open {
    opacity: 0;
    transform: rotate(-45deg) scale(0.4);
  }
  .menu-mobile[open] .menu-toggle-icon--close {
    opacity: 1;
    transform: none;
  }

  .menu-mobile-panel {
    position: absolute;
    top: 64px;
    right: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    padding: 10px 24px 26px;
    border-bottom: 1px solid var(--color-primary-14);
    background: rgba(10, 13, 20, 0.97);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 24px 48px rgba(5, 8, 14, 0.4);
  }
  .menu-mobile-panel a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 4px;
    border-bottom: 1px solid var(--color-primary-8);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-foreground-70);
    transition: color 0.2s ease;
  }
  .menu-mobile-panel a:last-child {
    border-bottom: 0;
  }
  .menu-mobile-panel a:hover,
  .menu-mobile-panel a:focus-visible {
    color: var(--color-foreground);
  }
  .menu-mobile-panel a:active {
    color: var(--color-primary);
  }
  .menu-mobile-panel .nav-index {
    font-size: 12px;
  }
  .menu-mobile-panel a:hover .nav-index,
  .menu-mobile-panel a:focus-visible .nav-index {
    color: var(--color-primary);
  }
  .panel-arrow {
    margin-left: auto;
    color: var(--color-primary-35);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .menu-mobile-panel a:hover .panel-arrow {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  @media (min-width: 768px) {
    .nav-desktop { display: flex; }
    .menu-mobile { display: none; }
  }
</style>
