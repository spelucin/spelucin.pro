---
import { Icon } from 'astro-icon/components';
import type { Translations } from '../i18n/types';
import { site } from '../data/site';
import { localizeHref, equivalentPath } from '../utils/lang';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
const currentLang = t.lang;
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container-site header-inner">
    <a href={localizeHref('/', currentLang)} class="brand" aria-label={t.meta.title}>
      <img src="/assets/logo.svg" alt={t.meta.title} width="26" height="26" loading="eager" />
    </a>

    <div class="header-right">
      <nav class="lang" aria-label={t.header.langLabel}>
        <a
          href={equivalentPath(currentPath, 'es')}
          lang="es"
          hreflang="es"
          data-lang-switch
          data-lang-to="es"
          aria-current={currentLang === 'es' ? 'true' : undefined}
        >ES</a>
        <a
          href={equivalentPath(currentPath, 'en')}
          lang="en"
          hreflang="en"
          data-lang-switch
          data-lang-to="en"
          aria-current={currentLang === 'en' ? 'true' : undefined}
        >EN</a>
      </nav>

      <a
        class="btn btn-primary btn-nav"
        href={site.cal}
        data-cal-modal
        data-calendar
        data-calendar-location="header"
        data-cta
        data-cta-text={t.ctaLabel}
        data-cta-location="header"
      >
        <span>{t.ctaLabel}</span>
        <Icon name="tabler:arrow-up-right" width="16" height="16" aria-hidden="true" />
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 64px;
    background: rgba(10, 13, 20, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-primary-8);
  }

  .header-inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .brand:hover {
    opacity: 0.85;
    transform: scale(1.05);
  }
  .brand img { display: block; width: 26px; height: 26px; }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-nav {
    padding: 8px 16px;
    font-size: 13.5px;
    font-weight: 600;
    border-radius: var(--radius-sm);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--color-primary-14);
    border-radius: 999px;
    background: rgba(15, 18, 25, 0.6);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .lang a {
    padding: 4px 10px;
    border-radius: 999px;
    color: var(--color-foreground-55);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .lang a:hover { color: var(--color-foreground); }
  .lang a[aria-current='true'] {
    background: var(--color-primary-10);
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .btn-nav { padding: 8px 12px; font-size: 12.5px; }
  }
</style>
