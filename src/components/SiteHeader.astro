---
import { Icon } from 'astro-icon/components';
import type { Translations } from '../i18n/types';
import { site } from '../data/site';
import { localizeHref, equivalentPath } from '../utils/lang';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
const currentLang = t.lang;
const currentPath = Astro.url.pathname;
const normalizedCurrentPath = currentPath.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const localized = localizeHref(href, currentLang).replace(/\/$/, '') || '/';
  return localized === '/' ? normalizedCurrentPath === '/' : normalizedCurrentPath === localized || normalizedCurrentPath.startsWith(`${localized}/`);
};
---

<header class="site-header">
  <div class="container-site header-inner">
    <a href={localizeHref('/', currentLang)} class="brand" aria-label={t.meta.title}>
      <img src="/assets/logo.svg" alt={t.meta.title} width="26" height="26" loading="eager" />
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {t.siteNav.map((item) => (
        <a class={isCurrent(item.href) ? 'site-nav-link is-active' : 'site-nav-link'} href={localizeHref(item.href, currentLang)}>{item.label}</a>
      ))}
    </nav>

    <div class="header-right">
      <nav class="lang" aria-label={t.header.langLabel}>
        <a
          href={equivalentPath(currentPath, 'es')}
          lang="es"
          hreflang="es"
          data-lang-switch
          data-lang-to="es"
          aria-current={currentLang === 'es' ? 'true' : undefined}
        >ES</a>
        <a
          href={equivalentPath(currentPath, 'en')}
          lang="en"
          hreflang="en"
          data-lang-switch
          data-lang-to="en"
          aria-current={currentLang === 'en' ? 'true' : undefined}
        >EN</a>
      </nav>

      <a
        class="btn btn-primary btn-nav"
        href={site.cal}
        data-cal-modal
        data-calendar
        data-calendar-location="header"
        data-cta
        data-cta-text={t.ctaLabel}
        data-cta-location="header"
      >
        <span>{t.ctaLabel}</span>
        <Icon name="tabler:arrow-up-right" width="16" height="16" aria-hidden="true" />
      </a>

      <details class="mobile-nav">
        <summary aria-label="Open navigation">
          <Icon name="tabler:menu-2" width="18" height="18" aria-hidden="true" />
        </summary>
        <nav aria-label="Mobile navigation">
          {t.siteNav.map((item) => (
            <a class={isCurrent(item.href) ? 'mobile-nav-link is-active' : 'mobile-nav-link'} href={localizeHref(item.href, currentLang)}>{item.label}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 72px;
    background: rgba(10, 13, 20, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-primary-8);
  }

  .header-inner {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .brand:hover {
    opacity: 0.85;
    transform: scale(1.05);
  }
  .brand img { display: block; width: 26px; height: 26px; }

  .header-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-left: auto;
    margin-right: 24px;
  }
  .site-nav-link {
    position: relative;
    color: var(--color-foreground-55);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .site-nav-link::after {
    position: absolute;
    right: 0;
    bottom: -8px;
    left: 0;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
    content: '';
  }
  .site-nav-link:hover, .site-nav-link.is-active { color: var(--color-primary); }
  .site-nav-link:hover::after, .site-nav-link.is-active::after { transform: scaleX(1); }

  .btn-nav {
    padding: 8px 16px;
    font-size: 13.5px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    box-shadow: 3px 3px 0 rgba(96, 165, 250, 0.18);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--color-primary-14);
    border-radius: 999px;
    background: rgba(15, 18, 25, 0.8);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .lang a {
    padding: 4px 10px;
    border-radius: 999px;
    color: var(--color-foreground-55);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .lang a:hover { color: var(--color-foreground); }
  .lang a[aria-current='true'] {
    background: var(--color-primary-10);
    color: var(--color-primary);
    font-weight: 600;
  }

  .mobile-nav { display: none; position: relative; }
  .mobile-nav summary {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-primary-20);
    border-radius: var(--radius-sm);
    color: var(--color-primary);
    cursor: pointer;
    list-style: none;
  }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav nav {
    position: absolute;
    top: 44px;
    right: 0;
    display: grid;
    min-width: 190px;
    padding: 8px;
    border: 1px solid var(--color-primary-20);
    background: var(--color-card);
    box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.28);
  }
  .mobile-nav-link {
    padding: 12px;
    color: var(--color-foreground-70);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mobile-nav-link:hover, .mobile-nav-link.is-active { color: var(--color-primary); background: var(--color-primary-5); }

  @media (max-width: 900px) {
    .site-nav { display: none; }
    .mobile-nav { display: block; }
  }

  @media (max-width: 480px) {
    .btn-nav { padding: 8px 10px; font-size: 11.5px; }
    .lang a { padding-inline: 8px; }
  }
</style>
