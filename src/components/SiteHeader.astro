---
import { Icon } from 'astro-icon/components';
import type { Translations } from '../i18n/types';
import { site } from '../data/site';
import { localizeHref, equivalentPath } from '../utils/lang';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
const currentLang = t.lang;
const currentPath = Astro.url.pathname;
const navItems = t.siteNav.map((item) => ({
  label: item.label,
  href: localizeHref(item.href, currentLang),
}));
const activeHref = navItems.find((item) => item.href === currentPath)?.href;
---

<header class="site-header">
  <div class="container-site header-inner">
    <a href={localizeHref('/', currentLang)} class="brand" aria-label={t.meta.title}>
      <img src="/assets/logo.svg" alt="" width="20" height="20" loading="eager" />
      <span>Alex Spelucin</span>
    </a>

    <nav class="nav-desktop" aria-label={t.header.navAria}>
      {navItems.map((item) => (
        <a href={item.href} aria-current={item.href === activeHref ? 'true' : undefined}>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-right">
      <a
        class="btn btn-primary btn-nav"
        href={site.cal}
        target="_blank"
        rel="noopener"
        data-cal-link="spelucin"
        data-cal-namespace="spelucin"
        data-calendar
        data-calendar-location="header"
        data-cta
        data-cta-text={t.ctaLabel}
        data-cta-location="header"
      >
        {t.ctaLabel}
      </a>

      <nav class="lang" aria-label={t.header.langLabel}>
        <a
          href={equivalentPath(currentPath, 'es')}
          lang="es"
          hreflang="es"
          aria-current={currentLang === 'es' ? 'true' : undefined}
        >ES</a>
        <a
          href={equivalentPath(currentPath, 'en')}
          lang="en"
          hreflang="en"
          aria-current={currentLang === 'en' ? 'true' : undefined}
        >EN</a>
      </nav>

      <details class="menu-mobile">
        <summary aria-label={t.header.menuOpen} aria-expanded="false">
          <span class="menu-toggle" aria-hidden="true">
            <span class="menu-toggle-icon menu-toggle-icon--open">
              <Icon name="tabler:menu-deep" width="22" height="22" />
            </span>
            <span class="menu-toggle-icon menu-toggle-icon--close">
              <Icon name="tabler:x" width="22" height="22" />
            </span>
          </span>
        </summary>
        <nav class="menu-mobile-panel" aria-label={t.header.navAria}>
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.href === activeHref ? 'true' : undefined}
            >
              <span>{item.label}</span>
              <span class="panel-arrow" aria-hidden="true">
                <Icon name="tabler:chevron-right" width="18" height="18" />
              </span>
            </a>
          ))}
          <a
            class="btn btn-primary menu-mobile-cta"
            href={site.cal}
            target="_blank"
            rel="noopener"
            data-cal-link="spelucin"
            data-cal-namespace="spelucin"
            data-calendar
            data-calendar-location="header"
            data-cta
            data-cta-text={t.ctaLabel}
            data-cta-location="header"
          >
            {t.ctaLabel}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.menu-mobile');
  const summary = menu?.querySelector('summary');
  menu?.addEventListener('toggle', () => {
    summary?.setAttribute('aria-expanded', String(menu.open));
  });

  document.querySelectorAll('.menu-mobile-panel a:not(.menu-mobile-cta)').forEach((link) => {
    link.addEventListener('click', () => {
      const details = link.closest('details');
      if (details) details.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 64px;
    background: rgba(10, 13, 20, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-primary-8);
  }

  .header-inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }
  .brand img { flex-shrink: 0; }
  .brand:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 3px;
    border-radius: 5px;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 26px;
  }
  .nav-desktop a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    padding: 4px 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground-65);
    transition: color 0.2s ease;
  }
  .nav-desktop a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-primary);
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s ease;
  }
  .nav-desktop a:hover { color: var(--color-foreground); }
  .nav-desktop a:hover::after,
  .nav-desktop a[aria-current='true']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-desktop a[aria-current='true'] {
    color: var(--color-foreground);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .btn-nav {
    display: none;
    padding: 10px 18px;
    font-size: 14px;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--color-primary-14);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .lang a {
    padding: 4px 10px;
    border-radius: 999px;
    color: var(--color-foreground-55);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .lang a:hover { color: var(--color-foreground); }
  .lang a[aria-current='true'] {
    background: var(--color-primary-10);
    color: var(--color-primary);
  }

  .menu-mobile { position: static; }
  .menu-mobile summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    color: var(--color-foreground);
    background: transparent;
    cursor: pointer;
    list-style: none;
    transition: background 0.2s ease;
    margin-right: -8px;
  }
  .menu-mobile summary::-webkit-details-marker { display: none; }
  .menu-mobile summary:hover,
  .menu-mobile[open] summary {
    background: var(--color-primary-8);
  }

  .menu-toggle {
    position: relative;
    display: block;
    width: 22px;
    height: 22px;
  }
  .menu-toggle-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity 0.16s ease, transform 0.2s ease;
  }
  .menu-toggle-icon--close {
    opacity: 0;
    transform: rotate(45deg) scale(0.4);
  }
  .menu-mobile[open] .menu-toggle-icon--open {
    opacity: 0;
    transform: rotate(-45deg) scale(0.4);
  }
  .menu-mobile[open] .menu-toggle-icon--close {
    opacity: 1;
    transform: none;
  }

  .menu-mobile-panel {
    position: absolute;
    top: 64px;
    right: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    padding: 10px 24px 26px;
    border-bottom: 1px solid var(--color-primary-14);
    background: rgba(10, 13, 20, 0.97);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 24px 48px rgba(5, 8, 14, 0.4);
  }
  .menu-mobile-panel a:not(.menu-mobile-cta) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 4px;
    border-bottom: 1px solid var(--color-primary-8);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-foreground-70);
    transition: color 0.2s ease;
  }
  .menu-mobile-panel a:last-child:not(.menu-mobile-cta) {
    border-bottom: 0;
  }
  .menu-mobile-panel a:hover,
  .menu-mobile-panel a:focus-visible {
    color: var(--color-foreground);
  }
  .menu-mobile-panel a:active {
    color: var(--color-primary);
  }
  .panel-arrow {
    margin-left: auto;
    color: var(--color-primary-35);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .menu-mobile-panel a:hover .panel-arrow {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  .menu-mobile-cta {
    margin-top: 22px;
    width: 100%;
  }

  @media (min-width: 900px) {
    .nav-desktop { display: flex; }
    .menu-mobile { display: none; }
    .btn-nav { display: inline-flex; }
  }
</style>