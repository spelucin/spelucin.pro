---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHead from './SectionHead.astro';
import StatsBlocks from './StatsBlocks.astro';
import BookCall from './BookCall.astro';
import { localizeHref } from '../utils/lang';
import type { CaseStudy, Translations } from '../i18n/types';
import type { CaseImage } from '../data/caseImages';

interface Props {
  t: Translations;
  study: CaseStudy;
  images: CaseImage[];
}

const { t, study, images }: Props = Astro.props;
---

<SiteHeader t={t} />

<main id="main-content">
  <section class="page-hero">
    <div class="container-site">
      <a class="hero-back" href={localizeHref('/case-studies', t.lang)}>
        <Icon name="tabler:arrow-left" width="16" height="16" aria-hidden="true" />
        {t.caseStudies.backToWork}
      </a>
      <div class="case-hero-grid">
        <div class="case-hero-copy">
          <p class="hero-eyebrow">{study.kicker}</p>
          <h1 class="hero-title">{study.title}</h1>
          <p class="hero-meta">
            <span>{study.client}</span>
            <span aria-hidden="true">·</span>
            <span>{study.sector}</span>
            <span aria-hidden="true">·</span>
            <span>{study.year}</span>
          </p>
        </div>
        <aside class="hero-result-wrap" aria-label={t.caseStudies.outcomeLabel}>
          <span class="result-label">{t.caseStudies.outcomeLabel}</span>
          <div class="hero-result">
            <span class="result-icon" aria-hidden="true">
              <Icon name="tabler:chart-line" width="19" height="19" />
            </span>
            <p>{study.heroResult}</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="context section-block">
    <div class="container-site">
      <SectionHead index="01" heading={t.caseStudies.contextHeading} />
      {study.context.map((p) => (
        <p class="context-para">{p}</p>
      ))}
    </div>
  </section>

  <section class="problems section-block reveal">
    <div class="container-site">
      <SectionHead index="02" heading={t.caseStudies.challengeHeading} />
      <ul class="problem-list" role="list">
        {study.problems.map((problem, i) => (
          <li class="problem-card">
            <span class="row-num">0{i + 1}</span>
            <h3 class="problem-title">{problem.title}</h3>
            <p class="problem-text">{problem.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="built section-block reveal">
    <div class="container-site">
      <SectionHead index="03" heading={study.built.heading} />
      <ul class="built-list" role="list">
        {study.built.items.map((item) => (
          <li class="built-item">
            <h3 class="built-title">{item.title}</h3>
            <p class="built-text">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="gallery section-block reveal">
    <div class="container-site">
      <SectionHead index="04" heading={t.caseStudies.galleryHeading} />
      <div class="gallery-grid">
        {images.map((image, i) => (
          <figure class={i === 0 ? 'shot shot--lead' : 'shot'}>
            <div class="shot-media">
              <Image
                src={image}
                alt={study.imagesAlt[i]}
                format="avif"
                widths={[640, 960, 1440]}
                sizes={i === 0 ? '(min-width: 1024px) 1072px, 92vw' : '(min-width: 1024px) 520px, 92vw'}
                loading="lazy"
              />
            </div>
            <figcaption class="shot-caption">
              {String(i + 1).padStart(2, '0')} / {String(images.length).padStart(2, '0')} ·{' '}
              {study.imagesAlt[i]}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="results section-block reveal">
    <div class="container-site">
      <SectionHead index="05" heading={study.results.heading} />
      <StatsBlocks stats={study.results.stats} />
    </div>
  </section>

  <BookCall t={t} location={`case-${study.slug}`} />
</main>

<SiteFooter t={t} />

<script>
  import '../scripts/reveal';
</script>

<style>
  .hero-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(36px, 5vw, 56px);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground-55);
    transition: color 0.2s ease;
  }
  .hero-back:hover {
    color: var(--color-primary);
  }
  .case-hero-grid {
    display: grid;
    gap: 36px;
    align-items: end;
  }
  .case-hero-copy {
    min-width: 0;
  }
  .case-hero-copy .hero-eyebrow {
    margin-bottom: 22px;
  }
  .case-hero-copy .hero-title {
    max-width: 13ch;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin: 22px 0 0;
    font-size: 14px;
    color: var(--color-foreground-55);
  }
  .hero-result-wrap {
    position: relative;
    display: grid;
    gap: 18px;
    min-height: 142px;
    align-content: space-between;
    padding: 24px;
    border: 1px solid var(--color-primary-20);
    border-radius: var(--radius-sm);
    background:
      radial-gradient(ellipse at 100% 0%, rgba(96, 165, 250, 0.13), transparent 58%),
      linear-gradient(135deg, var(--color-primary-5), transparent 72%),
      var(--color-card);
    box-shadow: var(--shadow-panel);
  }
  .result-label {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .hero-result {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .hero-result p {
    margin: 0;
    color: var(--color-foreground);
    font-size: clamp(19px, 2.2vw, 25px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.2;
    text-wrap: balance;
  }
  .result-icon {
    display: grid;
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--color-primary-20);
    border-radius: var(--radius-sm);
    background: var(--color-primary-8);
    color: var(--color-primary);
  }

  .context-para {
    margin: 22px 0 0;
    max-width: 64ch;
    font-size: 20px;
    line-height: 1.7;
    color: var(--color-foreground-65);
  }
  .context-para:first-of-type {
    margin-top: 0;
  }
  .context-para + .context-para {
    margin-top: 18px;
  }

  .problem-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .problem-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 210px;
    padding: 26px;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-sm);
    background: var(--color-card);
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }
  .problem-card:hover {
    border-color: var(--color-primary-35);
    background-color: var(--color-primary-4);
    transform: translateY(-2px);
  }
  .row-num {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .problem-title {
    margin: 0;
    font-size: 18px;
    font-weight: 650;
    color: var(--color-foreground);
  }
  .problem-text {
    margin: 0;
    color: var(--color-foreground-55);
    font-size: 15px;
    line-height: 1.6;
  }

  .built-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-primary-14);
  }
  .built-item {
    display: grid;
    gap: 8px;
    padding: 24px 4px;
    border-bottom: 1px solid var(--color-primary-14);
  }
  .built-title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--color-foreground);
  }
  .built-text {
    margin: 0;
    max-width: 56ch;
    color: var(--color-foreground-55);
    font-size: 15px;
    line-height: 1.6;
  }

  .gallery-grid {
    display: grid;
    gap: 36px 24px;
  }
  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .shot--lead {
    grid-column: 1 / -1;
  }
  .shot-media {
    order: 1;
    overflow: hidden;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-sm);
    background: linear-gradient(145deg, #0d1420, #080b11 72%);
    box-shadow: var(--shadow-panel);
    transition: border-color 0.2s ease;
  }
  .shot:hover .shot-media {
    border-color: var(--color-primary-28);
  }
  .shot-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot--lead .shot-media img {
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: contain;
  }
  .shot-caption {
    order: 2;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-foreground-55);
  }

  @media (min-width: 768px) {
    .case-hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 0.48fr);
      gap: clamp(40px, 7vw, 96px);
    }
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .problem-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .built-item {
      grid-template-columns: 240px 1fr;
      gap: 28px;
      align-items: baseline;
    }
  }

  .context, .problems, .built, .gallery, .results { border-top-color: var(--color-primary-20); }
</style>
