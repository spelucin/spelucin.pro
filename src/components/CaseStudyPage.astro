---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHead from './SectionHead.astro';
import StatsBlocks from './StatsBlocks.astro';
import BookCall from './BookCall.astro';
import { localizeHref } from '../utils/lang';
import { caseImages } from '../data/caseImages';
import type { CaseStudy, Translations } from '../i18n/types';
import type { CaseImage } from '../data/caseImages';

interface Props {
  t: Translations;
  study: CaseStudy;
  images: CaseImage[];
}

const { t, study, images }: Props = Astro.props;
---

<SiteHeader t={t} />

<main id="main-content">
  <section class="page-hero">
    <div class="container-site">
      <a class="hero-back" href={localizeHref('/case-studies', t.lang)}>
        <Icon name="tabler:arrow-left" width="16" height="16" aria-hidden="true" />
        {t.caseStudies.backToWork}
      </a>
      <p class="hero-eyebrow">{study.kicker}</p>
      <h1 class="hero-title">{study.title}</h1>
      <p class="hero-meta">
        {study.client} <span aria-hidden="true">·</span> {study.sector}
        <span aria-hidden="true">·</span> {study.year}
      </p>
      <div class="hero-result-wrap">
        <span class="hero-result">
          <Icon name="tabler:chart-line" width="18" height="18" aria-hidden="true" />
          {study.heroResult}
        </span>
      </div>
    </div>
  </section>

  <section class="context section-block">
    <div class="container-site">
      <SectionHead index="01" heading={t.caseStudies.contextHeading} />
      {study.context.map((p) => (
        <p class="context-para">{p}</p>
      ))}
    </div>
  </section>

  <section class="problems section-block reveal">
    <div class="container-site">
      <SectionHead index="02" heading={t.caseStudies.challengeHeading} />
      <ul class="problem-list" role="list">
        {study.problems.map((problem, i) => (
          <li class="problem-card">
            <span class="row-num">0{i + 1}</span>
            <h3 class="problem-title">{problem.title}</h3>
            <p class="problem-text">{problem.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="built section-block reveal">
    <div class="container-site">
      <SectionHead index="03" heading={study.built.heading} />
      <ul class="built-list" role="list">
        {study.built.items.map((item) => (
          <li class="built-item">
            <h3 class="built-title">{item.title}</h3>
            <p class="built-text">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="gallery section-block reveal">
    <div class="container-site">
      <SectionHead index="04" heading={t.caseStudies.galleryHeading} />
      <div class="gallery-grid">
        {images.map((image, i) => (
          <figure class={i === 0 ? 'shot shot--lead' : 'shot'}>
            <div class="shot-media">
              <Image
                src={image}
                alt={study.imagesAlt[i]}
                format="avif"
                widths={[640, 960, 1440]}
                sizes={i === 0 ? '(min-width: 1024px) 1072px, 92vw' : '(min-width: 1024px) 520px, 92vw'}
                loading="lazy"
              />
            </div>
            <figcaption class="shot-caption">
              {String(i + 1).padStart(2, '0')} / {String(images.length).padStart(2, '0')} ·{' '}
              {study.imagesAlt[i]}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="results section-block reveal">
    <div class="container-site">
      <SectionHead index="05" heading={study.results.heading} />
      <StatsBlocks stats={study.results.stats} />
    </div>
  </section>

  <section class="other-cases section-block reveal">
    <div class="container-site">
      <SectionHead index="06" heading={t.caseStudies.moreHeading} />
      <div class="other-cases-grid">
        {[t.caseStudies.torices, t.caseStudies.notebook, t.caseStudies.owlbox]
          .filter((other) => other.slug !== study.slug)
          .map((other) => {
            const thumb = caseImages[other.slug as keyof typeof caseImages]?.[0];
            return (
              <a
                class="other-case"
                href={localizeHref(`/case-studies/${other.slug}`, t.lang)}
                data-case-study
                data-case-study-slug={other.slug}
                data-case-study-name={other.client}
                data-case-study-industry={other.sector}
              >
                {thumb && (
                  <div class="other-case-media">
                    <Image
                      src={thumb}
                      alt={other.imagesAlt[0] ?? other.alt}
                      format="avif"
                      widths={[640, 960]}
                      sizes="(min-width: 1024px) 460px, 92vw"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="other-case-body">
                  <div class="other-case-header">
                    <span>{other.client} · {other.sector}</span>
                    <Icon name="tabler:arrow-up-right" width="18" height="18" aria-hidden="true" />
                  </div>
                  <strong>{other.title}</strong>
                  <small>{other.heroResult}</small>
                </div>
              </a>
            );
          })}
      </div>
    </div>
  </section>

  <BookCall t={t} location={`case-${study.slug}`} />
</main>

<SiteFooter t={t} />

<script>
  import '../scripts/reveal';
</script>

<style>
  .hero-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 44px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground-55);
    transition: color 0.2s ease;
  }
  .hero-back:hover {
    color: var(--color-primary);
  }
  .hero-meta {
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-55);
  }
  .hero-result-wrap {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--color-primary-14);
  }
  .hero-result {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--color-foreground);
  }
  .hero-result svg {
    color: var(--color-primary);
  }

  .context-para {
    margin: 22px 0 0;
    max-width: 64ch;
    font-size: 20px;
    line-height: 1.7;
    color: var(--color-foreground-65);
  }
  .context-para + .context-para {
    margin-top: 18px;
  }

  .problem-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .problem-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-md);
    background: var(--color-card);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .problem-card:hover {
    border-color: var(--color-primary-35);
    transform: translateY(-2px);
  }
  .row-num {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .problem-title {
    margin: 0;
    font-size: 18px;
    font-weight: 650;
    color: var(--color-foreground);
  }
  .problem-text {
    margin: 0;
    color: var(--color-foreground-55);
    font-size: 15px;
    line-height: 1.6;
  }

  .built-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-primary-14);
  }
  .built-item {
    display: grid;
    gap: 8px;
    padding: 26px 4px;
    border-bottom: 1px solid var(--color-primary-14);
  }
  .built-title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--color-foreground);
  }
  .built-text {
    margin: 0;
    max-width: 56ch;
    color: var(--color-foreground-55);
    font-size: 15px;
    line-height: 1.6;
  }

  .gallery-grid {
    display: grid;
    gap: 40px 28px;
  }
  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .shot--lead {
    grid-column: 1 / -1;
  }
  .shot-media {
    order: 1;
    overflow: hidden;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-lg);
    background: #080b11;
    box-shadow: 0 18px 44px rgba(4, 8, 16, 0.34);
    transition: border-color 0.2s ease;
  }
  .shot:hover .shot-media {
    border-color: var(--color-primary-28);
  }
  .shot-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot--lead .shot-media img {
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: contain;
  }
  .shot-caption {
    order: 2;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-foreground-55);
  }

  .other-cases-grid { display: grid; gap: 16px; }
  .other-case {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-md);
    background: var(--color-card);
    color: var(--color-foreground);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .other-case:hover { border-color: var(--color-primary-35); transform: translateY(-2px); }
  .other-case-media { overflow: hidden; aspect-ratio: 16 / 9; background: #080b11; }
  .other-case-media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .other-case:hover .other-case-media img { transform: scale(1.035); }
  .other-case-body { display: grid; gap: 10px; padding: 20px 22px 22px; }
  .other-case-header { display: flex; align-items: center; justify-content: space-between; color: var(--color-primary); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
  .other-case strong { font-size: 18px; font-weight: 650; line-height: 1.3; }
  .other-case small { color: var(--color-foreground-55); font-family: var(--font-mono); font-size: 12px; }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .problem-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .built-item {
      grid-template-columns: 240px 1fr;
      gap: 28px;
      align-items: baseline;
    }
    .other-cases-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
