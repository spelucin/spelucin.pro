---
import Logo from './Logo.astro';
import IconGithub from './IconGithub.astro';
import IconLinkedin from './IconLinkedin.astro';

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/escritura/', label: 'Escritura' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<aside class="site-sidebar" id="site-sidebar">
  <div class="sidebar-inner">
    <!-- Logo + Identity -->
    <div class="sidebar-identity">
      <a href="/" class="sidebar-logo-link" aria-label="Inicio">
        <Logo size={28} />
      </a>
      <div class="sidebar-name">Alex Spelucin</div>
      <div class="sidebar-tagline">SEO técnico · AI Search · Shopify</div>
    </div>

    <!-- Nav -->
    <nav class="sidebar-nav" aria-label="Navegación principal">
      {navItems.map(item => (
        <a
          href={item.href}
          class={`sidebar-nav-link ${isActive(item.href) ? 'active' : ''}`}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Spacer -->
    <div class="sidebar-spacer"></div>

    <!-- Footer utilities -->
    <div class="sidebar-footer">
      <div class="sidebar-social">
        <a href="https://github.com/spelucin" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
          <IconGithub size={16} />
        </a>
        <a href="https://linkedin.com/in/spelucin" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
          <IconLinkedin size={16} />
        </a>
        <a href="/rss.xml" class="social-link rss-link" aria-label="RSS Feed">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 11C7.31371 11 10 8.31371 10 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M4 4C12.8366 4 20 11.1634 20 20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <circle cx="4" cy="20" r="1.5" fill="currentColor"/>
          </svg>
        </a>
      </div>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Toggle dark mode"
        type="button"
      >
        <span class="theme-icon-light">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/>
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="theme-icon-dark" style="display:none">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>
    </div>
  </div>
</aside>

<!-- Sidebar overlay backdrop (mobile) -->
<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

<script>
  const sidebar = document.getElementById('site-sidebar');
  const backdrop = document.getElementById('sidebar-backdrop');

  // Open/close from mobile topbar
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    sidebar?.classList.toggle('open');
    backdrop?.classList.toggle('active');
    document.body.style.overflow = sidebar?.classList.contains('open') ? 'hidden' : '';
  });

  backdrop?.addEventListener('click', closeSidebar);

  function closeSidebar() {
    sidebar?.classList.remove('open');
    backdrop?.classList.remove('active');
    document.body.style.overflow = '';
  }

  // Close on nav link click (mobile)
  sidebar?.querySelectorAll('.sidebar-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 1024) closeSidebar();
    });
  });

  // ── Theme toggle ──────────────────────────────
  const themeToggle = document.getElementById('theme-toggle');
  const lightIcon = themeToggle?.querySelector('.theme-icon-light') as HTMLElement | null;
  const darkIcon = themeToggle?.querySelector('.theme-icon-dark') as HTMLElement | null;

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    if (lightIcon) lightIcon.style.display = dark ? 'none' : '';
    if (darkIcon) darkIcon.style.display = dark ? '' : 'none';
  }

  // Initialize theme from localStorage or system preference
  const stored = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const isDark = stored === 'dark' || (!stored && prefersDark);
  applyTheme(isDark);

  themeToggle?.addEventListener('click', () => {
    const nowDark = !document.documentElement.classList.contains('dark');
    applyTheme(nowDark);
    localStorage.setItem('theme', nowDark ? 'dark' : 'light');
  });
</script>

<style is:global>
  .sidebar-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem 1.5rem;
  }

  .sidebar-identity {
    margin-bottom: 2.5rem;
  }

  .sidebar-logo-link {
    display: inline-block;
    margin-bottom: 0.875rem;
    opacity: 0.9;
    transition: opacity 0.15s;
  }
  .sidebar-logo-link:hover { opacity: 1; }

  .sidebar-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-foreground);
    letter-spacing: -0.02em;
    margin-bottom: 0.2rem;
  }

  .sidebar-tagline {
    font-size: 0.72rem;
    color: var(--color-muted-foreground);
    font-weight: 500;
    line-height: 1.5;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .sidebar-nav-link {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-prose-muted);
    text-decoration: none;
    padding: 0.45rem 0.75rem;
    border-radius: 0.375rem;
    transition: color 0.15s, background 0.15s;
    letter-spacing: -0.01em;
  }

  .sidebar-nav-link:hover {
    color: var(--color-foreground);
    background: var(--color-border);
  }

  .sidebar-nav-link.active {
    color: var(--color-primary);
    font-weight: 600;
    background: rgba(21, 96, 189, 0.08);
  }

  html.dark .sidebar-nav-link.active {
    background: rgba(77, 143, 224, 0.12);
  }

  .sidebar-spacer {
    flex: 1;
  }

  .sidebar-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .sidebar-social {
    display: flex;
    gap: 0.625rem;
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color 0.15s;
    padding: 0.2rem;
    border-radius: 0.25rem;
  }
  .social-link:hover {
    color: var(--color-foreground);
  }

  .rss-link {
    color: var(--color-muted-foreground);
  }

  .theme-toggle {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    color: var(--color-muted-foreground);
    cursor: pointer;
    padding: 0.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s, border-color 0.15s;
    font-family: inherit;
  }
  .theme-toggle:hover {
    color: var(--color-foreground);
    border-color: var(--color-primary);
  }
</style>
