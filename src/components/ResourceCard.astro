---
interface Props {
  title: string;
  description: string;
  category: string;
  thumbnail: string;
  downloadLink: string;
  externalLink?: string;
  slug: string;
}

const { title, description, category, thumbnail, downloadLink, externalLink, slug } = Astro.props;
---

<a href={`/recursos/${slug}/`} style="text-decoration: none; display: block; padding: 1rem 0; transition: opacity 0.15s" class="resource-link">
  <div style="display: flex; gap: 1rem; align-items: flex-start">
    {thumbnail && (
      <img src={thumbnail} alt={title} style="width: 64px; height: 64px; border-radius: 0.375rem; object-fit: cover; flex-shrink: 0; border: 1px solid rgba(21,96,189,0.08)" />
    )}
    <div style="min-width: 0">
      <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.2rem">
        <span style="font-size: 0.625rem; font-weight: 700; color: #1560bd; letter-spacing: 0.06em; text-transform: uppercase">{category}</span>
        {externalLink && <span style="font-size: 0.5625rem; color: rgba(21,96,189,0.35)">↗</span>}
      </div>
      <h3 style="font-size: 0.9375rem; font-weight: 700; color: #0d1f3c; letter-spacing: -0.02em; margin: 0 0 0.2rem; line-height: 1.3">{title}</h3>
      <p style="font-size: 0.75rem; color: rgba(13,31,60,0.5); line-height: 1.55; margin: 0">{description}</p>
    </div>
  </div>
</a>

<style is:global>
  .resource-link:hover {
    opacity: 0.7;
  }
</style>
