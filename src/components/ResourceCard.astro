---
interface Props {
  title: string;
  description: string;
  category: string;
  thumbnail: string;
  downloadLink: string;
  externalLink?: string;
  slug: string;
}

const { title, description, category, thumbnail, downloadLink, externalLink, slug } = Astro.props;
---

<a href={`/recursos/${slug}/`} class="resource-link">
  <div class="resource-card-inner">
    {thumbnail && (
      <img src={thumbnail} alt={title} class="resource-thumbnail" />
    )}
    <div class="resource-copy">
      <div class="resource-meta">
        <span>{category}</span>
        {externalLink && <span>↗</span>}
      </div>
      <h3>{title}</h3>
      <p>{description}</p>
    </div>
  </div>
</a>

<style is:global>
  .resource-link {
    display: block;
    padding: 1rem 0;
    color: inherit;
    text-decoration: none;
    transition: opacity 180ms ease;
  }
  .resource-card-inner { display: flex; gap: 1rem; align-items: flex-start; }
  .resource-thumbnail { width: 64px; height: 64px; border: 1px solid var(--color-primary-8); border-radius: var(--radius-sm); object-fit: cover; flex-shrink: 0; }
  .resource-copy { min-width: 0; }
  .resource-meta { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.2rem; color: var(--color-primary); font: 600 0.625rem/1.2 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .resource-meta span:last-child { color: var(--color-primary-35); }
  .resource-copy h3 { margin: 0 0 0.2rem; color: var(--color-foreground); font-size: 0.9375rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.3; }
  .resource-copy p { margin: 0; color: var(--color-foreground-50); font-size: 0.75rem; line-height: 1.55; }
  .resource-link:hover {
    opacity: 0.82;
  }
</style>
