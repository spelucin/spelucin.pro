          <text x="66" y="212" class="d-label">GTM</text>
          <rect x="32" y="240" width="168" height="40" rx="2" class="d-node" />
          <g class="d-icon" transform="translate(44 252)"><Icon name="tabler:tag" width="14" height="14" aria-hidden="true" /></g>
          <text x="66" y="264" class="d-label">{u.pixels}</text>

