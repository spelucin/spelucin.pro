const c = copy[lang][variant];
const u = copy[lang].ui;
---

<figure class={`service-diagram service-diagram--${variant} ${className}`}>
  <figcaption class="diagram-caption">
    <span class="diagram-kicker">{c.kicker}</span>
    <span>{c.caption}</span>
  </figcaption>

  <div class="diagram-frame" tabindex="0" role="region" aria-label={c.kicker}>
    <svg viewBox="0 0 760 360" role="img" aria-labelledby={`diagram-title-${variant}`}>
      <title id={`diagram-title-${variant}`}>{c.title}</title>
      <defs>
        <pattern id={`diagram-grid-${variant}`} width="24" height="24" patternUnits="userSpaceOnUse">
          <path d="M24 0H0V24" fill="none" stroke="var(--color-primary-8)" stroke-width="1" />
        </pattern>
        <marker
          id={`diagram-arrow-${variant}`}
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0 0L10 5L0 10Z" fill="var(--color-primary)" />
        </marker>
      </defs>

      <rect width="760" height="360" fill="var(--color-card)" />
      <rect width="760" height="360" fill={`url(#diagram-grid-${variant})`} opacity="0.5" />
      <line x1="0" y1="44" x2="760" y2="44" stroke="var(--color-primary-14)" />
      <circle cx="19" cy="23" r="5" class="d-status-ring" />
      <circle cx="19" cy="23" r="2.2" class="d-status-core" />
      <text x="32" y="27" class="d-top">{copy[lang].bar}</text>
      <text x="732" y="27" text-anchor="end" class="d-top">{copy[lang].label}</text>

      {variant === 'implementation' && (
        <>
          <text x="32" y="68" class="d-micro">{u.standardJourney}</text>
          <path class="d-line" d="M186 170H220" marker-end={`url(#diagram-arrow-${variant})`} />
          <path class="d-line" d="M384 170H418" marker-end={`url(#diagram-arrow-${variant})`} />
          <path class="d-line" d="M582 170H616" marker-end={`url(#diagram-arrow-${variant})`} />

          <rect x="32" y="112" width="154" height="116" rx="2" class="d-panel" />
          <g class="d-icon" transform="translate(48 130)"><Icon name="tabler:building-store" width="18" height="18" aria-hidden="true" /></g>
          <text x="76" y="145" class="d-label d-label--strong">{u.store}</text>
          <text x="48" y="177" class="d-micro">{u.eventsPurchases}</text>
          <text x="48" y="194" class="d-micro">{u.standardJourney}</text>

          <rect x="220" y="112" width="164" height="116" rx="2" class="d-panel" />
