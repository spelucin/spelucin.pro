<style>
  .service-diagram {
    --diagram-success: #8dd9b1;
    --diagram-attention: #efbb78;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-sm);
    background:
      radial-gradient(720px 280px at 82% -12%, var(--color-primary-8), transparent 62%),
      var(--color-card);
    box-shadow: inset 0 1px 0 rgba(240, 246, 255, 0.03), 0 18px 48px rgba(0, 0, 0, 0.18);
    transition: border-color 260ms ease, box-shadow 260ms ease;
  }
  .service-diagram:hover {
    border-color: var(--color-primary-28);
    box-shadow: inset 0 1px 0 rgba(240, 246, 255, 0.04), 0 24px 58px rgba(0, 0, 0, 0.26);
  }

  .diagram-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-primary-14);
    color: var(--color-foreground-55);
    font-size: 13.5px;
    line-height: 1.5;
  }
  .diagram-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .diagram-kicker::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-10);
    animation: status-pulse 2.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .diagram-frame {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-primary-28) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .diagram-frame:focus-visible { outline: 2px solid var(--color-ring); outline-offset: 3px; }
  .diagram-frame svg {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
    font-family: var(--font-mono);
    text-rendering: geometricPrecision;
  }

  .d-top {
    fill: var(--color-foreground-45);
    font-size: 9px;
    letter-spacing: 0.16em;
  }
  .d-micro {
    fill: var(--color-foreground-45);
    font-size: 9px;
    letter-spacing: 0.1em;
  }
  .d-label {
    fill: var(--color-foreground-70);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .d-label--strong {
    fill: var(--color-foreground);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .d-num {
    fill: var(--color-primary);
    font-size: 9px;
    letter-spacing: 0.12em;
  }
  .d-node {
    fill: var(--color-primary-4);
    stroke: var(--color-primary-28);
    stroke-width: 1;
  }
  .d-icon {
    color: var(--color-primary);
    opacity: 0.78;
  }
  .d-icon svg { display: block; }
  .d-icon--strong { opacity: 1; }
  .d-node--accent {
    fill: var(--color-primary-8);
    stroke: var(--color-primary-35);
  }
  .d-panel {
    fill: rgba(15, 18, 25, 0.78);
    stroke: var(--color-primary-14);
    stroke-width: 1;
  }
  .d-panel--accent {
    stroke: var(--color-primary-28);
    animation: panel-breathe 7s ease-in-out infinite;
  }
  .d-panel--validated,
  .d-panel--outcome {
    fill: rgba(141, 217, 177, 0.035);
    stroke: color-mix(in srgb, var(--diagram-success) 56%, transparent);
  }
  .d-node--attention {
    fill: rgba(239, 187, 120, 0.08);
    stroke: color-mix(in srgb, var(--diagram-attention) 54%, transparent);
  }
  .d-panel-head { fill: var(--color-primary-4); stroke: none; }
  .d-kpi {
    fill: var(--color-primary-4);
    stroke: var(--color-primary-14);
    stroke-width: 1;
  }
  .d-kpi-line {
    stroke: var(--color-primary);
    stroke-width: 2;
    opacity: 0.5;
    animation: kpi-read 3.4s ease-in-out infinite;
  }
  .d-line {
    fill: none;
    stroke: var(--color-primary-35);
    stroke-width: 1.2;
    stroke-dasharray: 8 8;
    stroke-linecap: round;
    animation: line-flow 3.2s linear infinite;
  }
  .d-line:nth-of-type(even) { animation-delay: -1.4s; }
  .d-loop {
    fill: none;
    stroke: var(--color-primary-20);
    stroke-width: 1;
    stroke-dasharray: 4 6;
    animation: loop-dash 9s linear infinite;
  }
  .d-dot { fill: var(--color-primary); }
  .d-dot--pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: dot-pulse 3.6s ease-in-out infinite;
  }
  .d-spark {
    fill: var(--color-primary);
    transform-box: fill-box;
    transform-origin: center;
    animation: spark-pulse 3.2s ease-in-out infinite;
  }
  .d-halo {
    fill: none;
    stroke: var(--color-primary-20);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: halo-pulse 5.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .d-status-ring {
    fill: none;
    stroke: var(--color-primary-35);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: status-ring 2.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .d-status-core { fill: var(--color-primary); }
  .d-dot-text {
    fill: var(--color-primary);
    font-size: 8px;
  }
  .d-check-ring {
    fill: var(--color-primary-5);
    stroke: var(--color-primary-35);
    stroke-width: 1;
  }
  .d-check {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .d-bars {
    stroke: var(--color-primary-35);
    stroke-width: 8;
    stroke-linecap: butt;
    transform-box: fill-box;
    transform-origin: center bottom;
    animation: chart-rise 4.6s ease-in-out infinite;
  }
  .d-mini-bars { stroke: var(--color-primary); stroke-width: 2.5; stroke-linecap: round; }
  .d-eye { fill: none; stroke: var(--color-primary-35); stroke-width: 1.2; }
  .d-diamond { fill: var(--color-primary-8); stroke: var(--color-primary-35); stroke-width: 1; }

  @keyframes status-pulse {
    0%, 100% { opacity: 0.55; transform: scale(0.86); }
    50% { opacity: 1; transform: scale(1.12); }
  }
  @keyframes status-ring {
    0%, 100% { opacity: 0.25; transform: scale(0.9); }
    50% { opacity: 0.7; transform: scale(1.18); }
  }
  @keyframes dot-pulse {
    0%, 100% { opacity: 0.55; transform: scale(0.82); }
    50% { opacity: 1; transform: scale(1.22); }
  }
  @keyframes spark-pulse {
    0%, 100% { opacity: 0.18; transform: scale(0.55); }
    50% { opacity: 1; transform: scale(1); }
  }
  @keyframes halo-pulse {
    0%, 100% { opacity: 0.35; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.06); }
  }
  @keyframes panel-breathe {
    0%, 100% { stroke-opacity: 0.7; }
    50% { stroke-opacity: 1; }
  }
  @keyframes line-flow {
    to { stroke-dashoffset: -48; }
  }
  @keyframes kpi-read {
    0%, 100% { opacity: 0.42; }
    45%, 65% { opacity: 1; }
  }
  @keyframes chart-rise {
    0%, 100% { opacity: 0.72; transform: scaleY(0.94); }
    50% { opacity: 1; transform: scaleY(1); }
  }
  @keyframes loop-dash {
    to { stroke-dashoffset: -80; }
  }

  .service-diagram:hover .d-line { animation-duration: 1.8s; }
  .service-diagram:hover .d-panel--accent { animation-duration: 3.8s; }

  @media (max-width: 640px) {
    .diagram-caption { padding: 14px 16px; font-size: 12.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-kicker::before,
    .d-panel--accent,
    .d-dot--pulse,
    .d-spark,
    .d-halo,
    .d-status-ring,
    .d-line,
    .d-kpi-line,
    .d-bars,
    .d-loop { animation: none; }
    .d-dot--pulse { opacity: 1; transform: none; }
    .d-spark { opacity: 0.7; transform: none; }
    .d-halo { opacity: 0.6; transform: none; }
    .d-status-ring { opacity: 0.55; transform: none; }
    .d-line { stroke-dasharray: none; }
    .d-kpi-line { opacity: 1; }
    .d-bars { opacity: 1; transform: none; }
  }
</style>
