          <g class="d-icon" transform="translate(44 239)"><Icon name="simple-icons:googleads" width="14" height="14" aria-hidden="true" /></g>
          <text x="66" y="251" class="d-label">GOOGLE ADS</text>
          <circle cx="196" cy="246" r="3" class="d-dot d-dot--pulse" style="animation-delay: 1.5s" />

          <rect x="284" y="80" width="170" height="176" rx="2" class="d-panel" />
          <text x="369" y="108" text-anchor="middle" class="d-label d-label--strong">{u.model}</text>
          <line x1="302" y1="122" x2="436" y2="122" stroke="var(--color-primary-14)" />
          <g class="d-icon" transform="translate(302 138)"><Icon name="tabler:receipt" width="12" height="12" aria-hidden="true" /></g>
          <text x="320" y="146" class="d-micro">{u.orders}</text>
          <text x="436" y="146" text-anchor="end" class="d-dot-text">●</text>
          <g class="d-icon" transform="translate(302 166)"><Icon name="tabler:package" width="12" height="12" aria-hidden="true" /></g>
          <text x="320" y="174" class="d-micro">{u.products}</text>
          <text x="436" y="174" text-anchor="end" class="d-dot-text">●</text>
          <g class="d-icon" transform="translate(302 194)"><Icon name="tabler:users" width="12" height="12" aria-hidden="true" /></g>
          <text x="320" y="202" class="d-micro">{u.customers}</text>
          <text x="436" y="202" text-anchor="end" class="d-dot-text">●</text>
          <g class="d-icon" transform="translate(302 222)"><Icon name="tabler:route" width="12" height="12" aria-hidden="true" /></g>
          <text x="320" y="230" class="d-micro">{u.channels}</text>
          <text x="436" y="230" text-anchor="end" class="d-dot-text">●</text>

          <path class="d-line" d="M454 168H514" marker-end={`url(#diagram-arrow-${variant})`} />

          <rect x="514" y="72" width="214" height="200" rx="2" class="d-panel d-panel--accent" />
          <rect x="514" y="72" width="214" height="28" rx="2" class="d-panel-head" />
          <g class="d-icon" transform="translate(530 78)"><Icon name="tabler:layout-dashboard" width="13" height="13" aria-hidden="true" /></g>
          <text x="548" y="90" class="d-label">{u.sharedView}</text>
          <line x1="514" y1="100" x2="728" y2="100" stroke="var(--color-primary-14)" />

          <rect x="530" y="112" width="54" height="38" rx="2" class="d-kpi" />
          <text x="557" y="127" text-anchor="middle" class="d-micro">{u.sales}</text>
          <line x1="540" y1="139" x2="574" y2="139" class="d-kpi-line" style="animation-delay: 0s" />
          <rect x="592" y="112" width="54" height="38" rx="2" class="d-kpi" />
          <text x="619" y="127" text-anchor="middle" class="d-micro">{u.conversion}</text>
