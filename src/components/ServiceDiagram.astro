          <line x1="302" y1="122" x2="438" y2="122" stroke="var(--color-primary-14)" />
          <g class="d-icon" transform="translate(302 138)"><Icon name="tabler:receipt" width="12" height="12" aria-hidden="true" /></g>
          <text x="320" y="146" class="d-micro">{u.orders}</text>
          <g class="d-icon" transform="translate(302 166)"><Icon name="tabler:package" width="12" height="12" aria-hidden="true" /></g>
