          <path class="d-line" d="M384 170H420" marker-end={`url(#diagram-arrow-${variant})`} />
          <path class="d-line" d="M584 170H616" marker-end={`url(#diagram-arrow-${variant})`} />

          <rect x="32" y="112" width="156" height="116" rx="2" class="d-panel" />
          <g class="d-icon" transform="translate(48 130)"><Icon name="tabler:building-store" width="18" height="18" aria-hidden="true" /></g>
          <text x="76" y="145" class="d-label d-label--strong">{u.store}</text>
          <text x="48" y="177" class="d-micro">{u.eventsPurchases}</text>
          <text x="48" y="194" class="d-micro">{u.standardJourney}</text>

          <rect x="220" y="112" width="164" height="116" rx="2" class="d-panel" />
          <g class="d-icon" transform="translate(238 130)"><Icon name="simple-icons:googletagmanager" width="18" height="18" aria-hidden="true" /></g>
          <text x="266" y="145" class="d-label d-label--strong">GTM</text>
          <text x="238" y="177" class="d-micro">{u.measurement}</text>
          <text x="238" y="194" class="d-micro">{u.purchaseEvent}</text>

          <rect x="420" y="112" width="164" height="116" rx="2" class="d-panel d-panel--accent" />
