          <g class="d-icon" transform="translate(44 96)"><Icon name="tabler:building-store" width="14" height="14" aria-hidden="true" /></g>
          <text x="66" y="108" class="d-label">{u.store}</text>
          <circle cx="188" cy="103" r="3" class="d-dot d-dot--pulse" />
          <rect x="32" y="136" width="170" height="38" rx="2" class="d-node" />
          <g class="d-icon" transform="translate(44 148)"><Icon name="simple-icons:googleanalytics" width="14" height="14" aria-hidden="true" /></g>
          <text x="66" y="160" class="d-label">GA4</text>
          <circle cx="188" cy="155" r="3" class="d-dot d-dot--pulse" style="animation-delay: 0.5s" />
          <rect x="32" y="188" width="170" height="38" rx="2" class="d-node" />
          <g class="d-icon" transform="translate(44 200)"><Icon name="simple-icons:googletagmanager" width="14" height="14" aria-hidden="true" /></g>
          <text x="66" y="212" class="d-label">GTM</text>
          <circle cx="188" cy="207" r="3" class="d-dot d-dot--pulse" style="animation-delay: 1s" />
