          <text x="464" y="145" class="d-label d-label--strong">GA4</text>
          <text x="436" y="177" class="d-micro">{u.eventsPurchases}</text>
          <text x="436" y="194" class="d-micro">{u.purchaseEvent}</text>

          <rect x="616" y="112" width="112" height="116" rx="2" class="d-panel d-panel--validated" />
          <g class="d-icon d-icon--strong" transform="translate(630 130)"><Icon name="tabler:circle-check" width="18" height="18" aria-hidden="true" /></g>
          <text x="630" y="177" class="d-micro">{u.validation}</text>
          <text x="630" y="194" class="d-micro">{u.documented}</text>
