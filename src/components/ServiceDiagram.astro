          <circle cx="196" cy="102" r="3" class="d-dot d-dot--pulse" />
          <rect x="32" y="132" width="180" height="36" rx="2" class="d-node" />
          <g class="d-icon" transform="translate(44 143)"><Icon name="simple-icons:googleanalytics" width="14" height="14" aria-hidden="true" /></g>
          <text x="66" y="155" class="d-label">GA4</text>
          <circle cx="196" cy="150" r="3" class="d-dot d-dot--pulse" style="animation-delay: 0.5s" />
          <rect x="32" y="180" width="180" height="36" rx="2" class="d-node" />
          <g class="d-icon" transform="translate(44 191)"><Icon name="simple-icons:meta" width="14" height="14" aria-hidden="true" /></g>
