    platform: {
      title: 'Fuentes de datos para tiendas online.',
      desc: 'Ilustra fuentes potenciales de tienda, analytics y anuncios hacia un modelo y una vista; los campos y métodos de conexión dependen de su disponibilidad y acceso.',
    },
  },
  en: {
    bar: 'System map',
    ui: {
      sources: 'Sources',
      model: 'Model',
      dashboards: 'Dashboards',
      decisions: 'Decisions',
      cycle: 'Recurring loop',
      store: 'Store',
      pixels: 'Pixels',
      measurement: 'Measurement',
      standardJourney: 'Standard journey',
      purchaseEvent: 'Purchase event',
      documented: 'Documented setup',
      orders: 'Orders',
      products: 'Products',
      customers: 'Customers',
      channels: 'Channels',
      agreedFixes: 'Fixes',
      onlyIfScoped: 'If agreed',
      view: 'View',
      sharedView: 'Shared view',
      viewSummary: 'Sales · conv. · AOV',
      price: 'Price',
      stock: 'Stock',
      channel: 'Channel',
      action: 'Action',
      output: 'Output',
      validation: 'Validation',
      eventsPurchases: 'Events · purchases',
      consent: 'Consent',
      data: 'Data',
      findings: 'Findings',
      prioritized: 'Prioritized',
      readingTitle: 'Reading',
      hypothesis: 'Hypothesis',
      cleanSources: 'Clean sources',
      whatChanged: 'What changed',
      whyHappened: 'Why it happened',
      whatToDo: 'What to do',
      eachCycle: 'Each cycle',
      learnAdjust: 'Adjust',
