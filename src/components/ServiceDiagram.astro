      {variant === 'audit' && (
        <>
          <text x="32" y="68" class="d-micro">{u.sources}</text>
          <text x="296" y="68" class="d-micro">{u.validation}</text>
          <text x="566" y="68" class="d-micro">{u.output}</text>

