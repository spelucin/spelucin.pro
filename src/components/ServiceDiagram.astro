      {(variant === 'dashboards' || variant === 'platform') && (
        <>
          <text x="32" y="68" class="d-micro">{u.sources}</text>
          <text x="284" y="68" class="d-micro">{u.model}</text>
          <text x="514" y="68" class="d-micro">{u.view}</text>

          <path class="d-line" d="M212 102C252 102 252 180 284 180" marker-end={`url(#diagram-arrow-${variant})`} />
          <path class="d-line" d="M212 150C252 150 252 180 284 180" marker-end={`url(#diagram-arrow-${variant})`} />
          <path class="d-line" d="M212 198C252 198 252 180 284 180" marker-end={`url(#diagram-arrow-${variant})`} />
          <path class="d-line" d="M212 246C252 246 252 180 284 180" marker-end={`url(#diagram-arrow-${variant})`} />

          <rect x="32" y="84" width="180" height="36" rx="2" class="d-node" />
          {variant === 'platform' && platform === 'shopify' && (
            <g class="d-icon" transform="translate(44 95)"><Icon name="simple-icons:shopify" width="14" height="14" aria-hidden="true" /></g>
          )}
          {variant === 'platform' && platform === 'tiendanube' && (
            <text x="44" y="107" class="d-label">TIENDANUBE</text>
          )}
          {variant === 'platform' && platform === 'shopify' && (
            <text x="66" y="107" class="d-label">SHOPIFY</text>
          )}
          {variant === 'dashboards' && (
            <g class="d-icon" transform="translate(44 95)"><Icon name="tabler:building-store" width="14" height="14" aria-hidden="true" /></g>
          )}
          {variant === 'dashboards' && (
            <text x="66" y="107" class="d-label">{u.store}</text>
