          <text x="466" y="145" class="d-label d-label--strong">GA4</text>
          <text x="438" y="177" class="d-micro">{u.eventsPurchases}</text>
          <text x="438" y="194" class="d-micro">{u.purchaseEvent}</text>

          <rect x="616" y="112" width="112" height="116" rx="2" class="d-panel d-panel--outcome" />
