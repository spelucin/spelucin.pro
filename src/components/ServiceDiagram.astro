const c = copy[lang][variant];
const u = copy[lang].ui;
const view = {
  implementation: { box: '0 44 760 212', height: 212 },
  audit: { box: '0 44 760 260', height: 260 },
  dashboards: { box: '0 44 760 240', height: 240 },
  analysis: { box: '0 44 760 276', height: 276 },
  home: { box: '0 44 760 300', height: 300 },
  platform: { box: '0 44 760 240', height: 240 },
}[variant];
---

<figure class={`service-diagram service-diagram--${variant} ${className}`}>
  <div class="diagram-window">
    <div class="diagram-titlebar" aria-hidden="true">
      <div class="window-controls"><span></span><span></span><span></span></div>
      <span class="window-title">{copy[lang].bar}</span>
    </div>
    <div class="diagram-frame" tabindex="0" role="region" aria-label={c.title}>
      <svg viewBox={view.box} role="img" aria-labelledby={`diagram-title-${variant} diagram-desc-${variant}`}>
      <title id={`diagram-title-${variant}`}>{c.title}</title>
      <desc id={`diagram-desc-${variant}`}>{c.desc}</desc>
      <defs>
        <pattern id={`diagram-grid-${variant}`} width="24" height="24" patternUnits="userSpaceOnUse">
          <path d="M24 0H0V24" fill="none" stroke="var(--color-primary-8)" stroke-width="1" />
        </pattern>
        <marker
          id={`diagram-arrow-${variant}`}
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="8"
          markerHeight="8"
          markerUnits="userSpaceOnUse"
          orient="auto-start-reverse"
        >
          <path d="M0 0L10 5L0 10Z" fill="var(--color-primary)" />
        </marker>
      </defs>

      <rect x="0" y="44" width="760" height={view.height} fill="var(--color-card)" />
