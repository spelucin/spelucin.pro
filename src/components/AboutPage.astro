---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import avatar from '../assets/alex-spelucin-avatar.jpg';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHead from './SectionHead.astro';
import BookCall from './BookCall.astro';
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
---

<SiteHeader t={t} />

<main id="main-content">
  <section class="page-hero reveal">
    <div class="container-site">
      <p class="hero-eyebrow">{t.hero.role}</p>
      <h1 class="hero-title">{t.aboutPage.hero.headline} <span class="text-primary">{t.aboutPage.hero.highlight}</span></h1>
      <p class="hero-intro">{t.aboutPage.hero.sub}</p>
    </div>
  </section>

  <section class="bio section-block reveal">
    <div class="container-site bio-grid">
      <div class="bio-main">
        <Image class="avatar" src={avatar} alt={t.about.portraitAlt} width={100} height={100} format="webp" loading="lazy" />
        <div class="bio-paragraphs">
          {t.about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="bio-side">
        <dl class="meta-dl">
          {t.about.meta.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="capabilities section-block reveal">
    <div class="container-site">
      <SectionHead
        heading={t.aboutPage.capabilities.heading}
        highlight={t.aboutPage.capabilities.highlight}
        intro={t.aboutPage.capabilities.intro}
      />

      <div class="capabilities-grid">
        {t.focus.items.map((item, i) => (
          <article class="capability-card">
            <span class="row-number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.name}</h3>
            <p class="tagline">{item.tagline}</p>
            <p class="detail">{item.detail}</p>
            <ul class="chips-list" role="list">
              {item.tags.map((tag) => (
                <li class="chip">{tag}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="stack section-block reveal">
    <div class="container-site">
      <SectionHead
        heading={t.stack.heading}
        highlight={t.stack.highlight}
        intro={t.stack.intro}
      />

      <div class="stack-layers">
        {t.stack.layers.map((layer) => (
          <div class="stack-layer">
            <h3>{layer.name}</h3>
            <ul class="stack-items" role="list">
              {layer.items.map((item) => (
                <li class="stack-item">
                  <Icon name={item.icon} width="20" height="20" aria-hidden="true" />
                  <span>{item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <BookCall t={t} location="about" />
</main>

<SiteFooter t={t} />

<script>
  import '../scripts/reveal';
</script>

<style>
  .bio-grid { display: grid; gap: 48px; align-items: start; }
  .avatar { display: block; width: 100px; height: 100px; margin-bottom: 24px; border: 1px solid var(--color-primary-20); border-radius: 50%; object-fit: cover; }
  .bio-paragraphs { display: grid; gap: 16px; color: var(--color-foreground-70); font-size: 18px; line-height: 1.7; }
  .meta-dl { display: grid; gap: 0; margin: 0; padding: 20px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-md); background: var(--color-card); }
  .meta-dl div { display: flex; justify-content: space-between; gap: 20px; padding: 14px 0; border-bottom: 1px solid var(--color-primary-8); }
  .meta-dl div:last-child { border-bottom: 0; }
  .meta-dl dt { color: var(--color-foreground-55); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; }
  .meta-dl dd { margin: 0; color: var(--color-foreground); font-size: 14px; text-align: right; }

  .capabilities-grid { display: grid; gap: 18px; }
  .capability-card {
    display: flex; flex-direction: column; gap: 12px; padding: 26px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-md); background: var(--color-card); transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .capability-card:hover { border-color: var(--color-primary-35); transform: translateY(-2px); }
  .row-number { color: var(--color-primary); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; }
  .capability-card h3 { margin: 0; font-size: 20px; font-weight: 650; letter-spacing: -0.02em; }
  .tagline { margin: 0; color: var(--color-primary); font-family: var(--font-mono); font-size: 12px; }
  .detail { margin: 0; color: var(--color-foreground-55); font-size: 14px; line-height: 1.6; flex-grow: 1; }
  .chips-list { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; padding: 0; list-style: none; }

  .stack-layers { display: grid; gap: 24px; }
  .stack-layer { padding: 28px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-md); background: var(--color-primary-4); }
  .stack-layer h3 { margin: 0 0 20px; color: var(--color-foreground-70); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
  .stack-items { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .stack-item { display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px; border: 1px solid var(--color-primary-14); border-radius: 999px; background: var(--color-card); font-size: 14px; font-weight: 500; }
  .stack-item svg { color: var(--color-primary); }

  @media (min-width: 768px) {
    .bio-grid { grid-template-columns: 1.2fr 0.8fr; gap: 64px; }
    .capabilities-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .stack-layers { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .bio { padding-top: 48px; }
  .capability-card, .stack-layer, .meta-dl { border-radius: var(--radius-sm); }
  .capability-card { min-height: 300px; box-shadow: 6px 6px 0 rgba(96, 165, 250, 0.05); }
  .capability-card:nth-child(2) { transform: translateY(28px); }
  .capability-card:nth-child(2):hover { transform: translateY(24px); }
  .capability-card:nth-child(3) { transform: translateY(56px); }
  .capability-card:nth-child(3):hover { transform: translateY(52px); }
  .stack-layer { background: rgba(15, 18, 25, 0.7); }

  @media (max-width: 767px) {
    .capability-card:nth-child(2), .capability-card:nth-child(3) { transform: none; }
    .capability-card:nth-child(2):hover, .capability-card:nth-child(3):hover { transform: translateY(-2px); }
  }
</style>
