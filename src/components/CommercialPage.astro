---
import { Icon } from 'astro-icon/components';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHead from './SectionHead.astro';
import BookCall from './BookCall.astro';
import Faq from './Faq.astro';
import ServiceDiagram from './ServiceDiagram.astro';
import type { Translations } from '../i18n/types';
import type { CommercialPageContent } from '../i18n/commercialTypes';
import { commercialEs } from '../i18n/commercial-es';
import { commercialEn } from '../i18n/commercial-en';
import { commercialHref } from '../data/commercialRoutes';
import { site } from '../data/site';

interface Props {
  t: Translations;
  page: CommercialPageContent;
}

const { t, page }: Props = Astro.props;
const commercial = t.lang === 'es' ? commercialEs : commercialEn;
const allCards = [
  ...commercial.servicesHub.cards,
  ...commercial.platformsHub.cards,
];
const relatedCards = page.related
  .map((key) => allCards.find((card) => card.key === key))
  .filter((card): card is NonNullable<typeof card> => Boolean(card));
const hasScopedPricingOption = Boolean(
  page.pricing?.alternative?.scope?.length && page.pricing?.alternative?.boundaries?.length,
);
const linkLabel = t.lang === 'es' ? 'Ver servicio' : 'View service';
const platform = page.key === 'shopify' || page.key === 'tiendanube' ? page.key : undefined;
const diagramVariant: 'implementation' | 'audit' | 'dashboards' | 'analysis' | 'platform' =
  page.key === 'shopify' || page.key === 'tiendanube' ? 'platform' : page.key;
---

<SiteHeader t={t} />

<main id="main-content" class="commercial-page">
  <section class="commercial-hero commercial-hero--with-diagram">
    <div class="container-site">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-mark">{page.eyebrow}</p>
          <h1>{page.hero.headline} <span class="text-primary">{page.hero.highlight}</span></h1>
          <p class="hero-sub">{page.hero.sub}</p>
          {page.pricing && (
            <a class="hero-price" href="#pricing">
              <strong>{page.pricing.amount}</strong>
              <span>· {page.pricing.cadence}</span>
            </a>
          )}
          <div class="hero-actions">
            <a
              class="btn btn-primary"
              href={site.cal}
              data-cal-modal
              data-calendar
              data-calendar-location={`service-hero-${page.key}`}
              data-cta
              data-cta-text={page.hero.ctaPrimary}
              data-cta-location={`service-hero-${page.key}`}
            >
              {page.hero.ctaPrimary}
              <Icon name="tabler:arrow-up-right" width="16" height="16" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
      <div class="hero-diagram">
        <ServiceDiagram variant={diagramVariant} platform={platform} lang={t.lang} />
      </div>
    </div>
  </section>

  <section class="commercial-section reveal">
    <div class="container-site">
      <SectionHead
        compact
        heading={page.problem.heading}
        highlight={page.problem.highlight}
        intro={page.problem.intro}
      />
      <div class="problem-list">
        {page.problem.items.map((item, i) => (
          <article class="problem-row">
            <span class="row-number">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="commercial-section reveal">
    <div class="container-site">
      <SectionHead
        compact
        heading={page.scope.heading}
        highlight={page.scope.highlight}
        intro={page.scope.intro}
      />
      <div class="scope-grid">
        {page.scope.items.map((item, i) => (
          <article class="scope-card">
            <span class="row-number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="commercial-section reveal">
    <div class="container-site">
      <SectionHead
        compact
        heading={page.process.heading}
        highlight={page.process.highlight}
        intro={page.process.intro}
      />
      <ol class="process-list" role="list">
        {page.process.steps.map((step, i) => (
          <li class="process-row">
            <span class="process-index">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="commercial-section reveal">
    <div class="container-site deliverables-grid">
      <div>
        <SectionHead
          flush
          compact
          heading={page.deliverables.heading}
          highlight={page.deliverables.highlight}
          intro={page.deliverables.intro}
        />
      </div>
      <ul class="deliverables-list" role="list">
        {page.deliverables.items.map((item) => (
          <li>
            <Icon name="tabler:check" width="15" height="15" aria-hidden="true" />
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {page.pricing && (
    <section class="commercial-section pricing-section reveal" id="pricing">
      <div class="container-site">
        <SectionHead
          heading={page.pricing.heading}
          highlight={page.pricing.highlight}
          intro={page.pricing.intro}
        />
        <div class:list={['pricing-grid', hasScopedPricingOption && 'pricing-grid--paired']}>
          <div class="price-summary">
            <p class="price-cadence">{page.pricing.cadence}</p>
            <p class="price-amount">{page.pricing.amount}</p>
            <h3>{page.pricing.scopeHeading}</h3>
            <ul role="list">
              {page.pricing.scope.map((item) => (
                <li><Icon name="tabler:check" width="14" height="14" aria-hidden="true" />{item}</li>
              ))}
            </ul>
            {page.pricing.alternative && !hasScopedPricingOption && (
              <aside class="price-option">
                <h4>{page.pricing.alternative.heading}</h4>
                <strong>{page.pricing.alternative.amount}</strong>
                <p>{page.pricing.alternative.detail}</p>
              </aside>
            )}
          </div>
          {hasScopedPricingOption && page.pricing.alternative && (
            <article class="price-summary price-option-card">
              <p class="price-cadence">{page.pricing.alternative.cadence ?? page.pricing.cadence}</p>
              <p class="price-amount">{page.pricing.alternative.amount}</p>
              <h3>{page.pricing.alternative.heading}</h3>
              <p class="price-option-detail">{page.pricing.alternative.detail}</p>
              <h4>{page.pricing.alternative.scopeHeading ?? (t.lang === 'es' ? 'Alcance de partida' : 'Starting scope')}</h4>
              <ul role="list">
                {page.pricing.alternative.scope?.map((item) => (
                  <li><Icon name="tabler:check" width="14" height="14" aria-hidden="true" />{item}</li>
                ))}
              </ul>
              <div class="price-option-boundaries">
                <h4>{page.pricing.alternative.boundariesHeading ?? (t.lang === 'es' ? 'No incluye' : 'Not included')}</h4>
                <ul role="list">
                  {page.pricing.alternative.boundaries?.map((item) => (
                    <li><Icon name="tabler:arrow-up-right" width="14" height="14" aria-hidden="true" />{item}</li>
                  ))}
                </ul>
              </div>
            </article>
          )}
          <div class="price-boundaries">
            <p class="price-note">{page.pricing.note}</p>
            <h3>{page.pricing.boundariesHeading}</h3>
            <ul role="list">
              {page.pricing.boundaries.map((item) => (
                <li><Icon name="tabler:arrow-up-right" width="14" height="14" aria-hidden="true" />{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="commercial-section reveal">
    <div class="container-site">
      <SectionHead compact heading={page.fit.heading} highlight={page.fit.highlight} />
      <div class="fit-grid">
        <div class="fit-col">
          <h3>{page.fit.goodHeading}</h3>
          <ul role="list">
            {page.fit.good.map((item) => (
              <li><Icon name="tabler:check" width="14" height="14" aria-hidden="true" />{item}</li>
            ))}
          </ul>
        </div>
        <div class="fit-col fit-col--poor">
          <h3>{page.fit.poorHeading}</h3>
          <ul role="list">
            {page.fit.poor.map((item) => (
              <li><Icon name="tabler:x" width="14" height="14" aria-hidden="true" />{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {relatedCards.length > 0 && (
    <section class="commercial-section related-section reveal">
      <div class="container-site">
        <SectionHead compact heading={page.relatedHeading} intro={page.relatedIntro} />
        <div class="related-grid">
          {relatedCards.map((card, i) => (
            <a class="related-card" href={commercialHref(card.key, t.lang)}>
              <span class="related-index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <span class="related-link">{linkLabel} <Icon name="tabler:arrow-right" width="15" height="15" aria-hidden="true" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Faq
    sectionClass="commercial-section"
    compact
    heading={page.faq.heading}
    highlight={page.faq.highlight}
    items={page.faq.items}
  />

  <BookCall t={t} quiet location={`service-${page.key}`} />
</main>

<SiteFooter t={t} />

<script>
  import '../scripts/reveal';
</script>

<style>
  .commercial-hero {
    position: relative;
    padding: 112px 0 72px;
    overflow: hidden;
  }
  .hero-inner { position: relative; }
  .hero-copy { display: grid; justify-items: start; gap: 18px; max-width: 700px; }
  .hero-mark { margin: 0; color: var(--color-primary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; }
  h1 { margin: 0; max-width: 18ch; font-size: clamp(38px, 4.7vw, 58px); font-weight: 700; letter-spacing: -0.06em; line-height: 1.04; text-wrap: balance; }
  .hero-sub { max-width: 58ch; margin: 0; color: var(--color-foreground-70); font-size: 16px; line-height: 1.65; text-wrap: pretty; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .hero-price { display: inline-flex; flex-wrap: wrap; gap: 7px; margin-top: -4px; color: var(--color-foreground-55); font-size: 13px; text-decoration: none; }
  .hero-price strong { color: var(--color-foreground); font-weight: 600; }
  .hero-price:hover strong { color: var(--color-primary); }

  .hero-diagram { position: relative; margin-top: clamp(36px, 4.5vw, 56px); }
  .commercial-hero--with-diagram { padding-bottom: 48px; }

  .commercial-section { padding: clamp(64px, 7vw, 88px) 0; }
  .commercial-hero--with-diagram + .commercial-section { padding-top: 52px; }

  .problem-list { border-top: 1px solid var(--color-primary-14); }
  .problem-row { display: grid; grid-template-columns: 32px 1fr; gap: 16px; align-items: start; padding: 22px 0; border-bottom: 1px solid var(--color-primary-14); }
  .row-number { color: var(--color-primary); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; }
  .problem-row h3, .scope-card h3, .process-row h3 { margin: 0; color: var(--color-foreground); font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }
  .problem-row p, .scope-card p, .process-row p { max-width: 58ch; margin: 6px 0 0; color: var(--color-foreground-55); font-size: 14px; line-height: 1.65; }

  .scope-grid { display: grid; gap: 0 32px; border-top: 1px solid var(--color-primary-14); }
  .scope-card { padding: 20px 0 22px; border: 0; border-bottom: 1px solid var(--color-primary-14); border-radius: 0; background: transparent; }
  .scope-card h3 { margin-top: 8px; font-size: 17px; }

  .process-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 0; border-top: 1px solid var(--color-primary-14); }
  .process-row { display: grid; grid-template-columns: 32px 1fr; gap: 16px; align-items: start; padding: 22px 0; border-bottom: 1px solid var(--color-primary-14); }
  .process-index { display: inline-flex; justify-content: flex-start; margin-top: 3px; color: var(--color-primary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; }

  .pricing-grid { display: grid; gap: 0; border-top: 1px solid var(--color-primary-14); }
  .price-summary, .price-boundaries { padding: 22px 0; border: 0; border-bottom: 1px solid var(--color-primary-14); border-radius: 0; background: transparent; }
  .price-cadence { margin: 0; color: var(--color-primary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.13em; text-transform: uppercase; }
  .price-amount { margin: 7px 0 20px; color: var(--color-foreground); font-size: clamp(25px, 3vw, 34px); font-weight: 600; letter-spacing: -0.045em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .price-summary h3, .price-boundaries h3 { margin: 0 0 14px; color: var(--color-foreground); font-size: 15px; font-weight: 600; }
  .price-summary ul, .price-boundaries ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .price-summary li, .price-boundaries li { display: flex; align-items: flex-start; gap: 8px; color: var(--color-foreground-55); font-size: 13px; line-height: 1.6; }
  .price-summary li svg { flex: 0 0 auto; margin-top: 3px; color: var(--color-primary); }
  .price-boundaries li svg { flex: 0 0 auto; margin-top: 3px; color: var(--color-foreground-45); }
  .price-note { margin: 0 0 22px; color: var(--color-foreground-55); font-size: 13px; line-height: 1.65; }
  .price-option { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--color-primary-14); }
  .price-option h4 { margin: 0 0 7px; color: var(--color-foreground-70); font-size: 13px; font-weight: 600; }
  .price-option strong { color: var(--color-primary); font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .price-option p { margin: 7px 0 0; color: var(--color-foreground-55); font-size: 13px; line-height: 1.55; }
  .price-option-card h4 { margin: 18px 0 10px; color: var(--color-foreground-70); font-size: 12px; font-weight: 600; }
  .price-option-detail { max-width: 58ch; margin: -8px 0 0; color: var(--color-foreground-55); font-size: 13px; line-height: 1.6; }
  .price-option-boundaries { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--color-primary-14); }
  .price-option-boundaries h4 { margin-top: 0; }
  .price-option-boundaries li svg { flex: 0 0 auto; margin-top: 3px; color: var(--color-foreground-45); }

  .deliverables-grid { display: grid; gap: 28px; }
  .deliverables-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; margin: 0; padding: 0; list-style: none; align-content: start; }
  .deliverables-list li { display: flex; align-items: flex-start; gap: 8px; padding: 12px 0; border-bottom: 1px solid var(--color-primary-14); color: var(--color-foreground-70); font-size: 13px; line-height: 1.55; }
  .deliverables-list svg { color: var(--color-primary); }

  .fit-grid { display: grid; gap: 28px; }
  .fit-col { padding: 0; border: 0; border-radius: 0; background: transparent; }
  .fit-col--poor { padding-top: 24px; border-top: 1px solid var(--color-primary-14); }
  .fit-col h3 { margin: 0 0 14px; color: var(--color-foreground-70); font-size: 14px; font-weight: 600; }
  .fit-col ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .fit-col li { display: flex; align-items: flex-start; gap: 9px; color: var(--color-foreground-55); font-size: 13px; line-height: 1.6; }
  .fit-col svg { flex-shrink: 0; margin-top: 2px; color: var(--color-primary); }
  .fit-col--poor svg { color: var(--color-foreground-35); }

  .related-section { border-top: 1px solid var(--color-primary-8); }
  .related-grid { display: grid; gap: 0; border-top: 1px solid var(--color-primary-14); }
  .related-card { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 7px 16px; padding: 18px 0; border-bottom: 1px solid var(--color-primary-14); border-radius: 0; background: transparent; color: var(--color-foreground); text-decoration: none; transition: border-color 0.2s ease, color 0.2s ease; }
  .related-card:hover { border-color: var(--color-primary-35); color: var(--color-primary); }
  .related-index { color: var(--color-primary); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.14em; }
  .related-card h3 { grid-column: 2; margin: 0; font-size: 16px; font-weight: 600; letter-spacing: -0.02em; }
  .related-card p { grid-column: 2; margin: 0; color: var(--color-foreground-55); font-size: 13px; line-height: 1.55; }
  .related-link { grid-column: 2; display: inline-flex; align-items: center; gap: 6px; margin-top: 3px; color: var(--color-primary); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; }

  @media (min-width: 768px) {
    .scope-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .process-row { grid-template-columns: 40px 1fr; gap: 20px; padding: 24px 0; }
    .fit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
    .fit-col--poor { padding: 0 0 0 32px; border-top: 0; border-left: 1px solid var(--color-primary-14); }
    .related-card { grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center; gap: 8px 16px; }
    .related-index { grid-column: 1; grid-row: 1 / span 3; }
    .related-card h3, .related-card p { grid-column: 2; }
    .related-link { grid-column: 3; grid-row: 1 / span 3; margin: 0 0 0 12px; white-space: nowrap; }
    .deliverables-grid { grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: start; }
    .pricing-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.88fr); gap: 32px; }
    .price-boundaries { padding-left: 32px; border-left: 1px solid var(--color-primary-14); border-bottom: 0; }
    .pricing-grid--paired { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
    .pricing-grid--paired .price-boundaries { grid-column: 1 / -1; padding: 22px 0 0; border-top: 1px solid var(--color-primary-14); border-left: 0; }
    .pricing-grid--paired .price-option-card { padding-left: 32px; border-left: 1px solid var(--color-primary-14); }
  }
  @media (max-width: 560px) {
    .commercial-hero { padding: 96px 0 52px; }
    .commercial-hero--with-diagram { padding-bottom: 38px; }
    .hero-diagram { margin-top: 32px; }
    h1 { font-size: clamp(36px, 10vw, 46px); }
    .commercial-section { padding: 56px 0; }
    .deliverables-list { grid-template-columns: 1fr; }
    .related-card { grid-template-columns: 24px minmax(0, 1fr); gap: 6px 12px; }
    .related-link { margin-top: 3px; }
    .price-boundaries { padding-left: 0; border-left: 0; border-bottom: 1px solid var(--color-primary-14); }
  }
</style>
