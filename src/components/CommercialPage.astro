---
import { Icon } from 'astro-icon/components';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHead from './SectionHead.astro';
import BookCall from './BookCall.astro';
import Faq from './Faq.astro';
import ServiceDiagram from './ServiceDiagram.astro';
import type { Translations } from '../i18n/types';
import type { CommercialPageContent } from '../i18n/commercialTypes';
import { commercialEs } from '../i18n/commercial-es';
import { commercialEn } from '../i18n/commercial-en';
import { commercialHref } from '../data/commercialRoutes';
import { site } from '../data/site';

interface Props {
  t: Translations;
  page: CommercialPageContent;
}

const { t, page }: Props = Astro.props;
const commercial = t.lang === 'es' ? commercialEs : commercialEn;
const allCards = [
  ...commercial.servicesHub.cards,
  ...commercial.platformsHub.cards,
];
const relatedCards = page.related
  .map((key) => allCards.find((card) => card.key === key))
  .filter((card): card is NonNullable<typeof card> => Boolean(card));
const linkLabel = t.lang === 'es' ? 'Ver servicio' : 'View service';
const platform = page.key === 'shopify' || page.key === 'tiendanube' ? page.key : undefined;
const diagramVariant: 'implementation' | 'audit' | 'dashboards' | 'analysis' | 'platform' =
  page.key === 'shopify' || page.key === 'tiendanube' ? 'platform' : page.key;
---

<SiteHeader t={t} />

<main id="main-content">
  <section class="commercial-hero commercial-hero--with-diagram">
    <div class="container-site">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-mark">{page.eyebrow}</p>
          <h1>{page.hero.headline} <span class="text-primary">{page.hero.highlight}</span></h1>
          <p class="hero-sub">{page.hero.sub}</p>
          {page.pricing && (
            <a class="hero-price" href="#pricing">
              <strong>{page.pricing.amount}</strong>
              <span>· {page.pricing.cadence}</span>
            </a>
          )}
          <div class="hero-actions">
            <a
              class="btn btn-primary"
              href={site.cal}
              data-cal-modal
              data-calendar
              data-calendar-location={`service-hero-${page.key}`}
              data-cta
              data-cta-text={page.hero.ctaPrimary}
              data-cta-location={`service-hero-${page.key}`}
            >
              {page.hero.ctaPrimary}
              <Icon name="tabler:arrow-up-right" width="16" height="16" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
      <div class="hero-diagram">
        <ServiceDiagram variant={diagramVariant} platform={platform} lang={t.lang} />
      </div>
    </div>
  </section>

  <section class="commercial-section reveal">
    <div class="container-site">
      <SectionHead
        heading={page.problem.heading}
        highlight={page.problem.highlight}
        intro={page.problem.intro}
      />
      <div class="problem-list">
        {page.problem.items.map((item, i) => (
          <article class="problem-row">
            <span class="row-number">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="commercial-section reveal">
    <div class="container-site">
      <SectionHead
        heading={page.scope.heading}
        highlight={page.scope.highlight}
        intro={page.scope.intro}
      />
      <div class="scope-grid">
        {page.scope.items.map((item, i) => (
          <article class="scope-card">
            <span class="row-number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="commercial-section reveal">
    <div class="container-site">
      <SectionHead
        heading={page.process.heading}
        highlight={page.process.highlight}
        intro={page.process.intro}
      />
      <ol class="process-list" role="list">
        {page.process.steps.map((step, i) => (
          <li class="process-row">
            <span class="process-index">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="commercial-section reveal">
    <div class="container-site deliverables-grid">
      <div>
        <SectionHead
          flush
          heading={page.deliverables.heading}
          highlight={page.deliverables.highlight}
          intro={page.deliverables.intro}
        />
      </div>
      <ul class="deliverables-list" role="list">
        {page.deliverables.items.map((item) => (
          <li>
            <Icon name="tabler:check" width="15" height="15" aria-hidden="true" />
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {page.pricing && (
    <section class="commercial-section pricing-section reveal" id="pricing">
      <div class="container-site">
        <SectionHead
          heading={page.pricing.heading}
          highlight={page.pricing.highlight}
          intro={page.pricing.intro}
        />
        <div class="pricing-grid">
          <div class="price-summary">
            <p class="price-cadence">{page.pricing.cadence}</p>
            <p class="price-amount">{page.pricing.amount}</p>
            <h3>{page.pricing.scopeHeading}</h3>
            <ul role="list">
              {page.pricing.scope.map((item) => (
                <li><Icon name="tabler:check" width="14" height="14" aria-hidden="true" />{item}</li>
              ))}
            </ul>
            {page.pricing.alternative && (
              <aside class="price-option">
                <h4>{page.pricing.alternative.heading}</h4>
                <strong>{page.pricing.alternative.amount}</strong>
                <p>{page.pricing.alternative.detail}</p>
              </aside>
            )}
          </div>
          <div class="price-boundaries">
            <p class="price-note">{page.pricing.note}</p>
            <h3>{page.pricing.boundariesHeading}</h3>
            <ul role="list">
              {page.pricing.boundaries.map((item) => (
                <li><Icon name="tabler:arrow-up-right" width="14" height="14" aria-hidden="true" />{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="commercial-section reveal">
    <div class="container-site">
      <SectionHead heading={page.fit.heading} highlight={page.fit.highlight} />
      <div class="fit-grid">
        <div class="fit-col">
          <h3>{page.fit.goodHeading}</h3>
          <ul role="list">
            {page.fit.good.map((item) => (
              <li><Icon name="tabler:check" width="14" height="14" aria-hidden="true" />{item}</li>
            ))}
          </ul>
        </div>
        <div class="fit-col fit-col--poor">
          <h3>{page.fit.poorHeading}</h3>
          <ul role="list">
            {page.fit.poor.map((item) => (
              <li><Icon name="tabler:x" width="14" height="14" aria-hidden="true" />{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {relatedCards.length > 0 && (
    <section class="commercial-section related-section reveal">
      <div class="container-site">
        <SectionHead heading={page.relatedHeading} intro={page.relatedIntro} />
        <div class="related-grid">
          {relatedCards.map((card, i) => (
            <a class="related-card" href={commercialHref(card.key, t.lang)}>
              <span class="related-index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <span class="related-link">{linkLabel} <Icon name="tabler:arrow-right" width="15" height="15" aria-hidden="true" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Faq
    sectionClass="commercial-section"
    heading={page.faq.heading}
    highlight={page.faq.highlight}
    items={page.faq.items}
  />

  <BookCall t={t} location={`service-${page.key}`} />
</main>

<SiteFooter t={t} />

<script>
  import '../scripts/reveal';
</script>

<style>
  .commercial-hero {
    position: relative;
    padding: 128px 0 96px;
    border-bottom: 1px solid var(--color-primary-20);
    overflow: hidden;
  }
  .commercial-hero::before {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgba(96, 165, 250, 0.08) 1px, transparent 1px);
    background-size: 25% 100%;
    opacity: 0.5;
    -webkit-mask-image: linear-gradient(to right, #000, transparent 80%);
    mask-image: linear-gradient(to right, #000, transparent 80%);
    pointer-events: none;
    content: '';
  }
  .hero-inner { position: relative; }
  .hero-copy { display: grid; justify-items: start; gap: 22px; max-width: 820px; }
  .hero-mark { margin: 0; color: var(--color-primary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; }
  h1 { margin: 0; max-width: 15ch; font-size: clamp(40px, 5.2vw, 66px); font-weight: 700; letter-spacing: -0.06em; line-height: 1.02; text-wrap: balance; }
  .hero-sub { max-width: 62ch; margin: 0; color: var(--color-foreground-70); font-size: clamp(17px, 1.6vw, 19px); line-height: 1.65; text-wrap: pretty; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .hero-price { display: inline-flex; flex-wrap: wrap; gap: 7px; margin-top: -8px; color: var(--color-foreground-55); font-size: 14px; text-decoration: none; }
  .hero-price strong { color: var(--color-foreground); font-weight: 600; }
  .hero-price:hover strong { color: var(--color-primary); }

  .hero-diagram { position: relative; margin-top: clamp(48px, 6vw, 72px); }
  .commercial-hero--with-diagram { padding-bottom: 56px; }

  .commercial-section { padding: var(--space-block) 0; border-top: 1px solid var(--color-primary-14); }
  .commercial-hero + .commercial-section { border-top: 0; }
  .commercial-hero--with-diagram + .commercial-section { padding-top: 64px; }

  .problem-list { border-top: 1px solid var(--color-primary-14); }
  .problem-row { display: grid; grid-template-columns: 44px 1fr; gap: 18px; align-items: start; padding: 32px 0; border-bottom: 1px solid var(--color-primary-14); }
  .row-number { color: var(--color-primary); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; }
  .problem-row h3, .scope-card h3, .process-row h3 { margin: 0; color: var(--color-foreground); font-size: 22px; font-weight: 650; letter-spacing: -0.02em; }
  .problem-row p, .scope-card p, .process-row p { max-width: 58ch; margin: 8px 0 0; color: var(--color-foreground-55); font-size: 15px; line-height: 1.6; }

  .scope-grid { display: grid; gap: 16px; }
  .scope-card { padding: 24px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-sm); background: var(--color-card); }
  .scope-card h3 { margin-top: 12px; font-size: 18px; }
  .scope-card p { font-size: 14px; }

  .process-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 0; border-top: 1px solid var(--color-primary-14); border-bottom: 1px solid var(--color-primary-14); }
  .process-row { position: relative; display: grid; grid-template-columns: 56px 1fr; gap: 20px; align-items: start; padding: 28px 0; }
  .process-row::before { content: ''; position: absolute; left: 28px; top: 0; bottom: 0; width: 1px; background: var(--color-primary-14); }
  .process-row:first-child::before { top: 50%; }
  .process-row:last-child::before { bottom: 50%; }
  .process-index { position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: center; justify-self: center; width: 42px; height: 42px; margin-top: 2px; border: 1px solid var(--color-primary-28); border-radius: var(--radius-sm); background: var(--color-card); color: var(--color-primary); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; }

  .pricing-grid { display: grid; gap: 18px; }
  .price-summary, .price-boundaries { padding: 24px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-sm); background: var(--color-card); }
  .price-cadence { margin: 0; color: var(--color-primary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.13em; text-transform: uppercase; }
  .price-amount { margin: 8px 0 26px; color: var(--color-foreground); font-size: clamp(28px, 4vw, 40px); font-weight: 650; letter-spacing: -0.055em; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .price-summary h3, .price-boundaries h3 { margin: 0 0 16px; color: var(--color-foreground); font-size: 16px; font-weight: 600; }
  .price-summary ul, .price-boundaries ul { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .price-summary li, .price-boundaries li { display: flex; align-items: flex-start; gap: 9px; color: var(--color-foreground-55); font-size: 14px; line-height: 1.55; }
  .price-summary li svg { flex: 0 0 auto; margin-top: 3px; color: var(--color-primary); }
  .price-boundaries li svg { flex: 0 0 auto; margin-top: 3px; color: var(--color-foreground-45); }
  .price-note { margin: 0 0 28px; color: var(--color-foreground-55); font-size: 14px; line-height: 1.65; }
  .price-option { margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--color-primary-14); }
  .price-option h4 { margin: 0 0 7px; color: var(--color-foreground-70); font-size: 13px; font-weight: 600; }
  .price-option strong { color: var(--color-primary); font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .price-option p { margin: 7px 0 0; color: var(--color-foreground-55); font-size: 13px; line-height: 1.55; }

  .deliverables-grid { display: grid; gap: 40px; }
  .deliverables-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; align-content: start; }
  .deliverables-list li { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-sm); color: var(--color-foreground-70); font-size: 13.5px; }
  .deliverables-list svg { color: var(--color-primary); }

  .fit-grid { display: grid; gap: 16px; }
  .fit-col { padding: 26px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-sm); background: var(--color-card); }
  .fit-col--poor { border-color: var(--color-primary-8); }
  .fit-col h3 { margin: 0 0 16px; color: var(--color-foreground); font-size: 16px; font-weight: 600; }
  .fit-col ul { display: grid; gap: 11px; margin: 0; padding: 0; list-style: none; }
  .fit-col li { display: flex; align-items: flex-start; gap: 9px; color: var(--color-foreground-55); font-size: 14px; line-height: 1.5; }
  .fit-col svg { flex-shrink: 0; margin-top: 2px; color: var(--color-primary); }
  .fit-col--poor svg { color: var(--color-foreground-35); }

  .related-section { background: rgba(15, 18, 25, 0.45); }
  .related-grid { display: grid; gap: 16px; }
  .related-card { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-sm); background: var(--color-card); color: var(--color-foreground); text-decoration: none; transition: border-color 0.2s ease, transform 0.2s ease; }
  .related-card:hover { border-color: var(--color-primary-35); transform: translateY(-2px); }
  .related-index { color: var(--color-primary); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.14em; }
  .related-card h3 { margin: 0; font-size: 19px; font-weight: 650; letter-spacing: -0.02em; }
  .related-card p { margin: 0; color: var(--color-foreground-55); font-size: 14px; line-height: 1.55; }
  .related-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; color: var(--color-primary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }

  @media (min-width: 768px) {
    .scope-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
    .fit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    .related-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
    .deliverables-grid { grid-template-columns: 0.9fr 1.1fr; gap: 64px; align-items: start; }
    .pricing-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.88fr); gap: 20px; }
  }
  @media (max-width: 560px) {
    .commercial-hero { padding: 104px 0 64px; }
    .commercial-hero--with-diagram { padding-bottom: 44px; }
    .hero-diagram { margin-top: 44px; }
    h1 { font-size: clamp(42px, 14vw, 58px); }
    .commercial-section { padding: 76px 0; }
  }
</style>
