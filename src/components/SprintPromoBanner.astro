---
import Button from './Button.astro';
import IconArrowRight from './IconArrowRight.astro';
import ServiceIllustrationSeoSprint from './ServiceIllustrationSeoSprint.astro';
import { rule } from '../data';
---

<section style="background: #fff; padding: 0 0 5rem">
  <div class="max-w-5xl mx-auto px-6 reveal">
    <div class="sprint-promo-banner" style="margin-top: 1rem; border-radius: 1.25rem; padding: 3rem; display: grid; grid-template-columns: 1fr 1.1fr; gap: 3rem; align-items: center">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem">
          <span style="display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #1560bd">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #1560bd; box-shadow: 0 0 6px rgba(21,96,189,0.6), 0 0 12px rgba(21,96,189,0.3)"></span>
            Nuevo
          </span>
        </div>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0 0 1rem; line-height: 1.15; max-width: 26ch">
          Tu tienda tiene problemas de SEO. ¿Sabes cuáles están frenando su crecimiento?
        </h2>
        <p style="font-size: 0.9375rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0 0 1.5rem; max-width: 44ch">
          Un proyecto de una semana para identificar los problemas, oportunidades y prioridades que afectan el crecimiento orgánico de tu tienda Shopify.
        </p>
        <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem">
          <span style="display: inline-flex; align-items: center; gap: 0.5rem">
            <span style="font-size: 0.95rem; font-weight: 700; color: #1560bd">$500 USD</span>
          </span>
          <span style="font-size: 0.72rem; font-weight: 600; color: #1560bd; background: rgba(21,96,189,0.08); padding: 0.25rem 0.6rem; border-radius: 999px; letter-spacing: 0.02em">Precio de lanzamiento</span>
        </div>
        <Button href="/sprints/shopify-seo-sprint/">
          Ver detalle <IconArrowRight />
        </Button>
      </div>
      <div style="display: flex; justify-content: center">
        <ServiceIllustrationSeoSprint />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .sprint-promo-banner {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(21,96,189,0.10);
  }
  @media (max-width: 767px) {
    .sprint-promo-banner {
      grid-template-columns: 1fr !important;
      padding: 2rem !important;
    }
    .sprint-promo-banner > div:last-child {
      display: none;
    }
  }
</style>
