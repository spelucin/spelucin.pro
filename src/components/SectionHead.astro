---
interface Props {
  id?: string;
  index?: string;
  heading: string;
  highlight?: string;
  intro?: string;
  wide?: boolean;
  flush?: boolean;
  compact?: boolean;
}

const { id, index, heading, highlight, intro, wide = false, flush = false, compact = false } = Astro.props;
const classes = ['section-head', wide && 'section-head--wide', flush && 'section-head--flush', compact && 'section-head--compact']
  .filter(Boolean)
  .join(' ');
---

<div class={classes}>
  {index && <span class="section-index">{index}</span>}
  <h2 id={id}>
    {heading} {highlight && <span class="text-primary">{highlight}</span>}
  </h2>
  {intro && <p class="section-head-intro">{intro}</p>}
</div>

<style>
  .section-head {
    display: grid;
    gap: 18px;
    max-width: 720px;
    margin-bottom: 56px;
  }
  .section-head--wide {
    max-width: 780px;
  }
  .section-head--flush {
    margin-bottom: 0;
  }
  .section-head--compact {
    gap: 14px;
    max-width: 660px;
    margin-bottom: 40px;
  }
  .section-head--compact.section-head--flush { margin-bottom: 0; }

  .section-index {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  h2 {
    margin: 0;
    font-size: var(--text-h2);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.98;
    color: var(--color-foreground);
    text-wrap: balance;
  }
  .section-head--compact h2 {
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.04;
  }

  .section-head-intro {
    max-width: 560px;
    margin: 0;
    color: var(--color-foreground-55);
    font-size: 18px;
    line-height: 1.55;
  }
  .section-head--compact .section-head-intro {
    font-size: 16px;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .section-head--compact { margin-bottom: 30px; }
    .section-head--compact.section-head--flush { margin-bottom: 0; }
    .section-head--compact h2 { font-size: clamp(28px, 8vw, 34px); }
    .section-head--compact .section-head-intro { font-size: 15px; }
  }
</style>
