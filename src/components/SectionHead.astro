---
interface Props {
  id?: string;
  index?: string;
  heading: string;
  highlight?: string;
  intro?: string;
  wide?: boolean;
  flush?: boolean;
}

const { id, index, heading, highlight, intro, wide = false, flush = false } = Astro.props;
const classes = ['section-head', wide && 'section-head--wide', flush && 'section-head--flush']
  .filter(Boolean)
  .join(' ');
---

<div class={classes}>
  {index && <span class="section-index">{index}</span>}
  <h2 id={id}>
    {heading} {highlight && <span class="text-primary">{highlight}</span>}
  </h2>
  {intro && <p class="section-head-intro">{intro}</p>}
</div>

<style>
  .section-head {
    display: grid;
    gap: 14px;
    max-width: 640px;
    margin-bottom: 48px;
  }
  .section-head--wide {
    max-width: 780px;
  }
  .section-head--flush {
    margin-bottom: 0;
  }

  .section-index {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  h2 {
    margin: 0;
    font-size: var(--text-h2);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-foreground);
  }

  .section-head-intro {
    max-width: 560px;
    color: var(--color-foreground-55);
    font-size: 17px;
    line-height: 1.6;
  }
</style>