---
import { Icon } from 'astro-icon/components';
import type { StackLayer } from '../i18n/types';

interface Props {
  layers: StackLayer[];
  caption?: string;
  id?: string;
}

const { layers, caption, id } = Astro.props;
---

<figure class="stack" id={id}>
  {caption && <figcaption class="sr-only">{caption}</figcaption>}
  <span class="stack-rail" aria-hidden="true"></span>
  {layers.map((layer, i) => (
    <div class={`layer${i === layers.length - 1 ? ' layer--last' : ''}`}>
      <div class="layer-head">
        <span class="layer-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="layer-name">{layer.name}</h3>
      </div>
      <ul class="layer-items" role="list">
        {layer.items.map((item) => (
          <li class="tool">
            <Icon name={item.icon} width="16" height="16" aria-hidden="true" />
            <span>{item.name}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
  <span class="stack-flow" aria-hidden="true"></span>
</figure>

<style>
  .stack {
    position: relative;
    margin: 0;
    padding: 4px 0 8px 24px;
  }

  .stack-rail {
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 7px;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-primary-35), var(--color-primary-14));
  }

  .layer {
    position: relative;
    display: grid;
    gap: 12px;
    padding: 18px 0;
  }
  .layer + .layer {
    border-top: 1px solid var(--color-primary-8);
  }

  .layer::before {
    position: absolute;
    top: 20px;
    left: -24px;
    width: 15px;
    height: 1px;
    background: var(--color-primary-20);
    content: '';
  }

  .layer-head {
    display: flex;
    align-items: baseline;
    gap: 9px;
  }

  .layer-index {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--color-primary-35);
  }

  .layer-name {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-55);
  }

  .layer-items {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border: 1px solid var(--color-primary-14);
    border-radius: 10px;
    background: var(--color-primary-4);
    color: var(--color-foreground-55);
    font-size: 14px;
    line-height: 1;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }
  .tool svg {
    color: var(--color-primary);
  }
  .tool:hover {
    border-color: var(--color-primary-35);
    background: var(--color-primary-8);
    color: var(--color-foreground-70);
  }

  @media (min-width: 768px) {
    .stack {
      padding-left: 0;
    }
    .layer {
      grid-template-columns: 190px 1fr;
      gap: 24px;
      align-items: start;
    }
    .layer + .layer {
      border-top: 1px solid var(--color-primary-8);
    }
    .layer::before {
      top: 22px;
      left: -14px;
    }
    .layer-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }
</style>