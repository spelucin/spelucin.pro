---
import { Icon } from 'astro-icon/components';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
---

<section class="problem-section">
  <div class="max-w-5xl mx-auto px-6 reveal">
    <div class="problem-section-head">
      <div class="problem-section-marker" aria-hidden="true"><Icon name="ph:warning-circle" width={22} height={22} /></div>
      <div class="problem-section-label">El problema</div>
      <div class="problem-section-rule" />
    </div>
    <div class="problem-section-content">
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
  </div>
</section>

<style is="global">
  .problem-section { padding: 7rem 0; background: var(--color-primary-3); }
  .problem-section-head { display: flex; align-items: center; gap: 0.85rem; }
  .problem-section-marker { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 1px solid var(--color-primary-35); border-radius: var(--radius-sm); background: var(--color-primary-8); color: var(--color-primary); }
  .problem-section-label { color: var(--color-primary); font: 600 0.7rem/1.2 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .problem-section-rule { flex: 1; height: 1px; background: var(--color-border); }
  .problem-section-content { max-width: 58rem; padding: 3.25rem 0 0 3.35rem; }
  .problem-section h2 { max-width: 18ch; margin: 0; color: var(--color-foreground); font-size: clamp(2rem, 4.5vw, 3.5rem); font-weight: 700; letter-spacing: -0.06em; line-height: 1.02; text-wrap: balance; }
  .problem-section p { max-width: 62ch; margin: 2rem 0 0; padding-left: 1.25rem; border-left: 1px solid var(--color-primary-35); color: var(--color-prose-muted); font-size: 1rem; line-height: 1.8; }
  @media (max-width: 767px) { .problem-section { padding: 5rem 0; } .problem-section-content { padding: 2.5rem 0 0; } .problem-section h2 { font-size: clamp(2rem, 10vw, 3rem); } }
</style>
