---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import BookCall from './BookCall.astro';
import type { Translations } from '../i18n/types';
import { caseImages } from '../data/caseImages';
import { localizeHref } from '../utils/lang';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
const clientLogoMap: Record<string, { src: string; height: number }> = {
  torices: { src: '/assets/torices-client-logo.svg', height: 22 },
  notebook: { src: '/assets/notebook-client-logo.svg', height: 28 },
  owlbox: { src: '/assets/owlbox-client-logo.svg', height: 22 },
};
---

<SiteHeader t={t} />

<main id="main-content">
  <section class="page-hero reveal">
    <div class="container-site">
      <p class="hero-eyebrow">{t.lang === 'es' ? 'Casos de Estudio' : 'Case Studies'}</p>
      <h1 class="hero-title">{t.work.hero.heading} <span class="text-primary">{t.work.hero.highlight}</span></h1>
      <p class="hero-intro">{t.work.hero.sub}</p>
    </div>
  </section>

  <section class="cases section-block reveal">
    <div class="container-site">
      <div class="case-list">
        {t.work.cases.map((c) => (
          <a
            class="case-card"
            href={localizeHref(`/case-studies/${c.slug}`, t.lang)}
            data-case-study
            data-case-study-slug={c.slug}
            data-case-study-name={c.client}
            data-case-study-industry={c.sector}
          >
            <div class="case-media">
              <Image
                src={caseImages[c.slug as keyof typeof caseImages][0]}
                alt={c.alt}
                format="avif"
                widths={[480, 720]}
                sizes="(min-width: 768px) 340px, 92vw"
                loading="lazy"
              />
            </div>
            <div class="case-body">
              <p class="case-meta">{c.sector} · {c.year}</p>
              <h2 class="case-title">{c.title}</h2>
              <p class="case-summary">{c.summary}</p>
              <div class="case-footer">
                {clientLogoMap[c.slug] ? (
                  <img
                    src={clientLogoMap[c.slug].src}
                    alt={c.client}
                    class="case-logo"
                    style={`--logo-h: ${clientLogoMap[c.slug].height}px`}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="case-client">{c.client}</span>
                )}
                <span class="case-link">
                  <span>{t.lang === 'es' ? 'Ver caso completo' : 'View full case'}</span>
                  <Icon name="tabler:arrow-up-right" width="16" height="16" aria-hidden="true" />
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <BookCall t={t} location="case-studies" />
</main>

<SiteFooter t={t} />

<script>
  import '../scripts/reveal';
</script>

<style>
  .case-list { display: grid; gap: 32px; }

  .case-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-md);
    background: var(--color-card);
    color: var(--color-foreground);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .case-card:hover {
    border-color: var(--color-primary-35);
    transform: translateY(-3px);
    box-shadow: 0 20px 48px rgba(4, 8, 16, 0.45);
  }

  .case-media {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #080b11;
  }
  .case-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .case-card:hover .case-media img { transform: scale(1.035); }

  .case-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 14px;
    padding: 26px 28px;
  }
  .case-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-foreground-55);
  }
  .case-title {
    margin: 0;
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--color-foreground);
  }
  .case-summary {
    margin: 0;
    color: var(--color-foreground-55);
    font-size: 14.5px;
    line-height: 1.6;
  }
  .case-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--color-primary-8);
  }
  .case-logo {
    display: block;
    width: auto;
    height: var(--logo-h, 22px);
    filter: grayscale(1);
    opacity: 0.55;
    transition: opacity 0.25s ease, filter 0.25s ease;
  }
  .case-card:hover .case-logo {
    opacity: 0.9;
    filter: grayscale(0.2);
  }
  .case-client {
    color: var(--color-foreground);
    font-size: 14px;
    font-weight: 600;
  }
  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 600;
    transition: transform 0.2s ease;
  }
  .case-card:hover .case-link { transform: translateX(4px); }

  @media (min-width: 768px) {
    .case-card {
      display: grid;
      grid-template-columns: 340px 1fr;
      align-items: stretch;
    }
    .case-media {
      height: 100%;
      aspect-ratio: auto;
      border-right: 1px solid var(--color-primary-14);
    }
    .case-body {
      padding: 28px 32px;
      justify-content: center;
    }
  }
</style>
