---
import type { Translations } from '../i18n/types';
import { site } from '../data/site';
import { localizeHref } from '../utils/lang';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
const contactLinks = [
  { href: `mailto:${site.email}`, label: site.email, tag: 'lead' },
  { href: site.linkedin, label: 'LinkedIn' },
  { href: site.github, label: 'GitHub' },
  { href: site.cal, label: 'Cal.com', tag: 'calendar' },
];
const exploreLinks = t.siteNav.map((item) => ({
  label: item.label,
  href: localizeHref(item.href, t.lang),
}));
---

<footer class="site-footer">
  <div class="container-site">
    <div class="footer-main">
      <div class="footer-brand">
        <p class="footer-tagline">{t.footer.tagline}</p>
        <span class="footer-rights">{t.footer.rights}</span>
      </div>

      <nav class="footer-col" aria-label={t.footer.exploreNav}>
        <h2 class="footer-heading">{t.footer.exploreNav}</h2>
        {exploreLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>

      <nav class="footer-col" aria-label={t.footer.contactNav}>
        <h2 class="footer-heading">{t.footer.contactNav}</h2>
        {contactLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener' : undefined}
            data-cal-link={link.tag === 'calendar' ? 'spelucin' : undefined}
            data-cal-namespace={link.tag === 'calendar' ? 'spelucin' : undefined}
            data-calendar={link.tag === 'calendar' ? true : undefined}
            data-calendar-location={link.tag === 'calendar' ? 'footer' : undefined}
            data-lead={link.tag === 'lead' ? true : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="footer-meta">
      <span>{t.footer.rights}</span>
      <nav class="footer-legal" aria-label={t.footer.legalNav}>
        <a href="/privacidad">{t.footer.privacy}</a>
        <a href="/terminos">{t.footer.terms}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-primary-8);
    padding: 48px 0 36px;
  }

  .footer-main {
    display: grid;
    gap: 32px;
    padding-bottom: 36px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .footer-tagline {
    max-width: 380px;
    color: var(--color-foreground-55);
    font-size: 14px;
    line-height: 1.6;
  }
  .footer-rights {
    display: none;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .footer-heading {
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary-35);
  }
  .footer-col a {
    color: var(--color-foreground-65);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .footer-col a:hover { color: var(--color-primary); }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--color-primary-8);
    color: var(--color-foreground-55);
    font-size: 13px;
  }
  .footer-legal {
    display: flex;
    gap: 20px;
  }
  .footer-legal a {
    color: var(--color-foreground-55);
    transition: color 0.2s ease;
  }
  .footer-legal a:hover { color: var(--color-primary); }

  @media (min-width: 768px) {
    .footer-main {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 40px;
    }
    .footer-rights {
      display: block;
      color: var(--color-foreground-55);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.04em;
    }
    .footer-meta span {
      display: none;
    }
  }
</style>