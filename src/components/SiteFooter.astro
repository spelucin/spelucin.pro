---
import type { Translations } from '../i18n/types';
import { site } from '../data/site';
import { localizeHref } from '../utils/lang';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
const contactLinks = [
  { href: `mailto:${site.email}`, label: site.email, tag: 'lead' },
  { href: site.linkedin, label: 'LinkedIn', external: true },
  { href: site.github, label: 'GitHub', external: true },
  { href: site.cal, label: 'Cal.com', tag: 'calendar' },
];
const exploreLinks = t.siteNav.map((item) => ({
  label: item.label,
  href: localizeHref(item.href, t.lang),
}));
---

<footer class="site-footer">
  <div class="container-site">
    <div class="footer-main">
      <div class="footer-brand">
        <img class="footer-logo" src="/assets/logo.svg" alt="" width="22" height="22" loading="lazy" aria-hidden="true" />
        <p class="footer-tagline">{t.footer.tagline}</p>
      </div>

      <nav class="footer-links" aria-label={t.footer.exploreNav}>
        {exploreLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>

      <nav class="footer-links footer-contacts" aria-label={t.footer.contactNav}>
        {contactLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener' : undefined}
            data-cal-modal={link.tag === 'calendar' ? true : undefined}
            data-calendar={link.tag === 'calendar' ? true : undefined}
            data-calendar-location={link.tag === 'calendar' ? 'footer' : undefined}
            data-lead={link.tag === 'lead' ? true : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="footer-meta">
      <span>{t.footer.rights}</span>
      <nav class="footer-legal" aria-label={t.footer.legalNav}>
        <a href="/privacidad">{t.footer.privacy}</a>
        <a href="/terminos">{t.footer.terms}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    border-top: 1px solid var(--color-primary-20);
    background: rgba(8, 11, 17, 0.72);
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding: 40px 0 32px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .footer-logo {
    display: block;
    width: 24px;
    height: 24px;
    opacity: 0.9;
    filter: none;
    flex-shrink: 0;
  }
  .footer-tagline {
    max-width: 520px;
    margin: 0;
    color: var(--color-foreground-55);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    line-height: 1.5;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 22px;
  }
  .footer-links a {
    color: var(--color-foreground-70);
    font-size: 13.5px;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .footer-links a:hover { color: var(--color-primary); }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0 20px;
    border-top: 1px solid var(--color-primary-14);
  }
  .footer-meta span {
    color: var(--color-foreground-45);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }
  .footer-legal {
    display: flex;
    gap: 20px;
  }
  .footer-legal a {
    color: var(--color-foreground-55);
    font-size: 12.5px;
    transition: color 0.2s ease;
  }
  .footer-legal a:hover { color: var(--color-primary); }

  @media (max-width: 640px) {
    .footer-main {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-links {
      justify-content: flex-start;
    }
    .footer-links.footer-contacts {
      justify-content: flex-start;
      margin-top: 16px;
    }
  }
</style>