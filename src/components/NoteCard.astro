---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../lib/readingTime';
import { formatDate } from '../lib/formatDate';
import { Icon } from 'astro-icon/components';

interface Props {
  entry: CollectionEntry<'notas'>;
}

const { entry } = Astro.props;
const { data } = entry;
const minutes = readingTime(entry.body ?? '');
---

<article class="card card-hover p-7 md:p-8 flex flex-col h-full">
  <div class="flex items-center gap-4 mb-5">
    <span class="font-mono text-[11px] tracking-[0.14em] uppercase text-foreground-55">{formatDate(data.date)}</span>
    <span class="w-1 h-1 rounded-full bg-primary-35"></span>
    <span class="font-mono text-[11px] tracking-[0.14em] uppercase text-primary">{data.category}</span>
  </div>

  <h3 class="text-[20px] md:text-[22px] font-semibold tracking-tight leading-[1.3]">
    <a href={`/notas/${entry.id}/`} class="hover:text-primary transition-colors">{data.title}</a>
  </h3>
  <p class="mt-3 text-[15px] leading-[1.6] text-muted-foreground flex-1">{data.description}</p>

  <div class="flex items-center justify-between gap-4 mt-7 pt-5 border-t border-primary-10">
    <span class="font-mono text-[11px] text-foreground-55">{minutes} min de lectura</span>
    <a href={`/notas/${entry.id}/`} class="case-card-link" aria-label={`Leer nota: ${data.title}`}>
      Leer
      <Icon name="tabler:arrow-right" width="15" height="15" aria-hidden="true" />
    </a>
  </div>
</article>
