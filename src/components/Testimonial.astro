---
interface Props {
  quote: string;
  name: string;
  role: string;
  company?: string;
  avatarChar?: string;
}

const { quote, name, role, company, avatarChar = name.charAt(0) } = Astro.props;
---

<figure class="editorial-testimonial reveal">
  <blockquote class="testimonial-blockquote">
    <p>&ldquo;{quote}&rdquo;</p>
  </blockquote>
  <figcaption class="testimonial-caption">
    <div class="testimonial-avatar" aria-hidden="true">
      <span>{avatarChar}</span>
    </div>
    <div class="testimonial-meta">
      <div class="testimonial-name">{name}</div>
      <div class="testimonial-role">
        {role}{company ? ` · ${company}` : ''}
      </div>
    </div>
  </figcaption>
</figure>

<style is:global>
  .editorial-testimonial {
    margin: 2.5rem 0;
    padding: 2rem;
    background: var(--color-sidebar-bg);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 0.75rem 0.75rem 0;
  }
  .testimonial-blockquote p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-prose);
    font-style: italic;
    margin: 0 0 1.25rem 0;
  }
  .testimonial-caption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .testimonial-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 0.8125rem;
    flex-shrink: 0;
  }
  html.dark .testimonial-avatar {
    color: var(--color-background);
  }
  .testimonial-meta {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .testimonial-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.2;
  }
  .testimonial-role {
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
    font-weight: 500;
    line-height: 1.2;
  }
</style>
