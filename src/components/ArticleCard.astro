---
interface Props {
  title: string;
  description: string;
  summary?: string;
  pubDate: Date;
  category: string;
  slug: string;
  readingTime?: string;
  featured?: boolean;
  tags?: string[];
}

const { title, description, summary, pubDate, category, slug, readingTime, featured, tags } = Astro.props;

const dateStr = pubDate.toLocaleDateString('es-AR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="article-card">
  <a href={`/escritura/${slug}/`} class="article-card-link" tabindex="-1" aria-hidden="true"></a>
  <div class="article-card-meta">
    <time datetime={pubDate.toISOString()}>{dateStr}</time>
    <a href={`/escritura/?categoria=${encodeURIComponent(category)}`} class="article-category">{category}</a>
    {readingTime && <span class="article-reading-time">{readingTime}</span>}
    {featured && <span class="article-badge">Destacado</span>}
  </div>
  <h3 class="article-card-title">
    <a href={`/escritura/${slug}/`}>{title}</a>
  </h3>
  <p class="article-card-description">{summary || description}</p>
  {tags && tags.length > 0 && (
    <div class="article-tags">
      {tags.slice(0, 3).map(tag => (
        <a href={`/escritura/?tag=${encodeURIComponent(tag)}`} class="article-tag">#{tag}</a>
      ))}
    </div>
  )}
</article>

<style is:global>
  .article-card {
    position: relative;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: opacity 0.15s;
  }
  .article-card:first-child {
    border-top: 1px solid var(--color-border);
  }
  .article-card:hover {
    opacity: 0.82;
  }

  .article-card-link {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .article-card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .article-card-meta time {
    font-size: 0.6875rem;
    color: var(--color-muted-foreground);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .article-category {
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    position: relative;
    z-index: 1;
  }
  .article-category:hover { text-decoration: underline; }

  .article-reading-time {
    font-size: 0.625rem;
    color: var(--color-muted-foreground);
    font-weight: 500;
  }

  .article-badge {
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgba(21,96,189,0.1);
    color: var(--color-primary);
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
  }

  .article-card-title {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-foreground);
    margin: 0 0 0.35rem;
    line-height: 1.3;
  }
  .article-card-title a {
    color: inherit;
    text-decoration: none;
    position: relative;
    z-index: 1;
  }
  .article-card-title a:hover { color: var(--color-primary); }

  .article-card-description {
    font-size: 0.875rem;
    color: var(--color-prose-muted);
    line-height: 1.65;
    margin: 0 0 0.625rem;
    max-width: 66ch;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    position: relative;
    z-index: 1;
  }

  .article-tag {
    font-size: 0.6875rem;
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color 0.15s;
  }
  .article-tag:hover { color: var(--color-primary); }
</style>
