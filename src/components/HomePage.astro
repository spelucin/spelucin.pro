<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll('[data-project-slider]').forEach((slider) => {
    const viewport = slider.querySelector('[data-project-slider-viewport]');
    const prev = slider.querySelector('[data-project-slider-prev]');
    const next = slider.querySelector('[data-project-slider-next]');
    const dots = [...slider.querySelectorAll('[data-project-slider-dot]')];
    const total = slider.querySelector('[data-project-slider-track]').children.length;

    if (reduced) {
      slider.querySelectorAll('.project-slider-image').forEach((img) => img.classList.add('is-loaded'));
    } else {
      slider.querySelectorAll('.project-slider-image').forEach((img) => {
        if (img.complete) img.classList.add('is-loaded');
        else img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
      });
    }

    if (total <= 1) {
      slider.classList.add('is-single');
      return;
    }

    const render = () => {
      const i = Math.min(Math.max(Math.round(viewport.scrollLeft / viewport.clientWidth), 0), total - 1);
      prev.disabled = i === 0;
      next.disabled = i === total - 1;
      dots.forEach((dot, d) => {
        const active = d === i;
        dot.classList.toggle('is-active', active);
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };
    const go = (i) => {
      viewport.scrollTo({ left: i * viewport.clientWidth, behavior: reduced ? 'auto' : 'smooth' });
    };

    prev.addEventListener('click', () => go(Math.round(viewport.scrollLeft / viewport.clientWidth) - 1));
    next.addEventListener('click', () => go(Math.round(viewport.scrollLeft / viewport.clientWidth) + 1));
    dots.forEach((dot, d) => dot.addEventListener('click', () => go(d)));
    viewport.addEventListener('scroll', render, { passive: true });
    window.addEventListener('resize', render);
    render();
  });
</script>
