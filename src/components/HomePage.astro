---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import avatar from '../assets/alex-spelucin-avatar.jpg';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHead from './SectionHead.astro';
import StatsBlocks from './StatsBlocks.astro';
import BookCall from './BookCall.astro';
import Faq from './Faq.astro';
import OfferGrid from './OfferGrid.astro';
import ServiceDiagram from './ServiceDiagram.astro';
import type { Translations } from '../i18n/types';
import { commercialEs } from '../i18n/commercial-es';
import { commercialEn } from '../i18n/commercial-en';
import { site } from '../data/site';
import { caseImages } from '../data/caseImages';
import { localizeHref } from '../utils/lang';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;
const commercial = t.lang === 'es' ? commercialEs : commercialEn;
const offerCards = commercial.servicesHub.cards;
const offerLinkLabel = t.lang === 'es' ? 'Ver servicio' : 'View service';

const featuredCases = t.home.proof.featured.map((slug) => {
  const study = t.caseStudies[slug];
  const workCase = t.work.cases.find((item) => item.slug === slug);
  return {
    ...study,
    summary: workCase?.summary ?? study.context[0],
  };
});
---

<SiteHeader t={t} />

<main id="main-content">
  <section class="hero">
    <div class="container-site">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-mark">ECOMMERCE ANALYTICS / DATA SYSTEMS</p>
          <h1>{t.home.hero.headline} <span class="text-primary">{t.home.hero.highlight}</span></h1>
          <p class="hero-sub">{t.home.hero.sub}</p>
          <div class="hero-actions">
            <a
              class="btn btn-primary"
              href={site.cal}
              data-cal-modal
              data-calendar
              data-calendar-location="hero"
              data-cta
              data-cta-text={t.ctaLabel}
              data-cta-location="hero"
            >
              {t.ctaLabel}
              <Icon name="tabler:arrow-up-right" width="16" height="16" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
      <div class="hero-diagram">
        <ServiceDiagram variant="home" lang={t.lang} />
      </div>
    </div>
  </section>

  <section class="problem home-section reveal">
    <div class="container-site">
      <SectionHead
        heading={t.home.problem.heading}
        highlight={t.home.problem.highlight}
        intro={t.home.problem.intro}
      />
      <div class="problem-list">
        {t.home.problem.items.map((item, i) => (
          <article class="problem-row">
            <span class="row-number">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="offers home-section reveal">
    <div class="container-site">
      <SectionHead
        heading={t.home.offers.heading}
        highlight={t.home.offers.highlight}
        intro={t.home.offers.intro}
      />
      <OfferGrid
        cards={offerCards}
        lang={t.lang}
        linkLabel={offerLinkLabel}
        location="home-offers"
      />
    </div>
  </section>

  <section class="process home-section reveal">
    <div class="container-site">
      <SectionHead
        heading={t.home.process.heading}
        highlight={t.home.process.highlight}
        intro={t.home.process.intro}
      />

      <ol class="process-list" role="list">
        {t.home.process.weeks.map((week, i) => (
          <li class="process-row">
            <span class="process-index">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{week.title}</h3>
              <p>{week.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="process-include">
        <h3>{t.home.process.includeHeading}</h3>
        <ul class="chip-list" role="list">
          {t.home.process.include.map((item) => (
            <li><Icon name="tabler:check" width="14" height="14" aria-hidden="true" />{item}</li>
          ))}
        </ul>
      </div>

      <div class="fit-grid">
        <div class="fit-col">
          <h3>{t.home.process.fit.goodHeading}</h3>
          <ul role="list">
            {t.home.process.fit.good.map((item) => (
              <li><Icon name="tabler:check" width="14" height="14" aria-hidden="true" />{item}</li>
            ))}
          </ul>
        </div>
        <div class="fit-col fit-col--poor">
          <h3>{t.home.process.fit.poorHeading}</h3>
          <ul role="list">
            {t.home.process.fit.poor.map((item) => (
              <li><Icon name="tabler:x" width="14" height="14" aria-hidden="true" />{item}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="section-cta">
        <a
          class="btn btn-primary btn-lg"
          href={site.cal}
          data-cal-modal
          data-calendar
          data-calendar-location="home-process"
          data-cta
          data-cta-text={t.ctaLabel}
          data-cta-location="home-process"
        >
          {t.ctaLabel}
          <Icon name="tabler:arrow-up-right" width="18" height="18" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="proof home-section reveal">
    <div class="container-site">
      <SectionHead
        wide
        heading={t.home.proof.heading}
        highlight={t.home.proof.highlight}
        intro={t.home.proof.intro}
      />

      <StatsBlocks stats={t.home.proof.stats} />

      <div class="case-list">
        {featuredCases.map((c) => (
          <a
            class="case-card"
            href={localizeHref(`/case-studies/${c.slug}`, t.lang)}
            data-case-study
            data-case-study-slug={c.slug}
            data-case-study-name={c.client}
            data-case-study-industry={c.sector}
          >
            <div class="case-media">
              <Image
                src={caseImages[c.slug as keyof typeof caseImages][0]}
                alt={c.alt}
                format="avif"
                widths={[400, 700]}
                sizes="(min-width: 768px) 340px, 92vw"
                loading="lazy"
              />
            </div>
            <div class="case-body">
              <p class="case-meta">{c.sector} · {c.year}</p>
              <h3 class="case-title">{c.title}</h3>
              <p class="case-summary">{c.summary}</p>
              <div class="case-footer">
                <img src="/assets/owlbox-client-logo.svg" alt={c.client} class="case-logo" loading="lazy" decoding="async" />
                <span class="case-link">
                  <span>{t.home.proof.caseCta}</span>
                  <Icon name="tabler:arrow-up-right" width="16" height="16" aria-hidden="true" />
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="section-cta">
        <a
          class="btn btn-secondary btn-lg"
          href={localizeHref('/case-studies', t.lang)}
          data-cta
          data-cta-text={t.ctaSeeWork}
          data-cta-location="proof"
        >
          {t.ctaSeeWork}
          <Icon name="tabler:arrow-right" width="18" height="18" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="credibility home-section reveal" id="sobre-mi">
    <div class="container-site credibility-grid">
      <div class="credibility-copy">
        <Image class="avatar" src={avatar} alt={t.about.portraitAlt} width={88} height={88} format="webp" loading="lazy" />
        <p class="section-kicker">{t.about.kicker}</p>
        <h2>{t.about.heading}</h2>
        {t.about.paragraphs.slice(0, 1).map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="credibility-side">
        <dl>
          {t.about.meta.map((item) => (
            <div><dt>{item.label}</dt><dd>{item.value}</dd></div>
          ))}
        </dl>
        <div class="stack-note">
          <span>{t.stack.heading} {t.stack.highlight}</span>
          <p>{t.stack.intro}</p>
          <ul class="stack-pills" role="list">
            {t.stack.layers.flatMap((layer) => layer.items).slice(0, 8).map((item) => (
              <li>{item.icon && <Icon name={item.icon} width="14" height="14" aria-hidden="true" />}{item.name}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq
    sectionClass="home-section"
    heading={t.home.faq.heading}
    highlight={t.home.faq.highlight}
    items={t.home.faq.items}
  />

  <BookCall t={t} location="home" />
</main>

<SiteFooter t={t} />

<script>
  import '../scripts/reveal';
</script>

<style>
  .hero {
    position: relative;
    padding: 128px 0 96px;
    border-bottom: 1px solid var(--color-primary-20);
    overflow: hidden;
  }
  .hero::before {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgba(96, 165, 250, 0.08) 1px, transparent 1px);
    background-size: 25% 100%;
    opacity: 0.5;
    -webkit-mask-image: linear-gradient(to right, #000, transparent 80%);
    mask-image: linear-gradient(to right, #000, transparent 80%);
    pointer-events: none;
    content: '';
  }
  .hero-inner { position: relative; }
  .hero-copy { display: grid; justify-items: start; gap: 22px; max-width: 640px; }
  .hero-mark { margin: 0; color: var(--color-primary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; }
  .hero-copy h1 { margin: 0; max-width: 13ch; font-size: clamp(40px, 5.2vw, 66px); font-weight: 700; letter-spacing: -0.06em; line-height: 1.02; text-wrap: balance; }
  .hero-sub { max-width: 480px; margin: 0; color: var(--color-foreground-70); font-size: 17px; line-height: 1.65; text-wrap: pretty; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }

  .hero-diagram { position: relative; margin-top: clamp(48px, 6vw, 72px); }

  .home-section { padding: clamp(88px, 9vw, 120px) 0; }
  .home-section + .home-section { border-top: 1px solid var(--color-primary-14); }

  .problem-list { border-top: 1px solid var(--color-primary-14); }
  .problem-row { display: grid; grid-template-columns: 44px 1fr; gap: 18px; align-items: start; padding: 32px 0; border-bottom: 1px solid var(--color-primary-14); }
  .row-number { color: var(--color-primary); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; }
  .problem-row h3 { margin: 0; color: var(--color-foreground); font-size: 22px; font-weight: 650; letter-spacing: -0.02em; }
  .problem-row p { max-width: 58ch; margin: 8px 0 0; color: var(--color-foreground-55); font-size: 15px; line-height: 1.6; }

  .process-list { margin: 0; padding: 0; list-style: none; display: grid; border-top: 1px solid var(--color-primary-14); border-bottom: 1px solid var(--color-primary-14); }
  .process-row { position: relative; display: grid; grid-template-columns: 56px 1fr; gap: 20px; align-items: start; padding: 28px 0; }
  .process-row::before { content: ''; position: absolute; left: 28px; top: 0; bottom: 0; width: 1px; background: var(--color-primary-14); }
  .process-row:first-child::before { top: 50%; }
  .process-row:last-child::before { bottom: 50%; }
  .process-index { position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: center; justify-self: center; width: 42px; height: 42px; margin-top: 2px; border: 1px solid var(--color-primary-28); border-radius: var(--radius-sm); background: var(--color-card); color: var(--color-primary); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; }
  .process-row h3 { margin: 0; color: var(--color-foreground); font-size: 22px; font-weight: 650; letter-spacing: -0.02em; }
  .process-row p { max-width: 58ch; margin: 8px 0 0; color: var(--color-foreground-55); font-size: 15px; line-height: 1.6; }

  .process-include { margin-top: 56px; }
  .process-include h3 { margin: 0 0 18px; color: var(--color-foreground); font-size: 15px; font-weight: 600; }
  .chip-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .chip-list li { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-sm); color: var(--color-foreground-70); font-size: 13.5px; }
  .chip-list svg { color: var(--color-primary); }

  .fit-grid { display: grid; gap: 16px; margin-top: 56px; }
  .fit-col { padding: 26px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-sm); background: var(--color-card); }
  .fit-col--poor { border-color: var(--color-primary-8); }
  .fit-col h3 { margin: 0 0 16px; color: var(--color-foreground); font-size: 16px; font-weight: 600; }
  .fit-col ul { display: grid; gap: 11px; margin: 0; padding: 0; list-style: none; }
  .fit-col li { display: flex; align-items: flex-start; gap: 9px; color: var(--color-foreground-55); font-size: 14px; line-height: 1.5; }
  .fit-col svg { flex-shrink: 0; margin-top: 2px; color: var(--color-primary); }
  .fit-col--poor svg { color: var(--color-foreground-35); }

  .case-list { display: flex; flex-direction: column; gap: 20px; margin-top: 56px; }
  .case-card { position: relative; display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--color-primary-14); border-radius: var(--radius-sm); background: rgba(9, 12, 18, 0.72); color: var(--color-foreground); text-decoration: none; transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease; }
  .case-card:hover { border-color: var(--color-primary-35); transform: translateY(-2px); box-shadow: var(--shadow-hover); }
  .case-card:focus-visible { border-color: var(--color-primary-35); box-shadow: var(--shadow-hover); }
  .case-media { position: relative; overflow: hidden; width: 100%; aspect-ratio: 16 / 9; background: #080b11; }
  .case-media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .case-card:hover .case-media :global(img) { transform: scale(1.035); }
  .case-body { display: flex; flex-direction: column; flex-grow: 1; justify-content: center; gap: 14px; padding: 24px 26px; }
  .case-meta { margin: 0; color: var(--color-foreground-55); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; }
  .case-logo { display: block; width: auto; height: 20px; filter: grayscale(1); opacity: 0.5; transition: opacity 0.25s ease, filter 0.25s ease; }
  .case-card:hover .case-logo { opacity: 0.85; filter: grayscale(0.2); }
  .case-title { margin: 0; font-size: clamp(18px, 2.2vw, 22px); font-weight: 650; letter-spacing: -0.025em; line-height: 1.25; }
  .case-summary { margin: 0; color: var(--color-foreground-55); font-size: 14.5px; line-height: 1.6; }
  .case-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 14px; border-top: 1px solid var(--color-primary-8); }
  .case-link { display: inline-flex; align-items: center; gap: 6px; color: var(--color-primary); font-size: 14px; font-weight: 600; transition: transform 0.2s ease; }
  .case-card:hover .case-link { transform: translateX(4px); }
  .section-cta { display: flex; justify-content: center; margin-top: 44px; }
  .btn-lg { padding: 14px 28px; font-size: 15px; }

  .credibility { border-top: 1px solid var(--color-primary-14); }
  .credibility-grid { display: grid; gap: 64px; }
  .credibility-copy { max-width: 580px; }
  .avatar { display: block; width: 88px; height: 88px; margin-bottom: 28px; border: 1px solid var(--color-primary-35); border-radius: var(--radius-sm); object-fit: cover; }
  .credibility .section-kicker { margin: 0 0 14px; }
  .credibility h2 { max-width: 17ch; margin: 0 0 20px; font-size: var(--text-h2); font-weight: 650; letter-spacing: -0.04em; line-height: 1.08; }
  .credibility-copy > p:last-child { max-width: 58ch; margin: 0; color: var(--color-foreground-55); font-size: 18px; line-height: 1.65; }
  .credibility-side dl { display: grid; gap: 0; margin: 0; }
  .credibility-side dl div { display: flex; justify-content: space-between; gap: 20px; padding: 16px 0; border-top: 1px solid var(--color-primary-14); }
  .credibility-side dt { color: var(--color-foreground-55); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; }
  .credibility-side dd { margin: 0; color: var(--color-foreground-70); font-size: 14px; text-align: right; }
  .stack-note { margin-top: 52px; padding-top: 22px; border-top: 1px solid var(--color-primary-14); }
  .stack-note > span { color: var(--color-foreground); font-size: 18px; font-weight: 600; }
  .stack-note p { margin: 10px 0 18px; color: var(--color-foreground-55); font-size: 14px; line-height: 1.55; }
  .stack-pills { display: flex; flex-wrap: wrap; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .stack-pills li { display: inline-flex; align-items: center; gap: 7px; padding: 5px 9px; border: 1px solid var(--color-primary-14); border-radius: var(--radius-sm); color: var(--color-foreground-55); font-family: var(--font-mono); font-size: 10px; }
  .stack-pills svg { color: var(--color-foreground-35); }

  @media (min-width: 700px) {
    .credibility-grid { grid-template-columns: 1fr 0.85fr; gap: 96px; }
  }
  @media (min-width: 768px) {
    .case-card { display: grid; grid-template-columns: 340px 1fr; align-items: stretch; }
    .case-media { height: 100%; aspect-ratio: auto; border-right: 1px solid var(--color-primary-14); }
    .case-body { padding: 28px 32px; }
  }
  @media (min-width: 900px) {
    .fit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  }
  @media (max-width: 560px) {
    .hero { padding: 104px 0 64px; }
    .hero-diagram { margin-top: 40px; }
    .hero-copy h1 { font-size: clamp(44px, 15vw, 60px); }
    .home-section { padding: 76px 0; }
  }
</style>
