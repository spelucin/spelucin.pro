---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import dashboardHero from '../assets/dashboard-hero.jpg';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import SectionHead from './SectionHead.astro';
import StatsBlocks from './StatsBlocks.astro';
import StackDiagram from './StackDiagram.astro';
import BookCall from './BookCall.astro';
import type { Translations } from '../i18n/types';
import { site } from '../data/site';
import { caseImages } from '../data/caseImages';
import { localizeHref } from '../utils/lang';

interface Props {
  t: Translations;
}

const { t }: Props = Astro.props;

const clientLogos: { src: string; alt: string; small?: boolean }[] = [
  { src: '/assets/notebook-client-logo.svg', alt: 'Notebook Agency' },
  { src: '/assets/torices-client-logo.svg', alt: 'Torices' },
  { src: '/assets/owlbox-client-logo.svg', alt: 'Owlbox', small: true },
  { src: '/assets/picnic-client-logo.svg', alt: 'Picnic' },
];

const featuredCases = t.home.proof.featured.map((slug) => t.caseStudies[slug]);
---

<SiteHeader t={t} />

<main id="main-content">
  <section class="hero">
    <div class="dot-grid-hero hero-texture" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container-site hero-grid">
      <div class="hero-copy">
        <span class="badge">{t.home.hero.badge}</span>
        <h1>
          {t.home.hero.headline} <span class="text-primary">{t.home.hero.highlight}</span>
        </h1>
        <p class="hero-sub">{t.home.hero.sub}</p>
        <div class="hero-actions">
          <a
            class="btn btn-primary"
            href={localizeHref('/work', t.lang)}
            data-cta
            data-cta-text={t.ctaSeeWork}
            data-cta-location="hero"
          >
            {t.home.hero.ctaSecondary}
            <Icon name="tabler:arrow-right" width="16" height="16" aria-hidden="true" />
          </a>
          <a
            class="btn btn-secondary"
            href={site.cal}
            target="_blank"
            rel="noopener"
            data-cal-link="spelucin"
            data-cal-namespace="spelucin"
            data-calendar
            data-calendar-location="hero"
            data-cta
            data-cta-text={t.ctaLabel}
            data-cta-location="hero"
          >
            <Icon name="tabler:calendar" width="16" height="16" aria-hidden="true" />
            {t.ctaLabel}
          </a>
        </div>
      </div>

      <figure class="hero-dashboard">
        <div class="hero-dashboard-frame">
          <Image
            src={dashboardHero}
            alt={t.home.hero.visualAlt}
            format="avif"
            widths={[480, 640, 800]}
            sizes="(min-width: 1024px) 440px, (min-width: 768px) 460px, 90vw"
          />
        </div>
        <figcaption class="sr-only">{t.home.hero.visualAlt}</figcaption>
      </figure>
    </div>
  </section>

  <section class="trust" aria-label={t.home.trust.label}>
    <div class="container-site trust-inner">
      <p class="trust-label">{t.home.trust.label}</p>
      <ul class="trust-logos" role="list">
        {clientLogos.map((logo) => (
          <li class:list={['trust-logo', logo.small && 'trust-logo--small']}>
            <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="problem section-block reveal">
    <div class="container-site">
      <SectionHead
        index={t.home.problem.index}
        heading={t.home.problem.heading}
        highlight={t.home.problem.highlight}
        intro={t.home.problem.intro}
      />
      <ul class="pain-list" role="list">
        {t.home.problem.items.map((item) => (
          <li class="pain-card">
            <span class="pain-title">{item.title}</span>
            <span class="pain-text">{item.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="service section-block reveal">
    <div class="container-site">
      <SectionHead
        index={t.home.service.index}
        heading={t.home.service.heading}
        highlight={t.home.service.highlight}
        intro={t.home.service.intro}
      />
      <div class="pillars">
        {t.home.service.pillars.map((pillar, i) => (
          <article
            class:list={[
              'pillar-card',
              i === 0 && 'pillar-card--wide',
              i === 1 && 'pillar-card--narrow',
              i === 2 && 'pillar-card--offset',
            ]}
          >
            <h3 class="pillar-title">
              <span class="pillar-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {pillar.title}
            </h3>
            <p class="pillar-text">{pillar.text}</p>
            <ul class="pillar-tags" role="list">
              {pillar.tags.map((tag) => (
                <li class="pillar-tag">{tag}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="proof section-block reveal">
    <div class="container-site">
      <SectionHead
        index={t.home.proof.index}
        heading={t.home.proof.heading}
        highlight={t.home.proof.highlight}
        intro={t.home.proof.intro}
      />
      <StatsBlocks stats={t.home.proof.stats} />
      <ul class="featured" role="list">
        {featuredCases.map((c) => (
          <li>
            <a class="featured-card" href={localizeHref(`/case-studies/${c.slug}`, t.lang)}>
              <Image
                class="featured-image"
                src={caseImages[c.slug as keyof typeof caseImages][0]}
                alt={c.alt}
                format="avif"
                widths={[480, 640]}
                sizes="(min-width: 1024px) 320px, (min-width: 640px) 300px, 90vw"
              />
              <div class="featured-meta">
                <span class="featured-client">
                  {c.client} <span aria-hidden="true">/</span> {c.year}
                </span>
                <h3 class="featured-title">{c.title}</h3>
                <p class="featured-result">{c.heroResult}</p>
              </div>
              <span class="featured-arrow" aria-hidden="true">
                <Icon name="tabler:arrow-right" width="18" height="18" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="process section-block reveal">
    <div class="container-site">
      <SectionHead
        index={t.process.index}
        heading={t.process.heading}
        highlight={t.process.highlight}
        intro={t.process.intro}
      />
      <ol class="steps" role="list">
        {t.process.steps.map((step, i) => (
          <li class="step">
            <span class="step-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-text">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="stack section-block reveal">
    <div class="container-site">
      <SectionHead
        index={t.stack.index}
        heading={t.stack.heading}
        highlight={t.stack.highlight}
        intro={t.stack.intro}
      />
      <StackDiagram layers={t.stack.layers} caption={t.stack.heading} />
    </div>
  </section>

  <BookCall t={t} location="home" />
</main>

<SiteFooter t={t} />

<script>
  const elements = document.querySelectorAll<HTMLElement>('.reveal');

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    elements.forEach((el) => io.observe(el));
  } else {
    elements.forEach((el) => el.classList.add('is-visible'));
  }
</script>

<style>
  .hero {
    position: relative;
    padding: 132px 0 72px;
    overflow: hidden;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: 48px;
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero-copy h1 {
    font-size: clamp(40px, 7vw, 68px);
    font-weight: 680;
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin: 0;
  }

  .hero-sub {
    max-width: 520px;
    margin: 0;
    color: var(--color-foreground-55);
    font-size: 18px;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .hero-dashboard {
    margin: 0;
  }
  .hero-dashboard-frame {
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 30px 80px rgba(4, 8, 16, 0.5);
  }
  .hero-dashboard-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .trust-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    padding-top: 24px;
    padding-bottom: 24px;
    border-top: 1px solid var(--color-primary-8);
  }
  .trust-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-55);
  }
  .trust-logos {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px 34px;
    opacity: 0.85;
  }
  .trust-logo img {
    height: 22px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.75;
  }
  .trust-logo--small img {
    height: 18px;
  }

  .section-block {
    padding: 96px 0;
  }

  .pain-list {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .pain-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 26px;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-md);
    background: var(--color-primary-4);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .pain-card:hover {
    border-color: var(--color-primary-20);
    background: var(--color-primary-8);
  }
  .pain-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-foreground-70);
  }
  .pain-text {
    color: var(--color-foreground-55);
    font-size: 15px;
    line-height: 1.6;
  }

  .pillars {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 14px;
  }

  .pillar-card {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 30px;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-md);
    background: var(--color-primary-4);
    transition: border-color 0.2s ease, transform 0.25s ease;
  }
  .pillar-card:hover {
    border-color: var(--color-primary-35);
    transform: translateY(-2px);
  }

  .pillar-index {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-primary);
  }
  .pillar-title {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 22px;
    font-weight: 620;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }
  .pillar-text {
    margin: 0;
    max-width: 46ch;
    color: var(--color-foreground-55);
    font-size: 15px;
    line-height: 1.65;
  }
  .pillar-tags {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pillar-tag {
    padding: 6px 12px;
    border: 1px solid var(--color-primary-14);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-primary);
  }

  .featured {
    list-style: none;
    margin: 64px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .featured-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 14px;
    border: 1px solid var(--color-primary-14);
    border-radius: var(--radius-md);
    background: var(--color-primary-4);
    color: var(--color-foreground);
    transition: border-color 0.2s ease, transform 0.25s ease;
  }
  .featured-card:hover {
    border-color: var(--color-primary-35);
    transform: translateY(-2px);
  }
  .featured-image {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: calc(var(--radius-md) - 6px);
    border: 1px solid var(--color-primary-8);
  }
  .featured-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 2px 8px 12px;
  }
  .featured-client {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .featured-title {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .featured-result {
    margin: 0;
    color: var(--color-foreground-55);
    font-size: 14px;
  }
  .featured-arrow {
    position: absolute;
    right: 18px;
    bottom: 18px;
    color: var(--color-primary-35);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .featured-card:hover .featured-arrow {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  .steps {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 22px;
    border-top: 1px solid var(--color-primary-14);
  }
  .step-index {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-primary);
  }
  .step-title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--color-foreground-70);
  }
  .step-text {
    margin: 0;
    color: var(--color-foreground-55);
    font-size: 14px;
    line-height: 1.6;
  }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .hero {
      padding: 168px 0 96px;
    }
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 56px;
    }
    .trust-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .trust-logos {
      gap: 34px;
    }
    .pain-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
    .featured {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media (min-width: 1024px) {
    .pillar-card--wide {
      grid-column: span 7;
    }
    .pillar-card--narrow {
      grid-column: span 5;
    }
    .pillar-card--offset {
      grid-column: 8 / span 5;
    }
  }
</style>