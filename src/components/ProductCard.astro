---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

interface Props {
  entry: CollectionEntry<'productos'>;
}

const { entry } = Astro.props;
const { data } = entry;
const comingSoon = data.status === 'coming-soon';
const asset = (data.image ?? '/assets/dashboard-mock-card.jpg').replace(/^\/assets\//, '');
---

<article class="product-card group flex flex-col h-full">
  <a href={`/productos/${entry.id}/`} class="product-card-media" aria-label={`Ver producto: ${data.title}`}>
    <div class="img-ph img-ph--fill"><span>{asset}</span></div>
  </a>

  <div class="product-card-body">
    <div class="product-card-meta">
      <span class="product-card-category">{data.category}</span>
      <span class:list={['product-card-status', comingSoon && 'product-card-status--soon']}>
        {comingSoon ? 'Próximamente' : 'Disponible'}
      </span>
    </div>

    <h3 class="product-card-title">
      <a href={`/productos/${entry.id}/`} class="hover:text-primary transition-colors">{data.title}</a>
    </h3>
    <p class="product-card-tagline">{data.tagline}</p>

    <div class="product-card-footer">
      <span class="product-card-price">
        {comingSoon ? 'Próximamente' : (data.price ?? 'Precio a definir')}
      </span>
      <a href={`/productos/${entry.id}/`} class="product-card-action" aria-label={`Ver detalles de ${data.title}`}>
        {comingSoon ? 'Avisarme' : 'Ver producto'}
        <Icon name="tabler:arrow-right" width="14" height="14" aria-hidden="true" />
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    border: 1px solid var(--color-primary-10);
    border-radius: var(--radius-sm);
    background: var(--color-card);
    transition: border-color 0.2s ease;
    overflow: hidden;
  }
  .product-card:hover {
    border-color: var(--color-primary-20);
  }

  .product-card-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-card);
    border-bottom: 1px solid var(--color-primary-10);
  }

  .product-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px;
  }
  .product-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .product-card-category {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-foreground-55);
  }
  .product-card-status {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .product-card-status--soon {
    color: var(--color-foreground-55);
  }

  .product-card-title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .product-card-tagline {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-foreground-55);
    flex: 1;
  }

  .product-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--color-primary-10);
  }
  .product-card-price {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-foreground-70);
  }
  .product-card-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 600;
    transition: gap 0.2s ease;
  }
  .product-card-action svg { flex-shrink: 0; }
  .product-card-action:hover { gap: 9px; }
</style>
