---
import Button from './Button.astro';
import IconArrowRight from './IconArrowRight.astro';

interface Props {
  id?: string;
  heading?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}
const {
  id = 'contacto',
  heading = '¿Tu tienda tiene un problema de visibilidad orgánica?',
  description = 'En 30 minutos evaluamos si tiene sentido trabajar juntos y qué tipo de intervención tiene más impacto para tu situación.',
  buttonText = 'Agendar llamada',
  buttonHref = '/contacto/',
} = Astro.props;
---

<section id={id} class="editorial-surface editorial-surface--fade-top cta-section" style="padding: 5rem 0">
  <div class="max-w-5xl mx-auto px-6 reveal">
    <div class="cta-panel editorial-cta">
      <h2 style="font-size: clamp(2rem, 4.5vw, 3.25rem); font-weight: 700; letter-spacing: -0.04em; color: #0d1f3c; margin: 0 0 1.25rem; line-height: 1.05; max-width: 16ch">
        {heading}
      </h2>
      <p style="font-size: 1rem; color: rgba(13,31,60,0.55); line-height: 1.75; margin: 0 0 2.5rem; max-width: 44ch">
        {description}
      </p>
      <div class="cta-btn-wrapper" data-cta-text={buttonText}>
        <Button href={buttonHref} size="lg">
          {buttonText} <IconArrowRight />
        </Button>
      </div>
      {Astro.slots.has('default') && (
        <div style="margin-top: 1rem">
          <slot />
        </div>
      )}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.cta-btn-wrapper').forEach(wrapper => {
    const btn = wrapper.querySelector('a');
    const text = wrapper.getAttribute('data-cta-text') || 'Agendar llamada';
    btn?.addEventListener('click', () => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'cta_click',
        cta_text: text,
        cta_location: 'section-cta',
      });
    });
  });
</script>

<style is:global>
  .cta-panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    padding: 3.5rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid var(--color-primary-14);
    background-color: var(--color-card);
    background-image: var(--dot-grid), var(--gradient-section);
    background-size: 24px 24px, 100% 100%;
    box-shadow: var(--shadow-elevated);
  }
  .cta-panel > * { position: relative; z-index: 1; }
  .editorial-cta { align-items: flex-start; }
  .cta-panel h2 { color: var(--color-foreground) !important; }
  .cta-panel p { color: var(--color-prose-muted) !important; }
  @media (max-width: 640px) { .cta-panel { padding: 2rem 1.5rem; } }
</style>
