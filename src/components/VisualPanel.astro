---
interface Props {
  src: string;
  alt: string;
  index?: string;
  label?: string;
}

const { src, alt, index, label } = Astro.props;
---

<div class="visual-panel relative h-full overflow-hidden bg-card">
  <div class="img-ph img-ph--fill"><span>{src.replace(/^\/assets\//, '')}</span></div>
  <div class="visual-panel-scrim" aria-hidden="true"></div>
  {label && (
    <span class="absolute z-[1] bottom-4 left-4 font-mono text-[11px] tracking-[0.1em] uppercase text-foreground">{label}</span>
  )}
</div>

<style>
  .visual-panel {
    border: 1px solid var(--color-primary-10);
    border-radius: var(--radius-sm);
  }
  .visual-panel-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 13, 20, 0), rgba(10, 13, 20, 0.4));
    pointer-events: none;
  }
</style>
