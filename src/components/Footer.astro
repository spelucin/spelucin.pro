---
import Logo from './Logo.astro';
---

<footer class="site-footer">
  <div class="max-w-5xl mx-auto px-6 flex flex-wrap items-center justify-between gap-4">
    <div class="site-footer-brand">
      <Logo size={22} />
      <span>SEO técnico para Shopify</span>
    </div>
    <div class="site-footer-meta">
      <a href="/politica-de-privacidad/">Política de privacidad</a>
      <span>Derechos reservados - 2026</span>
    </div>
  </div>
</footer>

<style is:global>
  .site-footer { padding: 2.25rem 0; }
  .site-footer-brand, .site-footer-meta { display: flex; align-items: center; gap: 0.75rem; }
  .site-footer-brand span, .site-footer-meta { color: var(--color-foreground-40); font-size: 0.75rem; }
  .site-footer-meta { gap: 1.5rem; }
  .site-footer a { color: inherit; text-decoration: none; transition: color 180ms ease; }
  .site-footer a:hover { color: var(--color-primary); }
  @media (max-width: 640px) {
    .site-footer-meta { align-items: flex-start; flex-direction: column; gap: 0.5rem; }
  }
</style>
