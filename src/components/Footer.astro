---
const siteLinks = [
  { href: '/productos', label: 'Productos' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/portafolio', label: 'Portafolio' },
  { href: '/notas', label: 'Notas' },
  { href: '/acerca-de', label: 'Acerca de' },
  { href: '/contacto', label: 'Contacto' },
];

const contactLinks = [
  { href: 'mailto:alex@spelucin.pro', label: 'alex@spelucin.pro' },
  { href: 'https://linkedin.com/in/spelucin', label: 'LinkedIn' },
  { href: 'https://github.com/spelucin', label: 'GitHub' },
];

const legalLinks = [
  { href: '/privacidad', label: 'Privacidad' },
  { href: '/terminos', label: 'Términos' },
];
---

<footer class="border-t border-primary-8 pt-14 pb-12">
  <div class="container-site grid gap-10 md:grid-cols-[1.2fr_1fr] md:gap-16">
    <div>
      <a href="/" class="flex items-center gap-[10px] w-fit">
        <img src="/assets/logo.svg" alt="Logo de spelucin.pro" width="26" height="26" class="w-[26px] h-[26px]" />
        <span class="text-foreground font-bold tracking-tight">spelucin<span class="text-primary">.pro</span></span>
      </a>
      <p class="mt-4 max-w-[380px] text-[15px] leading-[1.6] text-foreground-55">
        Analítica digital y data de marketing. Construyo los sistemas que convierten la data de marketing en algo que los equipos pueden usar.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-8">
      <nav class="flex flex-col gap-3" aria-label="Secciones del sitio">
        {siteLinks.map((link) => (
          <a href={link.href} class="text-[15px] text-foreground-55 hover:text-primary transition-colors w-fit">
            {link.label}
          </a>
        ))}
      </nav>

      <nav class="flex flex-col gap-3" aria-label="Contacto">
        {contactLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener' : undefined}
            class="text-[15px] text-foreground-55 hover:text-primary transition-colors w-fit"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="container-site mt-12 pt-6 border-t border-primary-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm text-foreground-55">
    <span>&copy; 2026 Alex Spelucin. Todos los derechos reservados.</span>
    <nav class="flex items-center gap-4" aria-label="Información legal">
      {legalLinks.map((link) => <a href={link.href} class="hover:text-primary transition-colors">{link.label}</a>)}
    </nav>
  </div>
</footer>
