---
import '../styles/global.css';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/jetbrains-mono';
import type { Translations } from '../i18n/types';
import { site } from '../data/site';

interface Props {
  t: Translations;
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const { t, title, description, image = site.ogImage, canonical, noindex = false } = Astro.props;

const url = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image, site.url).toString();
const titleTag = title ?? t.meta.title;
const descriptionTag = description ?? t.meta.description;
const isRootPage = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
const alternateLinks = isRootPage
  ? [
      { hreflang: 'es', href: '/' },
      { hreflang: 'en', href: '/en/' },
    ]
  : [];
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleTag}</title>
    <meta name="description" content={descriptionTag} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={url} />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={new URL(link.href, site.url).toString()} />
    ))}
    {alternateLinks.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={new URL('/', site.url).toString()} />
    )}
    <meta name="theme-color" content="#0a0d14" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={titleTag} />
    <meta property="og:description" content={descriptionTag} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={site.ogImageWidth} />
    <meta property="og:image:height" content={site.ogImageHeight} />
    <meta property="og:image:alt" content={t.meta.imageAlt} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={t.ogLocale === 'es_ES' ? 'en_US' : 'es_ES'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titleTag} />
    <meta name="twitter:description" content={descriptionTag} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (function (C, A, L) {
        var p = function (a, ar) { a.q.push(ar); };
        var d = C.document;
        C.Cal = C.Cal || function () {
          var cal = C.Cal;
          var ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement('script')).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            var api = function () { p(api, arguments); };
            var namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === 'string') cal.ns[namespace] = api;
            else p(cal, namespace);
            return api;
          }
          p(cal, ar);
        };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');
      Cal('init', 'spelucin', { origin: 'https://spelucin.pro' });
    </script>

    <slot name="jsonld" />
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K7VLRW2S" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a class="skip-link" href="#main-content">{t.skipLink}</a>
    <slot />
  </body>
</html>

<script>
  const dataLayer = window.dataLayer || (window.dataLayer = []);

  document.addEventListener('click', (event) => {
    const cta = event.target.closest('[data-cta]');
    if (cta) {
      dataLayer.push({
        event: 'cta_click',
        cta_text: cta.dataset.ctaText,
        cta_location: cta.dataset.ctaLocation,
      });
    }
    const lead = event.target.closest('[data-lead]');
    if (lead) {
      dataLayer.push({
        event: 'generate_lead',
        lead_source: lead.dataset.leadSource,
        lead_type: lead.dataset.leadType,
      });
    }
    const calendar = event.target.closest('[data-calendar]');
    if (calendar) {
      dataLayer.push({
        event: 'calendar_open',
        calendar_location: calendar.dataset.calendarLocation,
      });
    }
  });

  const registerBookingListener = () => {
    const ns = window.Cal?.ns?.['spelucin'];
    if (!ns) return false;
    ns('on', {
      action: 'bookingSuccessfulV2',
      callback: (data) => {
        const booking = data?.detail?.data ?? {};
        const email = booking.responses?.email?.value ?? booking.email ?? '';
        dataLayer.push({
          event: 'generate_lead',
          lead_source: 'calendar',
          lead_type: 'calendar',
          event_title: booking.eventTitle ?? '',
          booking_email: email,
        });
      },
    });
    return true;
  };

  if (!registerBookingListener()) {
    const timer = setInterval(() => {
      if (registerBookingListener()) clearInterval(timer);
    }, 300);
    setTimeout(() => clearInterval(timer), 10000);
  }
</script>