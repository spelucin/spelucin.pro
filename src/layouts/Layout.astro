---
import '../styles/global.css';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/jetbrains-mono';
import type { Translations } from '../i18n/types';
import { site } from '../data/site';
import { equivalentPath } from '../utils/lang';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  t: Translations;
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  breadcrumb?: BreadcrumbItem[];
}

const {
  t,
  title,
  description,
  image = site.ogImage,
  canonical,
  noindex = false,
  breadcrumb = [],
} = Astro.props as Props;

const url = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image, site.url).toString();
const titleTag = title ?? t.meta.title;
const descriptionTag = description ?? t.meta.description;
const alternateLinks = [
  { hreflang: 'es', href: equivalentPath(Astro.url.pathname, 'es') },
  { hreflang: 'en', href: equivalentPath(Astro.url.pathname, 'en') },
  { hreflang: 'x-default', href: '/' },
];
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleTag}</title>
    <meta name="description" content={descriptionTag} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={url} />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={new URL(link.href, site.url).toString()} />
    ))}
    <meta name="theme-color" content="#0a0d14" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={titleTag} />
    <meta property="og:description" content={descriptionTag} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.ogImageWidth)} />
    <meta property="og:image:height" content={String(site.ogImageHeight)} />
    <meta property="og:image:alt" content={t.meta.imageAlt} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={t.ogLocale === 'es_ES' ? 'en_US' : 'es_ES'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titleTag} />
    <meta name="twitter:description" content={descriptionTag} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (function (C, A, L) {
        let p = (a, ar) => { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement('script')).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === 'string') {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ['initNamespace', namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');
      Cal('init', 'spelucin', { origin: 'https://cal.com' });
    </script>

    <slot name="jsonld" />

    {breadcrumb.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
          ...breadcrumb.map((crumb, i) => ({
            '@type': 'ListItem',
            position: i + 2,
            name: crumb.name,
            item: new URL(crumb.path, site.url).toString(),
          })),
        ],
      })} />
    )}
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K7VLRW2S" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a class="skip-link" href="#main-content">{t.skipLink}</a>
    <slot />
    <div class="cal-modal" data-cal-modal-overlay hidden>
      <div class="cal-modal-dialog" role="dialog" aria-modal="true" aria-label={t.calModal.label}>
        <div class="cal-modal-toolbar">
          <span class="cal-modal-dots">
            <button type="button" class="cal-modal-dot cal-modal-dot--close" data-cal-modal-close aria-label={t.calModal.close}></button>
            <span class="cal-modal-dot cal-modal-dot--min"></span>
            <span class="cal-modal-dot cal-modal-dot--max"></span>
          </span>
          <span class="cal-modal-title">{t.calModal.label}</span>
        </div>
        <div id="cal-inline" class="cal-modal-slot"></div>
      </div>
    </div>
  </body>
</html>

<script>
  declare global {
    interface Window {
      dataLayer: Record<string, unknown>[];
      Cal?: {
        (command: string, ...args: unknown[]): void;
        ns?: {
          spelucin?: {
            (action: string, opts: Record<string, unknown>): void;
            q?: unknown[];
          };
        };
      };
    }
  }

  const dataLayer: Record<string, unknown>[] =
    window.dataLayer ?? (window.dataLayer = []);

  document.addEventListener('click', (event) => {
    const target = event.target instanceof HTMLElement ? event.target : null;

    const cta = target?.closest<HTMLElement>('[data-cta]');
    if (cta) {
      dataLayer.push({
        event: 'cta_click',
        cta_text: cta.dataset.ctaText,
        cta_location: cta.dataset.ctaLocation,
      });
    }
    const lead = target?.closest<HTMLElement>('[data-lead]');
    if (lead) {
      dataLayer.push({
        event: 'generate_lead',
        lead_source: 'email',
      });
    }
    const calendar = target?.closest<HTMLElement>('[data-calendar]');
    if (calendar) {
      dataLayer.push({
        event: 'calendar_open',
        calendar_location: calendar.dataset.calendarLocation,
      });
    }
    const langLink = target?.closest<HTMLElement>('[data-lang-switch]');
    if (langLink) {
      dataLayer.push({
        event: 'language_switch',
        lang_to: langLink.dataset.langTo,
      });
    }
    const caseLink = target?.closest<HTMLElement>('[data-case-study]');
    if (caseLink) {
      dataLayer.push({
        event: 'case_study_click',
        case_study_slug: caseLink.dataset.caseStudySlug,
        case_study_name: caseLink.dataset.caseStudyName,
        case_study_industry: caseLink.dataset.caseStudyIndustry,
      });
    }
    const calModal = target?.closest<HTMLElement>('[data-cal-modal]');
    if (calModal) {
      event.preventDefault();
      const details = calModal.closest('details');
      if (details) details.open = false;
      openCalModal(calModal);
    }
  });

  const calOverlay = document.querySelector<HTMLElement>('[data-cal-modal-overlay]');
  const calSlot = document.querySelector<HTMLElement>('#cal-inline');
  const calCloseBtn = document.querySelector<HTMLElement>('[data-cal-modal-close]');
  let calRendered = false;
  let lastFocused: HTMLElement | null = null;

  const openCalModal = (trigger: HTMLElement) => {
    if (!calOverlay || !calSlot) return;
    lastFocused = trigger;
    calOverlay.hidden = false;
    document.body.classList.add('cal-modal-open');
    calCloseBtn?.focus();
    if (!calRendered) {
      if (typeof window.Cal === 'function') {
        window.Cal('inline', {
          calLink: 'spelucin',
          elementOrSelector: '#cal-inline',
          config: { theme: 'dark', layout: 'month_view' },
        });
      } else {
        calSlot.innerHTML =
          '<iframe src="https://cal.com/spelucin?embed=true&amp;embedType=inline&amp;theme=dark&amp;layout=month_view" title="Cal.com" loading="lazy"></iframe>';
      }
      calRendered = true;
    }
  };

  const closeCalModal = () => {
    if (!calOverlay) return;
    calOverlay.hidden = true;
    document.body.classList.remove('cal-modal-open');
    lastFocused?.focus();
  };

  calCloseBtn?.addEventListener('click', closeCalModal);

  calOverlay?.addEventListener('click', (event) => {
    if (event.target === calOverlay) closeCalModal();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && calOverlay && !calOverlay.hidden) {
      closeCalModal();
    }
  });

  const registerBookingListener = () => {
    const ns = window.Cal?.ns?.['spelucin'];
    if (!ns) return false;
    ns('on', {
      action: 'bookingSuccessfulV2',
      callback: () => {
        dataLayer.push({
          event: 'generate_lead',
          lead_source: 'calendar',
        });
      },
    });
    return true;
  };

  if (!registerBookingListener()) {
    const timer = setInterval(() => {
      if (registerBookingListener()) clearInterval(timer);
    }, 300);
    setTimeout(() => clearInterval(timer), 10000);
  }
</script>

<style>
  .cal-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: clamp(12px, 4vw, 36px);
    background: rgba(5, 8, 14, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow-y: auto;
  }
  .cal-modal[hidden] { display: none; }
  .cal-modal-dialog {
    position: relative;
    width: min(94vw, 860px);
    margin: auto;
    border: 1px solid rgba(240, 246, 255, 0.1);
    border-radius: 14px;
    background: var(--color-card);
    box-shadow: 0 40px 110px rgba(3, 5, 10, 0.65);
    overflow: hidden;
  }
  .cal-modal-toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 13px 16px;
    border-bottom: 1px solid var(--color-primary-14);
    background: rgba(240, 246, 255, 0.02);
  }
  .cal-modal-dots { display: inline-flex; gap: 8px; justify-self: start; }
  .cal-modal-dot { width: 12px; height: 12px; border: 0; padding: 0; border-radius: 50%; }
  .cal-modal-dot--close { background: #ff5f57; cursor: pointer; transition: filter 0.2s ease; }
  .cal-modal-dot--close:hover { filter: brightness(1.15); }
  .cal-modal-dot--close:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .cal-modal-dot--min { background: #febc2e; }
  .cal-modal-dot--max { background: #28c840; }
  .cal-modal-title {
    justify-self: center;
    overflow: hidden;
    max-width: 70%;
    color: var(--color-foreground-55);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cal-modal-slot { height: min(80vh, 680px); padding: 26px 24px 30px; }
  .cal-modal-slot iframe { display: block; width: 100%; height: 100%; border: 0; }
  body.cal-modal-open { overflow: hidden; }
</style>