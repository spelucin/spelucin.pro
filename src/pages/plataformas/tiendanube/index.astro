---
import Layout from '../../../layouts/Layout.astro';
import CommercialPage from '../../../components/CommercialPage.astro';
import { t } from '../../../i18n/es';
import { commercialEs } from '../../../i18n/commercial-es';

const page = commercialEs.pages.tiendanube;
---

<Layout
  t={t}
  title={page.seo.title}
  description={page.seo.description}
  breadcrumb={[{ name: 'Plataformas', path: '/plataformas' }, { name: 'Tiendanube', path: '/plataformas/tiendanube' }]}
>
  <CommercialPage t={t} page={page} />
</Layout>
