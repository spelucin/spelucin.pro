---
import Layout from '../../layouts/Layout.astro';
import HubPage from '../../components/HubPage.astro';
import { t } from '../../i18n/es';
import { commercialEs } from '../../i18n/commercial-es';

const hub = commercialEs.platformsHub;
---

<Layout
  t={t}
  title={hub.seo.title}
  description={hub.seo.description}
  breadcrumb={[{ name: 'Plataformas', path: '/plataformas' }]}
>
  <HubPage t={t} hub={hub} location="platforms" />
</Layout>
