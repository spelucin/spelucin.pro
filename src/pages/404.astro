---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { t } from '../i18n/es';
---

<Layout t={t} title="Página no encontrada · Alex Spelucin" description="Parece que esta página se movió o la dirección no existe. Vuelve al inicio." noindex={true}>
  <SiteHeader t={t} />
  <main id="main-content">
    <section class="page-404">
      <div class="container-site">
        <p class="err-code">404</p>
        <h1>Esta página no existe.</h1>
        <p>Puede que se haya movido o que la dirección esté mal escrita.</p>
        <a class="err-link" href="/">Volver al inicio</a>
      </div>
    </section>
  </main>
  <SiteFooter t={t} />
</Layout>

<style>
  .page-404 {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding-top: 96px;
    padding-bottom: 80px;
  }
  .err-code {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .page-404 h1 {
    margin-top: 18px;
    font-size: 38px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .page-404 p:not(.err-code) {
    margin-top: 18px;
    max-width: 520px;
    color: var(--color-foreground-55);
    font-size: 17px;
    line-height: 1.6;
  }
  .err-link {
    display: inline-flex;
    margin-top: 36px;
    padding: 13px 22px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-primary-5);
    color: var(--color-foreground);
    font-size: 15px;
    font-weight: 600;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .err-link:hover {
    background: var(--color-primary-10);
    border-color: var(--color-primary-35);
  }
  @media (min-width: 768px) {
    .page-404 h1 { font-size: 52px; }
  }
</style>