---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import CTA from '../../components/CTA.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import ServiceProcess from '../../components/ServiceProcess.astro';
import ProblemSection from '../../components/ProblemSection.astro';
import { Icon } from 'astro-icon/components';
import { services, rule } from '../../data';
import type { Service } from '../../data';

export function getStaticPaths() {
  return services.map(s => ({
    params: { slug: s.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props as { service: Service };
const d = service.detail;
const W = "max-w-5xl mx-auto px-6";
const deliverableIcons = ['ph:file-text', 'ph:tree-structure', 'ph:chat-circle', 'ph:folder-open'];

const deliverableCards: Record<string, { eyebrow: string; title: string; description: string; tag: string }[]> = {
  "auditoria-seo-tecnica": [
    { eyebrow: "INFORME", title: "Informe técnico completo", description: "Más de 50 puntos revisados con evidencia, capturas de pantalla y nivel de prioridad para cada hallazgo.", tag: "PDF + anexos" },
    { eyebrow: "ROADMAP", title: "Roadmap priorizado", description: "No recibirás una lista de errores. Recibirás exactamente qué corregir primero según impacto en revenue.", tag: "Quick Wins + Medio plazo" },
    { eyebrow: "REVISIÓN", title: "Sesión de revisión", description: "60 minutos para revisar cada hallazgo contigo o tu desarrollador. Contexto completo, sin sorpresas.", tag: "Videollamada" },
    { eyebrow: "ANEXOS", title: "Archivos de trabajo", description: "CSV de URLs afectadas, ejemplos de hallazgos y recursos técnicos para facilitar la implementación.", tag: "Exportables" },
  ],
  "estrategia-de-catalogo": [
    { eyebrow: "INVESTIGACIÓN", title: "Keyword research vertical", description: "Análisis completo de demanda real para tu categoría. Volúmenes, intención de búsqueda y oportunidades.", tag: "Documento vivo" },
    { eyebrow: "ESTRUCTURA", title: "Jerarquía de colecciones", description: "Mapa visual y documentado de categorías, subcategorías y relaciones semánticas entre productos.", tag: "Figma + CSV" },
    { eyebrow: "ARQUITECTURA", title: "Estructura de URLs y facetas", description: "Naming optimizado para SEO, reglas de facetas y plan de enlaces internos que distribuyen autoridad.", tag: "Plan de implementación" },
    { eyebrow: "SESIÓN", title: "Sesión de revisión", description: "Reunión para validar la propuesta, resolver dudas de implementación y alinear con tu equipo técnico.", tag: "Videollamada" },
  ],
  "talleres-y-capacitaciones": [
    { eyebrow: "CONTENIDO", title: "Programa a medida", description: "Contenido diseñado específicamente para tu equipo, con casos reales de tu tienda y tus procesos diarios.", tag: "2–4 horas" },
    { eyebrow: "PRÁCTICA", title: "Ejercicios en vivo", description: "Laboratorios interactivos donde el equipo aplica lo aprendido sobre su propio Shopify en tiempo real.", tag: "Hands-on" },
    { eyebrow: "MATERIAL", title: "Material y grabación", description: "Guías de referencia, cheatsheets y grabación de la sesión completa para consultar después.", tag: "Entregable permanente" },
    { eyebrow: "SEGUIMIENTO", title: "Q&A post-taller", description: "Una sesión de 30 minutos dentro de los 30 días para resolver dudas de implementación.", tag: "30 min" },
  ],
};

const idealCards: Record<string, string[]> = {
  "auditoria-seo-tecnica": [
    "Tu tráfico lleva meses sin crecer",
    "Acabas de migrar de tema o agencia",
    "Google no indexa productos nuevos",
    "Tienes cientos de SKUs sin estructura clara",
    "Search Console muestra errores constantes",
    "Sospechas problemas de arquitectura",
    "El tráfico cayó después de cambios técnicos",
    "No sabes qué corregir primero",
  ],
  "estrategia-de-catalogo": [
    "Planeas lanzar nuevas categorías de productos",
    "Migraste a Shopify sin optimizar la estructura",
    "Tienes muchos productos pero poca visibilidad orgánica",
    "Quieres entrar a nuevos mercados o idiomas",
    "Las colecciones no reflejan cómo busca tu cliente",
    "Los filtros generan URLs duplicadas masivamente",
    "No hay jerarquía clara entre categorías",
    "El enlazado interno distribuye autoridad al azar",
  ],
  "talleres-y-capacitaciones": [
    "Tu equipo actualiza contenido y lanza colecciones regularmente",
    "Contrataste a alguien para SEO y necesita formación en Shopify",
    "Tu agencia se va y quieres internalizar el conocimiento",
    "Todo el equipo necesita hablar el mismo idioma SEO",
    "Dependen del consultor para cada cambio mínimo",
    "Publican colecciones sin optimizar metadatos ni URLs",
    "Tienen GSC pero no saben qué mirar ni cómo actuar",
    "Quieren reducir errores de contenido duplicado",
  ],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: service.name,
  name: service.name,
  description: service.description,
  provider: {
    "@type": "ProfessionalService",
    name: "Alex Spelucin",
    email: "alex@spelucin.pro",
  },
  areaServed: ["MX", "AR", "US", "ES"],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: d.faq.map(f => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Base
  title={`${service.name} para Shopify - Alex Spelucin`}
  description={service.description}
  image={`/og/servicio-${service.slug}.jpg`}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <Nav />
  <div style="background: #fff">

    <ServiceHero
      backHref="/#servicios"
      backLabel="Servicios"
      eyebrow={service.name}
      title={d.heroHeadline}
      description={d.heroSubheadline}
      ctaText="Agendar llamada gratuita"
      price={service.price}
    />

    <ProblemSection title={d.problemContext} description={d.problemDescription} />

    {/* ── Entregables ─────────────────────────────────── */}
    <section style="padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Entregables</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3rem; line-height: 1.2">
          Qué recibes al contratar este servicio
        </h2>
        <div class="service-detail-deliverables">
          {(deliverableCards[service.slug] || []).map((card, index) => (
            <div class="service-detail-deliverable">
              <div class="service-detail-icon" aria-hidden="true"><Icon name={deliverableIcons[index] ?? 'ph:check'} width={19} height={19} /></div>
              <div>
                <div class="service-detail-item-label">{card.eyebrow}</div>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
                <span>{card.tag}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Para quién es ─────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Para quién es</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3rem; line-height: 1.2">
          {d.idealFor}
        </h2>
        <div class="service-detail-ideal-grid">
          {(idealCards[service.slug] || []).map((sit) => (
            <div class="service-detail-row service-detail-ideal-row">
              <div class="service-detail-icon" aria-hidden="true"><Icon name="ph:check" width={18} height={18} /></div>
              <p>{sit}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Proceso ───────────────────────────────────── */}
    <ServiceProcess steps={d.processSteps} mockupVariant={service.slug} heading="Cómo trabajo" />

    {/* ── FAQ ───────────────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <div style={rule} />
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 3.5rem 0 2.5rem; line-height: 1.2">
          Preguntas frecuentes
        </h2>
        <div style="display: flex; flex-direction: column; gap: 0">
          {d.faq.map((item, i) => (
            <>
              {i > 0 && <div style="height: 1px; background: rgba(21,96,189,0.07)" />}
              <div style="padding: 1.5rem 0">
                <div style="font-size: 0.95rem; font-weight: 600; color: #0d1f3c; line-height: 1.4; margin-bottom: 0.5rem">{item.question}</div>
                <p style="font-size: 0.9rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0">{item.answer}</p>
              </div>
            </>
          ))}
        </div>
      </div>
    </section>

    {/* ── CTA ───────────────────────────────────────── */}
    <CTA
      id="cta"
      heading={d.ctaHeadline}
      description="Llamada gratuita de 30 minutos. Sin compromiso."
      buttonText="Agendar llamada"
    />

  </div>
  <Footer />
</Base>

