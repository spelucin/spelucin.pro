---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import CTA from '../../components/CTA.astro';
import IconArrowRight from '../../components/IconArrowRight.astro';
import ServiceReportMockup from '../../components/ServiceReportMockup.astro';
import { services, rule } from '../../data';
import type { Service } from '../../data';

export function getStaticPaths() {
  return services.map(s => ({
    params: { slug: s.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props as { service: Service };
const d = service.detail;
const W = "max-w-5xl mx-auto px-6";

const deliverableCards: Record<string, { eyebrow: string; title: string; description: string; tag: string }[]> = {
  "auditoria-seo-tecnica": [
    { eyebrow: "INFORME", title: "Informe técnico completo", description: "Más de 50 puntos revisados con evidencia, capturas de pantalla y nivel de prioridad para cada hallazgo.", tag: "PDF + anexos" },
    { eyebrow: "ROADMAP", title: "Roadmap priorizado", description: "No recibirás una lista de errores. Recibirás exactamente qué corregir primero según impacto en revenue.", tag: "Quick Wins + Medio plazo" },
    { eyebrow: "REVISIÓN", title: "Sesión de revisión", description: "60 minutos para revisar cada hallazgo contigo o tu desarrollador. Contexto completo, sin sorpresas.", tag: "Videollamada" },
    { eyebrow: "ANEXOS", title: "Archivos de trabajo", description: "CSV de URLs afectadas, ejemplos de hallazgos y recursos técnicos para facilitar la implementación.", tag: "Exportables" },
  ],
  "estrategia-de-catalogo": [
    { eyebrow: "INVESTIGACIÓN", title: "Keyword research vertical", description: "Análisis completo de demanda real para tu categoría. Volúmenes, intención de búsqueda y oportunidades.", tag: "Documento vivo" },
    { eyebrow: "ESTRUCTURA", title: "Jerarquía de colecciones", description: "Mapa visual y documentado de categorías, subcategorías y relaciones semánticas entre productos.", tag: "Figma + CSV" },
    { eyebrow: "ARQUITECTURA", title: "Estructura de URLs y facetas", description: "Naming optimizado para SEO, reglas de facetas y plan de enlaces internos que distribuyen autoridad.", tag: "Plan de implementación" },
    { eyebrow: "SESIÓN", title: "Sesión de revisión", description: "Reunión para validar la propuesta, resolver dudas de implementación y alinear con tu equipo técnico.", tag: "Videollamada" },
  ],
  "talleres-y-capacitaciones": [
    { eyebrow: "CONTENIDO", title: "Programa a medida", description: "Contenido diseñado específicamente para tu equipo, con casos reales de tu tienda y tus procesos diarios.", tag: "2–4 horas" },
    { eyebrow: "PRÁCTICA", title: "Ejercicios en vivo", description: "Laboratorios interactivos donde el equipo aplica lo aprendido sobre su propio Shopify en tiempo real.", tag: "Hands-on" },
    { eyebrow: "MATERIAL", title: "Material y grabación", description: "Guías de referencia, cheatsheets y grabación de la sesión completa para consultar después.", tag: "Entregable permanente" },
    { eyebrow: "SEGUIMIENTO", title: "Q&A post-taller", description: "Una sesión de 30 minutos dentro de los 30 días para resolver dudas de implementación.", tag: "30 min" },
  ],
};

const idealCards: Record<string, string[]> = {
  "auditoria-seo-tecnica": [
    "Tu tráfico lleva meses sin crecer",
    "Acabas de migrar de tema o agencia",
    "Google no indexa productos nuevos",
    "Tienes cientos de SKUs sin estructura clara",
    "Search Console muestra errores constantes",
    "Sospechas problemas de arquitectura",
    "El tráfico cayó después de cambios técnicos",
    "No sabes qué corregir primero",
  ],
  "estrategia-de-catalogo": [
    "Planeas lanzar nuevas categorías de productos",
    "Migraste a Shopify sin optimizar la estructura",
    "Tienes muchos productos pero poca visibilidad orgánica",
    "Quieres entrar a nuevos mercados o idiomas",
    "Las colecciones no reflejan cómo busca tu cliente",
    "Los filtros generan URLs duplicadas masivamente",
    "No hay jerarquía clara entre categorías",
    "El enlazado interno distribuye autoridad al azar",
  ],
  "talleres-y-capacitaciones": [
    "Tu equipo actualiza contenido y lanza colecciones regularmente",
    "Contrataste a alguien para SEO y necesita formación en Shopify",
    "Tu agencia se va y quieres internalizar el conocimiento",
    "Todo el equipo necesita hablar el mismo idioma SEO",
    "Dependen del consultor para cada cambio mínimo",
    "Publican colecciones sin optimizar metadatos ni URLs",
    "Tienen GSC pero no saben qué mirar ni cómo actuar",
    "Quieren reducir errores de contenido duplicado",
  ],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: service.name,
  name: service.name,
  description: service.description,
  provider: {
    "@type": "ProfessionalService",
    name: "Alex Spelucin",
    email: "alex@spelucin.pro",
  },
  areaServed: ["MX", "AR", "US", "ES"],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: d.faq.map(f => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Base
  title={`${service.name} para Shopify - Alex Spelucin`}
  description={service.description}
  image={`/og/servicio-${service.slug}.jpg`}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <Nav />
  <div style="background: #fff">

    <section style="padding-top: 10rem; padding-bottom: 0">
      <div class={`${W} reveal`}>
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 3.5rem">
          <a href="/#servicios" style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(21,96,189,0.45); text-decoration: none; text-transform: uppercase">
            <span style="transform: rotate(180deg); display: inline-block"><IconArrowRight /></span> Servicios
          </a>
          <div style="flex: 1; height: 1px; background: rgba(21,96,189,0.10)" />
          <Eyebrow>{service.name}</Eyebrow>
        </div>

        <h1 style="font-size: clamp(2.25rem, 5.5vw, 4rem); font-weight: 700; line-height: 1.04; letter-spacing: -0.04em; color: #0d1f3c; margin: 0 0 1.5rem; max-width: 22ch">
          {d.heroHeadline}
        </h1>
        <p style="font-size: 1.1rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0 0 2.5rem; max-width: 50ch">
          {d.heroSubheadline}
        </p>
        <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 4rem">
          <Button href="/contacto/">
            Agendar llamada gratuita <IconArrowRight />
          </Button>
          <span style="font-size: 0.875rem; font-weight: 600; color: rgba(21,96,189,0.6)">{service.price}</span>
        </div>
        <div style={rule} />
      </div>
    </section>

    {/* ─ El problema ─────────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <div class="grid md:grid-cols-12 gap-8">
          <div style="grid-column: span 4">
            <Eyebrow>El problema</Eyebrow>
            <h2 style="font-size: clamp(1.35rem, 2.5vw, 1.65rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 0; line-height: 1.25">
              {d.problemContext}
            </h2>
          </div>
          <div style="grid-column: span 8">
            {d.pains.map((pain, i, arr) => (
              <div>
                <div style="display: flex; gap: 1rem; padding-top: 1.25rem; padding-bottom: 1.25rem">
                  <span style="font-size: 0.7rem; font-weight: 700; color: rgba(21,96,189,0.4); flex-shrink: 0; padding-top: 0.15rem; font-variant-numeric: tabular-nums">0{i + 1}</span>
                  <p style="font-size: 0.9375rem; line-height: 1.7; color: rgba(13,31,60,0.7); margin: 0">{pain}</p>
                </div>
                {i < arr.length - 1 && <div style={rule} />}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── Entregables ─────────────────────────────────── */}
    <section style="padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Entregables</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3rem; line-height: 1.2">
          Qué recibes al contratar este servicio
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {(deliverableCards[service.slug] || []).map((card) => (
            <div style="border: 1px solid rgba(21,96,189,0.08); border-radius: 0.75rem; padding: 2rem; transition: border-color 0.2s ease;">
              <div style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(21,96,189,0.5); margin-bottom: 0.75rem">{card.eyebrow}</div>
              <h3 style="font-size: 1.1rem; font-weight: 700; color: #0d1f3c; margin: 0 0 0.5rem; letter-spacing: -0.02em; line-height: 1.3">{card.title}</h3>
              <p style="font-size: 0.875rem; line-height: 1.65; color: rgba(13,31,60,0.55); margin: 0 0 1.25rem">{card.description}</p>
              <span style="font-size: 0.75rem; font-weight: 600; color: rgba(21,96,189,0.4)">{card.tag}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Para quién es ─────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Para quién es</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3rem; line-height: 1.2">
          {d.idealFor}
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {(idealCards[service.slug] || []).map((sit) => (
            <div style="border: 1px solid rgba(21,96,189,0.08); border-radius: 0.75rem; padding: 1.5rem 2rem; transition: border-color 0.2s ease;">
              <p style="font-size: 0.9375rem; line-height: 1.65; color: rgba(13,31,60,0.7); margin: 0">{sit}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Proceso ───────────────────────────────────── */}
    <section style="padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Proceso</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3.5rem; line-height: 1.2">
          Cómo trabajo
        </h2>

        <div class="grid md:grid-cols-12 gap-10 items-start">
          <div style="grid-column: span 7">
            {d.processSteps.map((step, i, arr) => (
              <div style={`display: grid; grid-template-columns: 3rem 1fr; gap: 1.5rem; padding: 1.75rem 0 ${i < arr.length - 1 ? '1.75rem' : '0'}; ${i < arr.length - 1 ? 'border-bottom: 1px solid rgba(21,96,189,0.06)' : ''}`}>
                <span style="font-size: 0.8rem; font-weight: 700; color: rgba(21,96,189,0.35); font-variant-numeric: tabular-nums; padding-top: 0.15rem; letter-spacing: 0.02em">0{i + 1}</span>
                <div>
                  <h3 style="font-size: 1.05rem; font-weight: 700; color: #0d1f3c; margin: 0 0 0.5rem; letter-spacing: -0.02em">{step.title}</h3>
                  <p style="font-size: 0.9rem; line-height: 1.7; color: rgba(13,31,60,0.6); margin: 0; max-width: 52ch">{step.description}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="process-sticky" style="grid-column: span 5;">
            <ServiceReportMockup variant={service.slug} />
          </div>
        </div>
      </div>
    </section>

    {/* ── FAQ ───────────────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <div style={rule} />
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 3.5rem 0 2.5rem; line-height: 1.2">
          Preguntas frecuentes
        </h2>
        <div style="display: flex; flex-direction: column; gap: 0">
          {d.faq.map((item, i) => (
            <>
              {i > 0 && <div style="height: 1px; background: rgba(21,96,189,0.07)" />}
              <div style="padding: 1.5rem 0">
                <div style="font-size: 0.95rem; font-weight: 600; color: #0d1f3c; line-height: 1.4; margin-bottom: 0.5rem">{item.question}</div>
                <p style="font-size: 0.9rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0">{item.answer}</p>
              </div>
            </>
          ))}
        </div>
      </div>
    </section>

    {/* ── Bundle Promotion ──────────────────────────── */}
    {(service.slug === "auditoria-seo-tecnica" || service.slug === "estrategia-de-catalogo") && (
      <section style="background: #fff; padding: 5rem 0">
        <div class={`${W} reveal`}>
          <div style={rule} />
          <div style="margin-top: 3rem; border: 1px solid rgba(21,96,189,0.08); border-radius: 1rem; padding: 2.5rem 3rem; background: var(--color-surface); display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap">
            <div>
              <div style="display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 0.75rem">
                <span style="width: 5px; height: 5px; border-radius: 50%; background: #1560bd; box-shadow: 0 0 5px rgba(21,96,189,0.5)" />
                <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #1560bd">Shopify SEO Sprint</span>
              </div>
              {service.slug === "auditoria-seo-tecnica" ? (
                <p style="font-size: 0.9375rem; line-height: 1.7; color: rgba(13,31,60,0.65); margin: 0; max-width: 45ch">
                  ¿Buscas una revisión estratégica más amplia? El <strong>Shopify SEO Sprint</strong> combina esta auditoría con una Estrategia de Catálogo completa en un solo engagement.
                </p>
              ) : (
                <p style="font-size: 0.9375rem; line-height: 1.7; color: rgba(13,31,60,0.65); margin: 0; max-width: 45ch">
                  ¿Necesitas validación técnica y dirección estratégica? El <strong>Shopify SEO Sprint</strong> combina ambos servicios en un solo engagement.
                </p>
              )}
            </div>
            <a
              href="/sprints/shopify-seo-sprint/"
              class="btn btn-primary"
              style="flex-shrink: 0"
            >
              Ver Sprint <IconArrowRight />
            </a>
          </div>
        </div>
      </section>
    )}

    {/* ── CTA ───────────────────────────────────────── */}
    <CTA
      id="cta"
      heading={d.ctaHeadline}
      description="Llamada gratuita de 30 minutos. Sin compromiso."
      buttonText="Agendar llamada"
    />

  </div>
  <Footer />
</Base>

