---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Capabilities from '../components/Capabilities.astro';
import CaseCard from '../components/CaseCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { safeCollection } from '../lib/content';
import { site } from '../data/site';

const clientLogos = [
  { src: '/assets/notebook-client-logo.svg', alt: 'Notebook Agency' },
  { src: '/assets/torices-client-logo.svg', alt: 'Torices' },
  { src: '/assets/owlbox-client-logo.svg', alt: 'Owlbox', small: true },
  { src: '/assets/picnic-client-logo.svg', alt: 'Picnic' },
];

const trabajos = (await getCollection('trabajos'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

const productos = (await getCollection('productos'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => a.data.order - b.data.order);

const notas = (await safeCollection('notas'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Digital Analytics & Marketing Data',
  description: site.description,
  sameAs: [site.linkedin, site.github],
};
---

<Layout
  title="Alex Spelucin — Analítica digital y data de marketing"
  description="Analítica digital y data de marketing: medición, reporting y sistemas que los equipos pueden usar sin depender de una sola persona."
>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Nav />

  <main id="main-content">
    {/* ---------- HERO ---------- */}
    <section class="relative min-h-[100dvh] flex items-center overflow-hidden pt-24 pb-16 md:pt-28 md:pb-20">
      <div class="absolute inset-0 dot-grid-hero pointer-events-none" aria-hidden="true"></div>
      <div
        class="absolute -top-[260px] right-[-180px] w-[760px] h-[620px] rounded-full pointer-events-none blur-[72px]"
        style="background: radial-gradient(circle, rgba(96,165,250,0.24) 0%, rgba(21,96,189,0.10) 48%, transparent 72%);"
        aria-hidden="true"
      ></div>

      <div class="container-site relative z-[2] grid w-full items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div>
          <span class="badge">Digital Analytics &amp; Marketing Data</span>

          <h1 class="mt-7 max-w-[600px] text-[36px] md:text-[44px] lg:text-[52px] font-semibold tracking-[-0.03em] leading-[1.08]">
            Data de marketing <span class="text-primary">que los equipos pueden usar.</span>
          </h1>

          <p class="mt-6 max-w-[520px] text-lg leading-[1.55] text-foreground-55">
            Construyo sistemas de medición, reporting y analítica que se operan a escala de agencia. Sin dashboards de adorno.
          </p>

          <div class="mt-10 flex flex-wrap gap-[14px]">
            <a href="/productos" class="btn btn-primary">
              Ver productos
              <Icon name="tabler:arrow-right" width="16" height="16" aria-hidden="true" />
            </a>
            <a href="/portafolio" class="btn btn-secondary">Ver portafolio</a>
          </div>
        </div>

        <figure class="hero-dashboard">
          <div class="hero-dashboard-frame">
            <div class="img-ph" style="aspect-ratio: 1280 / 1165; border-radius: 13px;"><span>dashboard-hero.jpg</span></div>
          </div>
        </figure>
      </div>
    </section>

    <section class="border-t border-primary-6">
      <div class="container-site">
        <div class="client-strip">
          <p class="client-strip-label">Ha trabajado con:</p>
          <ul class="client-strip-logos">
            {clientLogos.map((logo) => (
              <li class:list={['client-strip-logo', logo.small && 'client-strip-logo--sm']}>
                <img src={logo.src} alt={logo.alt} width="178" height="56" loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ---------- CAPACIDADES ---------- */}
    <Capabilities />

    {/* ---------- PRODUCTOS ---------- */}
    <section class="py-[80px] md:py-[110px] border-t border-primary-6">
      <div class="container-site">
        <div class="section-intro section-intro-product mb-14 reveal">
          <div>
            <h2 class="text-[34px] md:text-[42px] font-semibold tracking-tight leading-[1.12]">Medición confiable y reporting que escala.</h2>
            <p class="mt-4 text-lg leading-relaxed text-muted-foreground max-w-[600px]">Sistemas de analítica que se pueden operar a escala de agencia. Sin reconstruir dashboards desde cero.</p>
          </div>
          <a href="/productos" class="case-card-link shrink-0">
            Ver todos los productos
            <Icon name="tabler:arrow-right" width="15" height="15" aria-hidden="true" />
          </a>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">
          {productos.map((entry) => (
            <ProductCard entry={entry} />
          ))}
        </div>
      </div>
    </section>

    {/* ---------- SERVICIOS ---------- */}
    <section class="py-[80px] md:py-[110px] border-t border-primary-6">
      <div class="container-site">
        <div class="grid lg:grid-cols-[1fr_1.1fr] gap-12 lg:gap-20 items-start">
          <div class="reveal">
            <p class="section-kicker">Servicios</p>
            <h2 class="mt-4 text-[34px] md:text-[42px] font-semibold tracking-tight leading-[1.12] max-w-[460px]">
              Para agencias con <span class="text-primary">data fragmentada.</span>
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-muted-foreground max-w-[520px]">
              Si tu equipo pierde horas armando reportes a mano o no sabe qué número creer, armo un sistema de analítica que se puede operar. Proyecto fijo de 4-6 semanas y soporte opcional después.
            </p>
            <a href="/servicios" class="case-card-link mt-8 inline-flex">
              Ver cómo funciona
              <Icon name="tabler:arrow-right" width="15" height="15" aria-hidden="true" />
            </a>
          </div>

          <div class="grid gap-4 reveal-stagger">
            <div class="service-point">
              <span class="service-point-num">01</span>
              <div>
                <h3 class="text-[18px] font-semibold tracking-tight">Auditoría de fuentes</h3>
                <p class="mt-1 text-[15px] leading-[1.55] text-foreground-55">Reviso GA4, GSC, Ads y CRM para encontrar por qué los números no cuadran.</p>
              </div>
            </div>
            <div class="service-point">
              <span class="service-point-num">02</span>
              <div>
                <h3 class="text-[18px] font-semibold tracking-tight">Corrección de medición</h3>
                <p class="mt-1 text-[15px] leading-[1.55] text-foreground-55">Arreglo tagging, eventos y conversiones para que el equipo confíe en la data.</p>
              </div>
            </div>
            <div class="service-point">
              <span class="service-point-num">03</span>
              <div>
                <h3 class="text-[18px] font-semibold tracking-tight">Sistema de reporting</h3>
                <p class="mt-1 text-[15px] leading-[1.55] text-foreground-55">Diseño un framework de reportes por cliente + un reporte maestro con KPIs compartidos.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- PORTAFOLIO ---------- */}
    <section class="py-[80px] md:py-[110px] border-t border-primary-6">
      <div class="container-site">
        <div class="section-intro section-intro-left mb-14 reveal">
          <div>
            <h2 class="text-[34px] md:text-[42px] font-semibold tracking-tight leading-[1.12]">Casos <span class="text-primary">reales.</span></h2>
            <p class="mt-4 text-lg leading-relaxed text-muted-foreground max-w-[560px]">Proyectos de medición, reporting y data de marketing que armé para agencias.</p>
          </div>
          <a href="/portafolio" class="case-card-link shrink-0">
            Ver todo el portafolio
            <Icon name="tabler:arrow-right" width="15" height="15" aria-hidden="true" />
          </a>
        </div>

        <div class="grid gap-6 reveal-stagger">
          {trabajos.map((entry, i) => (
            <CaseCard entry={entry} index={String(i + 1).padStart(2, '0')} />
          ))}
        </div>
      </div>
    </section>

    {/* ---------- NOTAS ---------- */}
    <section class="py-[80px] md:py-[110px] border-t border-primary-6">
      <div class="container-site">
        <div class="section-intro section-intro-left mb-8 reveal">
          <div>
            <h2 class="text-[34px] md:text-[42px] font-semibold tracking-tight leading-[1.12]">Notas y <span class="text-primary">escritos.</span></h2>
            <p class="mt-4 text-lg leading-relaxed text-muted-foreground max-w-[560px]">Reflexiones largas sobre medición, reporting y data de marketing.</p>
          </div>
        </div>

        <p class="font-mono text-[13px] tracking-[0.14em] uppercase text-foreground-40">Próximamente</p>
      </div>
    </section>

    {/* ---------- CTA ---------- */}
    <section class="pb-[80px] md:pb-[110px]">
      <div class="container-site max-w-[980px]">
        <div class="cta-texture rounded-xl p-10 md:p-14 text-center reveal">
          <p class="page-head-eyebrow">¿Hablamos?</p>
          <h2 class="mt-4 text-[28px] md:text-[36px] font-semibold tracking-tight leading-[1.15]">
            Si tu equipo necesita ordenar la medición o armar un reporting que escale, escribime.
          </h2>
          <p class="mx-auto mt-4 max-w-[480px] text-base text-muted-foreground">
            La consultoría queda para cuando hay capacidad, pero siempre puedo revisar si tiene sentido.
          </p>
          <div class="flex justify-center gap-3 mt-8 flex-wrap">
            <a href="/contacto" class="btn btn-primary">Escribirme</a>
            <a href="/servicios" class="btn btn-secondary">Ver servicios</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===================== HERO — DASHBOARD PANEL ===================== */
  .hero-dashboard { margin: 0; max-width: 480px; }

  .hero-dashboard-frame {
    position: relative;
    border: 1px solid var(--color-primary-20);
    border-radius: 14px;
    background: var(--color-card);
    box-shadow: 0 24px 60px rgba(21, 96, 189, 0.26), 0 8px 24px rgba(5, 8, 14, 0.5);
    transform: perspective(1400px) rotateY(-6deg) rotateX(1.5deg);
  }
  .hero-dashboard-frame::after {
    position: absolute;
    inset: 0;
    border-radius: 13px;
    box-shadow: inset 0 1px 0 rgba(240, 246, 255, 0.10), inset 0 0 0 1px rgba(240, 246, 255, 0.02);
    content: '';
    pointer-events: none;
  }

  @media (max-width: 1023px) {
    .hero-dashboard { max-width: 460px; }
    .hero-dashboard-frame { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-dashboard-frame { transform: none; }
  }

  /* ===================== CLIENT STRIP ===================== */
  .client-strip {
    display: grid;
    gap: 18px;
    padding: 26px 0 30px;
  }
  .client-strip-label {
    color: var(--color-foreground-55);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .client-strip-logos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .client-strip-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
  }
  .client-strip-logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 28px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.45;
    transition: opacity 0.25s ease;
  }
  .client-strip-logo:hover img { opacity: 0.85; }
  .client-strip-logo--sm img { max-height: 20px; }

  @media (min-width: 768px) {
    .client-strip {
      grid-template-columns: 240px 1fr;
      gap: 0;
      align-items: stretch;
      padding: 34px 0 38px;
    }
    .client-strip-label {
      display: flex;
      align-items: center;
      padding-right: 28px;
      border-right: 1px solid var(--color-primary-14);
    }
    .client-strip-logos {
      display: flex;
      align-items: center;
      gap: 0;
    }
    .client-strip-logo {
      flex: 1;
      min-height: 0;
      padding: 6px 10px;
    }
    .client-strip-logo + .client-strip-logo {
      border-left: 1px solid var(--color-primary-14);
    }
  }

  /* ===================== SERVICIOS — RESUMEN ===================== */
  .service-point {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    padding: 22px 20px;
    border: 1px solid var(--color-primary-10);
    border-radius: 12px;
    background: var(--color-card);
    transition: border-color 0.2s ease;
  }
  .service-point:hover { border-color: var(--color-primary-28); }
  .service-point-num {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    padding-top: 2px;
  }

  .section-intro { display: flex; align-items: end; justify-content: space-between; gap: 32px; }
  .section-intro-product { align-items: start; }
  @media (max-width: 767px) { .section-intro { align-items: start; flex-direction: column; gap: 20px; } }
</style>
