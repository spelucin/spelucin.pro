---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { t } from '../../../i18n/en';
---

<Layout t={t} title="Privacy & Terms · Alex Spelucin" description="What data you share when contacting me, how I use it, and the basic rules of this site. No fine print." noindex>
  <SiteHeader t={t} />
  <main id="main-content">
    <header class="page-head">
      <div class="container-site max-w-[760px]">
        <div class="breadcrumb"><a href="/en/">Home</a><span class="breadcrumb-sep">/</span><span aria-current="page">Privacy &amp; terms</span></div>
        <h1 class="page-head-title">Privacy &amp; Terms</h1>
        <p class="page-head-sub">Clear information about the data you share when contacting me and the basic rules for using this site.</p>
      </div>
    </header>
    <section class="pb-[80px] md:pb-[110px]">
      <div class="container-site max-w-[760px] prose">
        <h2>What data I receive</h2>
        <p>This site uses Google Analytics (via Google Tag Manager) to measure traffic and interactions, such as visits, button clicks, or scheduled calls. These data are aggregated and anonymized: they don't collect your name or contact information. If you email or message me on LinkedIn, you voluntarily share your contact information and the content of your message.</p>
        <h2>How I use it</h2>
        <p>I use this data solely to respond to your message and follow up on the conversation you started. I don't sell data or use it for advertising.</p>
        <h2>Site content</h2>
        <p>The texts and information on spelucin.pro are shared for informative and professional purposes. They do not constitute legal, financial advice or a guarantee of results.</p>
        <h2>Intellectual property</h2>
        <p>The content of this site is the property of Alex Spelucin unless otherwise stated. It may not be reproduced for commercial purposes without permission.</p>
        <h2>Responsible use</h2>
        <p>Do not use this site to send illegal, abusive content or content that infringes third-party rights. If you have doubts, email me at <a href="mailto:alex@spelucin.pro">alex@spelucin.pro</a>.</p>
      </div>
    </section>
  </main>
  <SiteFooter t={t} />
</Layout>