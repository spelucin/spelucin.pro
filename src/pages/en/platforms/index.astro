---
import Layout from '../../../layouts/Layout.astro';
import HubPage from '../../../components/HubPage.astro';
import { t } from '../../../i18n/en';
import { commercialEn } from '../../../i18n/commercial-en';

const hub = commercialEn.platformsHub;
---

<Layout
  t={t}
  title={hub.seo.title}
  description={hub.seo.description}
  breadcrumb={[{ name: 'Platforms', path: '/en/platforms' }]}
>
  <HubPage t={t} hub={hub} location="platforms" />
</Layout>
