---
import Layout from '../../../../layouts/Layout.astro';
import CommercialPage from '../../../../components/CommercialPage.astro';
import { t } from '../../../../i18n/en';
import { commercialEn } from '../../../../i18n/commercial-en';

const page = commercialEn.pages.shopify;
---

<Layout
  t={t}
  title={page.seo.title}
  description={page.seo.description}
  breadcrumb={[{ name: 'Platforms', path: '/en/platforms' }, { name: 'Shopify', path: '/en/platforms/shopify' }]}
>
  <CommercialPage t={t} page={page} />
</Layout>
