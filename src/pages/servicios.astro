---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { Icon } from 'astro-icon/components';

const pains = [
  {
    title: 'Cada cliente tiene un dashboard distinto',
    text: 'Sin un framework estándar, cada reporte se rearma a mano cada mes. El reporting consume el día de los consultores en vez de generar conclusiones.',
  },
  {
    title: 'Meta Ads, CRM y GA4 nunca cuadran',
    text: 'Las plataformas reportan números distintos y nadie sabe cuál métrica creer. El equipo pierde confianza en la data, y el cliente también.',
  },
  {
    title: 'El reporting depende de personas, no de procesos',
    text: 'Si alguien se va, el reporting se cae. Conocimiento tribal, cero documentación y cada cliente nuevo hereda el tracking roto de alguien más.',
  },
];

const phases = [
  {
    number: '01',
    label: 'Auditoría',
    title: 'Diagnóstico de fuentes de datos',
    text: 'Reviso GA4, GSC y las plataformas de marketing para encontrar por qué los números no cuadran. He auditado suficientes cuentas de GA4 como para saber que "la data está bien" casi nunca es cierto.',
    tags: ['GA4', 'GSC', 'Meta Ads', 'CRM'],
    img: '/assets/01.png',
    alt: 'Vista de la auditoría de fuentes de datos',
  },
  {
    number: '02',
    label: 'Corrección',
    title: 'Medición y tagging corregidos',
    text: 'Reviso el tagging, mejoro el event tracking y corrijo la medición de conversiones. Las plataformas no cuadran porque no miden lo mismo, y saber eso es el 80% del problema.',
    tags: ['GTM', 'Event tracking', 'Conversiones'],
    img: '/assets/02.png',
    alt: 'Vista de la medición de eventos y conversiones corregida',
  },
  {
    number: '03',
    label: 'Sistema',
    title: 'Sistema de reporting + documentación',
    text: 'Diseño un framework de reporting con reportes por cliente y un reporte maestro de todas las cuentas, con alertas y anotaciones. Todo documentado, con walkthroughs en Loom para que el equipo lo opere sin depender de mí.',
    tags: ['Looker Studio', 'KPIs estándar', 'Documentación', 'Training'],
    img: '/assets/04.png',
    alt: 'Vista del sistema de reporting y documentación del equipo',
  },
];

const plans = [
  {
    step: '01',
    stepLabel: 'Paso 1 · Base',
    name: 'Analytics Sprint',
    desc: 'Base confiable de analítica para tu agencia. Proyecto fijo de 4-6 semanas.',
    amount: '$1,400',
    period: 'USD · proyecto fijo',
    note: '2 pagos de $700 USD',
    featured: true,
    features: [
      'Auditoría de fuentes de datos (GA4, GSC, plataformas)',
      'Corrección de tagging y medición de conversiones',
      'Sistema de reporting: reportes por cliente + reporte maestro',
      'KPIs estandarizados, alertas y anotaciones',
      'Documentación de analítica y guías de reporting',
      'Training del equipo con walkthroughs en Loom',
    ],
  },
  {
    step: '02',
    stepLabel: 'Paso 2 · Continuidad',
    name: 'Soporte Continuo',
    desc: 'Analítica on-demand, sin contratar un especialista full-time.',
    amount: '$400',
    period: 'USD / mes',
    note: 'requiere Analytics Sprint previo',
    featured: false,
    features: [
      '2 reuniones de analítica por mes',
      'Hasta 20 horas/mes de capacidad',
      'Onboarding de clientes nuevos',
      'Interpretación de data y análisis ad hoc',
      'Ajustes e implementación de tags',
      'Mejoras continuas de reporting',
    ],
  },
];

const faqs = [
  {
    q: '¿Con qué tipo de agencias trabajas?',
    a: 'Con agencias de marketing LATAM (SEO, performance, growth o digital con servicios recurrentes) que tengan 10-40 clientes activos y equipos de 5-20 personas. No es ideal para freelancers, agencias con menos de 5 clientes o quienes solo buscan dashboards baratos.',
  },
  {
    q: '¿Tengo que cambiar mi stack de herramientas?',
    a: 'No. Tu agencia ya paga herramientas; la brecha es saber qué número es confiable, no tener más. Trabajo sobre tu stack actual (GA4, GTM, GSC, Looker Studio, plataformas de ads) y solo propongo cambios cuando el scope realmente lo amerita.',
  },
  {
    q: '¿Qué incluye exactamente el Analytics Sprint?',
    a: 'Cinco componentes: auditoría de fuentes de datos, corrección de tagging y medición de conversiones, sistema de reporting (reportes por cliente + reporte maestro con KPIs estandarizados), documentación completa y training del equipo con walkthroughs en Loom. Duración: 4-6 semanas.',
  },
  {
    q: '¿El Soporte Continuo incluye dashboards o sistemas nuevos?',
    a: 'No. El Soporte cubre operación: reuniones, onboarding de clientes nuevos, interpretación, análisis ad hoc y ajustes de tags. Los sistemas de analítica nuevos, dashboards mayores o migraciones se convierten en Analytics Sprints separados.',
  },
  {
    q: '¿Vendés dashboards sueltos?',
    a: 'No. Un dashboard más no arregla nada; un proceso de reporting sí. Los dashboards vienen como parte del sistema de reporting, nunca como entregables sueltos. La infraestructura técnica es un medio, no el producto.',
  },
];
---

<Layout
  title="Servicios de analítica — Alex Spelucin"
  description="Proyectos de analítica para agencias: auditoría de fuentes, corrección de medición y sistemas de reporting que el equipo puede operar."
>
  <Nav />

  <main id="main-content">
    <header class="page-head">
      <div class="container-site">
        <div class="breadcrumb">
          <a href="/">Inicio</a>
          <span class="breadcrumb-sep">/</span>
          <span aria-current="page">Servicios</span>
        </div>
        <p class="page-head-eyebrow">Servicios</p>
        <h1 class="page-head-title">Proyectos de analítica<br />para agencias</h1>
        <p class="page-head-sub">
          No es el centro de lo que hago, pero cuando hay capacidad armo sistemas de medición y reporting que se pueden operar. Para equipos de marketing que necesitan dejar de confiar en personas y empezar a confiar en procesos.
        </p>
      </div>
    </header>

    <section id="problema" class="py-[80px] md:py-[110px] border-t border-primary-6">
      <div class="container-site">
        <SectionHeader
          eyebrow="Problema"
          title="El reporting manual no es una tarea."
          accent="Es un impuesto que pagas cada mes."
        />
        <div class="max-w-[820px] reveal-stagger">
          {pains.map((pain, i) => (
            <div class="grid grid-cols-[56px_1fr] md:grid-cols-[72px_1fr] gap-5 md:gap-8 py-9 border-t border-primary-14 first:border-t">
              <div class="font-mono text-[15px] text-primary tracking-[0.1em] pt-[6px]">
                {String(i + 1).padStart(2, '0')}
              </div>
              <div>
                <h3 class="text-xl md:text-[24px] font-semibold tracking-tight leading-[1.3] mb-2">{pain.title}</h3>
                <p class="text-base leading-[1.6] text-muted-foreground max-w-[560px]">{pain.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="proceso" class="py-[80px] md:py-[110px] border-t border-primary-6">
      <div class="container-site">
        <SectionHeader
          eyebrow="Proceso"
          title="De la data fragmentada a"
          accent="operaciones que se pueden confiar"
          subtitle="Un proceso que usé en agencias con 10-20 cuentas concurrentes. Tres fases, un resultado: un reporting en el que el equipo confía."
        />
        <div class="max-w-[1040px]">
          {phases.map((phase, i) => (
            <div class={`grid lg:grid-cols-[1fr_1.05fr] gap-10 lg:gap-14 items-center py-12 md:py-16 ${i === 0 ? '' : 'border-t border-primary-14'}`}>
              <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
                <div class="flex items-baseline gap-4 mb-5">
                  <span class="font-mono text-[15px] text-primary tracking-[0.1em]">{phase.number}</span>
                  <span class="font-mono text-[13px] tracking-[0.14em] text-foreground-55 uppercase">{phase.label}</span>
                </div>
                <h3 class="text-[24px] md:text-[28px] font-semibold tracking-tight leading-[1.25] mb-[14px]">{phase.title}</h3>
                <p class="text-base leading-[1.6] text-muted-foreground max-w-[440px]">{phase.text}</p>
                <div class="flex flex-wrap gap-2 mt-[22px]">
                  {phase.tags.map((t) => <span class="tag-pill">{t}</span>)}
                </div>
              </div>
              <figure class={`relative reveal ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
                <div
                  class="absolute -inset-x-6 top-[12%] -bottom-[10%] rounded-full pointer-events-none blur-[42px]"
                  style="background: radial-gradient(circle, rgba(96,165,250,0.14) 0%, transparent 68%);"
                ></div>
                <div class="relative z-[1] rounded-lg border border-primary-14 bg-card shadow-dashboard overflow-hidden transition-transform duration-300 hover:-translate-y-[3px]">
                  <div class="img-ph" style="aspect-ratio: 1448 / 1086; border: none; border-radius: 0;"><span>{phase.img.replace(/^\/assets\//, '')}</span></div>
                  <figcaption class="flex items-center justify-between gap-4 px-5 md:px-6 py-3.5 bg-gradient-to-t from-[#0a0d14] via-[#0a0d14]/70 to-transparent border-t border-primary-8">
                    <span class="font-mono text-[11px] tracking-[0.14em] uppercase text-primary">{phase.label} · {phase.title}</span>
                    <span class="font-mono text-[11px] text-foreground-55 hidden md:inline">{phase.number} / 03</span>
                  </figcaption>
                </div>
              </figure>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="planes" class="py-[80px] md:py-[110px] border-t border-primary-6">
      <div class="container-site">
        <SectionHeader
          eyebrow="Planes"
          title="Primero la base,"
          accent="después la continuidad"
          subtitle="Dos pasos en secuencia, no dos opciones para elegir: primero armamos una base confiable, después la operamos mes a mes."
        />
        <div class="grid md:grid-cols-2 gap-0 md:gap-8 max-w-[960px] reveal-stagger plans-sequence">
          {plans.map((plan) => (
            <article
              class:list={[
                'relative flex flex-col border p-8 md:p-10',
                plan.featured ? 'border-primary-35 bg-card' : 'border-primary-14 bg-card',
              ]}
            >
              <div class="flex items-baseline gap-4 mb-6">
                <span class="font-mono text-[15px] text-primary tracking-[0.1em]">{plan.step}</span>
                <span class="font-mono text-[13px] tracking-[0.14em] text-foreground-55 uppercase">{plan.stepLabel}</span>
              </div>
              <h3 class="text-[22px] font-semibold tracking-tight">{plan.name}</h3>
              <p class="mt-2 text-[15px] leading-[1.55] text-muted-foreground min-h-[46px]">{plan.desc}</p>
              <div class="mt-8 flex items-baseline gap-3">
                <span class="font-mono text-[52px] font-light tracking-tight leading-none">{plan.amount}</span>
                <span class="text-sm text-foreground-55">{plan.period}</span>
              </div>
              <div class="mt-8 h-px bg-primary-10"></div>
              <ul class="mt-8 grid gap-[13px] flex-1">
                {plan.features.map((feature) => (
                  <li class="flex gap-[11px] items-start text-[15px] leading-[1.5] text-foreground-65">
                    <Icon name="tabler:check" width="18" height="18" aria-hidden="true" class="w-[18px] h-[18px] shrink-0 text-primary mt-[2px]" />
                    {feature}
                  </li>
                ))}
              </ul>
              <div class="flex flex-col items-center gap-3 mt-9">
                <a href="/contacto" class={`${plan.featured ? 'btn btn-primary' : 'btn btn-secondary'} w-full`}>Hablar de tu operación</a>
                <div class="font-mono text-xs text-foreground-55">{plan.note}</div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="preguntas" class="py-[80px] md:py-[110px] border-t border-primary-6">
      <div class="container-site">
        <SectionHeader eyebrow="Preguntas" title="Preguntas frecuentes" />
        <div class="max-w-[760px] border-t border-primary-14 reveal-stagger">
          {faqs.map((faq) => (
            <details class="faq-item border-b border-primary-14">
              <summary class="flex items-center justify-between gap-4 py-6 px-1 cursor-pointer text-lg font-medium leading-[1.4] list-none [&::-webkit-details-marker]:hidden">
                {faq.q}
                <span class="faq-chev shrink-0 text-primary transition-transform duration-300">
                  <Icon name="tabler:chevron-down" width="20" height="20" aria-hidden="true" />
                </span>
              </summary>
              <p class="px-1 pb-7 pt-0 text-base leading-[1.65] text-muted-foreground">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contacto" class="py-[80px] md:py-[110px] border-t border-primary-6">
      <div class="container-site">
        <div class="card cta-texture max-w-[980px] p-8 md:p-10 reveal">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
              <p class="font-mono text-[13px] tracking-[0.14em] uppercase text-primary mb-3">Contacto</p>
              <h2 class="text-[22px] font-semibold tracking-tight">Cuéntame dónde se rompe tu reporting hoy.</h2>
              <p class="mt-2 text-[15px] text-foreground-55 max-w-[440px]">
                Escríbeme y veamos si puedo ayudarte a ordenarlo. Sin compromiso.
              </p>
            </div>
            <div class="flex gap-3 flex-wrap shrink-0">
              <a href="/contacto" class="btn btn-primary">Escribirme</a>
              <a href="/portafolio" class="btn btn-secondary">Ver portafolio</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .faq-item[open] .faq-chev { transform: rotate(180deg); }
  .faq-item summary:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .plans-sequence article:first-child {
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
  }
  .plans-sequence article:last-child {
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    border-left: none;
  }
  @media (max-width: 767px) {
    .plans-sequence article {
      border-radius: var(--radius-sm) !important;
      border-left: 1px solid var(--color-primary-14) !important;
    }
    .plans-sequence article + article { margin-top: 20px; }
  }
</style>
