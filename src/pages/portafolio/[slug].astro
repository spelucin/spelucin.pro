---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import VisualPanel from '../../components/VisualPanel.astro';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const trabajos = (await getCollection('trabajos')).filter((entry) => entry.data.published);
  return trabajos.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const path = `/portafolio/${entry.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  author: { '@type': 'Person', name: site.name },
  publisher: { '@type': 'Person', name: site.name },
  datePublished: data.year ? `${data.year}-01-01` : undefined,
  mainEntityOfPage: `${site.url}${path}`,
};
---

<Layout
  title={`${data.title} — Alex Spelucin`}
  description={data.description}
  canonical={`${site.url}${path}`}
  type="article"
>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Nav />

  <main id="main-content">
    <header class="page-head pb-10">
      <div class="container-site max-w-[880px]">
        <div class="breadcrumb">
          <a href="/">Inicio</a>
          <span class="breadcrumb-sep">/</span>
          <a href="/portafolio/">Portafolio</a>
          <span class="breadcrumb-sep">/</span>
          <span aria-current="page">{data.title}</span>
        </div>
        <div class="flex items-center gap-3 flex-wrap mb-5">
          <span class="font-mono text-[13px] text-primary tracking-[0.1em] uppercase">{data.category}</span>
          {data.year && (
            <>
              <span class="w-1 h-1 rounded-full bg-primary-35"></span>
              <span class="font-mono text-[12px] tracking-[0.1em] uppercase text-foreground-55">{data.year}</span>
            </>
          )}
          {data.scope && (
            <>
              <span class="w-1 h-1 rounded-full bg-primary-35"></span>
              <span class="font-mono text-[12px] tracking-[0.1em] uppercase text-foreground-55">{data.scope}</span>
            </>
          )}
        </div>
        <h1 class="page-head-title">{data.title}</h1>
        <p class="page-head-sub">{data.description}</p>
      </div>
    </header>

    <section class="pb-[80px] md:pb-[110px]">
      <div class="container-site max-w-[880px]">
        {data.gallery[0] && (
          <figure class="relative mb-12 reveal">
            <div
              class="absolute -inset-x-6 top-[12%] -bottom-[10%] rounded-full pointer-events-none blur-[42px]"
              style="background: radial-gradient(circle, rgba(96,165,250,0.14) 0%, transparent 68%);"
            ></div>
            <div class="relative z-[1] h-[240px] md:h-[420px]">
              <VisualPanel src={data.image ?? '/assets/dashboard-mock-card.jpg'} alt={`Vista de ${data.title}`} label={data.gallery[0].label} />
            </div>
            <figcaption class="relative z-[1] mt-3 flex items-center justify-between gap-4 font-mono text-[11px] tracking-[0.14em] uppercase">
              <span class="text-primary">{data.gallery[0].label}</span>
              <span class="text-foreground-55 hidden md:inline">Vista del sistema</span>
            </figcaption>
          </figure>
        )}

        <div class="prose reveal">
          <Content />
        </div>

        {data.results.length > 0 && (
          <div class="mt-12 reveal">
            <div class="grid md:grid-cols-3 gap-4">
              {data.results.map((r) => (
                <div class="card p-6">
                  <strong class="block text-[26px] font-light font-mono text-primary tracking-[-0.03em]">{r.value}</strong>
                  <span class="block mt-2 text-[14px] text-foreground-55">{r.label}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {data.lessons.length > 0 && (
          <div class="mt-12 reveal">
            <h2 class="detail-section-title">Aprendizajes</h2>
            <ul class="mt-5 grid gap-3">
              {data.lessons.map((lesson) => (
                <li class="flex items-start gap-3 text-[15px] leading-[1.6] text-foreground-65">
                  <Icon name="tabler:check" width="16" height="16" aria-hidden="true" class="w-[16px] h-[16px] text-primary shrink-0 mt-[5px]" />
                  {lesson}
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="mt-12 reveal">
          <h2 class="detail-section-title">Herramientas</h2>
          <div class="flex flex-wrap gap-2 mt-4">
            {data.tools.map((tool) => <span class="tag-pill">{tool}</span>)}
          </div>
        </div>

        <aside class="mt-16 p-8 md:p-10 rounded-xl border border-primary-20 bg-primary-4 reveal">
          <h2 class="text-[22px] font-semibold tracking-tight">¿Querés un sistema así para tu equipo?</h2>
          <p class="mt-3 text-[15px] leading-[1.6] text-foreground-55 max-w-[520px]">
            Proyectos similares se hacen como Analytics Sprint. También estoy desarrollando productos de reporting listos para usar.
          </p>
          <div class="flex flex-wrap gap-3 mt-7">
            <a href="/contacto" class="btn btn-primary btn-sm">Escribime</a>
            <a href="/productos" class="btn btn-secondary btn-sm">Ver productos</a>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .detail-section-title { padding-top: 16px; border-top: 1px solid var(--color-primary-14); font-size: 24px; font-weight: 600; letter-spacing: -0.02em; }
</style>
