---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection } from 'astro:content';

const productos = (await getCollection('productos'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Productos de analítica — Alex Spelucin"
  description="Templates, dashboards y frameworks de analítica para problemas concretos de medición y reporting. Cada producto se lanza cuando está realmente listo."
>
  <Nav />

  <main id="main-content">
    <header class="page-head">
      <div class="container-site">
        <div class="breadcrumb">
          <a href="/">Inicio</a>
          <span class="breadcrumb-sep">/</span>
          <span aria-current="page">Productos</span>
        </div>
        <p class="page-head-eyebrow">Productos</p>
        <h1 class="page-head-title">Templates y frameworks<br />para equipos con data.</h1>
        <p class="page-head-sub">
          No son dashboards de adorno. Son herramientas pensadas para resolver un problema real: medición confiable, reporting repetible y decisiones mejor informadas.
        </p>
      </div>
    </header>

    <section class="pb-[80px] md:pb-[110px]">
      <div class="container-site">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">
          {productos.map((entry) => (
            <ProductCard entry={entry} />
          ))}
        </div>

        <div class="mt-14 card cta-texture p-8 md:p-10 reveal">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
              <h2 class="text-[22px] font-semibold tracking-tight">¿Falta un producto que tu equipo necesita?</h2>
              <p class="mt-2 text-[15px] text-foreground-55 max-w-[460px]">
                Si necesitás un sistema de reporting específico, escribime y vemos cómo resolverlo.
              </p>
            </div>
            <a href="/contacto" class="btn btn-primary shrink-0">Proponer un producto</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
