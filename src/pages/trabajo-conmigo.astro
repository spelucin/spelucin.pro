---
import Base from '../layouts/Base.astro';
import SidebarLayout from '../layouts/SidebarLayout.astro';
import Footer from '../components/Footer.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonial from '../components/Testimonial.astro';
import { services } from '../data';

const testimonials = [
  {
    quote:
      'Alex es un profesional SEO con gran conocimiento técnico y sentido crítico. Tuvimos la oportunidad de optimizar un sitio enfocado en una vertical complicada como lo es banca. Se enfoca en las necesidades del negocio y en conjunto desarrollamos una estrategia de posicionamiento orgánico efectiva.',
    name: 'Miguel Huahuala',
    role: 'Content Lead',
    company: 'Scotiabank',
  },
  {
    quote:
      'Alex tiene un gran manejo y análisis SEO orientado a los resultados en posicionamiento. Así mismo, su compromiso y orientación al servicio nos dio seguridad en cada etapa del proyecto.',
    name: 'Alexis Pinedo',
    role: 'Product Manager',
    company: 'LeaseIn',
  }
];

// Related articles slug mapping for learn more links
const serviceArticles: Record<string, string> = {
  'auditoria-seo-tecnica': 'auditoria-seo-tecnico-framework',
  'estrategia-de-catalogo': 'estructura-catalogo-shopify',
  'talleres-y-capacitaciones': 'ai-search-seo-tecnico',
};
---

<Base
  title="Trabaja Conmigo - Alex Spelucin"
  description="Consultoría de SEO técnico y estrategia de catálogo para marcas de ecommerce en Shopify."
>
  <SidebarLayout>
    <main class="work-with-me-main">
      <div class="content-container">
        
        {/* Intro */}
        <section class="section-intro reveal">
          <span class="eyebrow">Trabaja conmigo</span>
          <h1 class="page-title">Hagamos que tu tienda Shopify venda más</h1>
          <p class="lead-text">
            Ayudo a marcas de comercio electrónico a resolver problemas complejos de indexación, rastreo, rendimiento y arquitectura de catálogo. Sin retainers mensuales indefinidos ni informes automatizados. Proyectos con objetivos, plazos y entregables claros.
          </p>
        </section>

        {/* Services Grid */}
        <section class="section-services">
          <h2 class="section-heading reveal">Servicios editoriales</h2>
          <div class="services-grid">
            {services.map((service) => (
              <ServiceCard
                slug={service.slug}
                name={service.name}
                price={service.price}
                description={service.description}
                deliverables={service.deliverables}
                learnMoreSlug={serviceArticles[service.slug]}
              />
            ))}
          </div>
        </section>

        {/* Testimonials */}
        <section class="section-testimonials">
          <h2 class="section-heading reveal">Resultados validados</h2>
          <div class="testimonials-flow">
            {testimonials.map((t) => (
              <Testimonial
                quote={t.quote}
                name={t.name}
                role={t.role}
                company={t.company}
              />
            ))}
          </div>
        </section>

        {/* Consultation Call details */}
        <section class="section-process reveal">
          <h2 class="section-heading">¿Qué pasa en nuestra primera llamada?</h2>
          <p class="process-intro">
            Antes de comenzar cualquier proyecto, agendamos una sesión de diagnóstico gratuita de 30 a 45 minutos para entender si soy la persona adecuada para ayudarte.
          </p>
          
          <div class="process-steps-grid">
            <div class="process-step">
              <div class="step-num">01</div>
              <h3 class="step-title">Entender tus metas</h3>
              <p class="step-desc">Analizamos la situación comercial de tu tienda, tus objetivos de tráfico y los cuellos de botella actuales.</p>
            </div>
            <div class="process-step">
              <div class="step-num">02</div>
              <h3 class="step-title">Discutir desafíos</h3>
              <p class="step-desc">Identificamos qué problemas técnicos sospechas o has detectado que están frenando tu crecimiento orgánico.</p>
            </div>
            <div class="process-step">
              <div class="step-num">03</div>
              <h3 class="step-title">Determinar fit</h3>
              <p class="step-desc">Evaluamos honestamente si mi especialidad encaja con tus necesidades. Si no es así, te recomendaré con quién ir.</p>
            </div>
            <div class="process-step">
              <div class="step-num">04</div>
              <h3 class="step-title">Planificar siguientes pasos</h3>
              <p class="step-desc">Si decidimos trabajar juntos, definimos el alcance preliminar del proyecto y plazos de entrega.</p>
            </div>
          </div>
        </section>

        {/* Calendar Embed */}
        <section class="section-calendar reveal" id="agenda">
          <h2 class="section-heading">Reserva una sesión de diagnóstico</h2>
          <p class="calendar-subtitle">
            Elige una fecha y hora en el calendario para conversar directamente sobre tu proyecto de Shopify.
          </p>

          <div class="calendar-embed-wrapper">
            <!-- Cal.com embed placeholder - customizable by the user -->
            <iframe 
              src="https://cal.com/spelucin/30min?embed=true" 
              style="width: 100%; height: 100%; border: none; border-radius: 0.5rem;"
              title="Calendario de reserva"
            ></iframe>
          </div>
        </section>

      </div>
      <Footer />
    </main>
  </SidebarLayout>
</Base>

<style is:global>
  .work-with-me-main {
    background: var(--color-background);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .content-container {
    max-width: 52rem;
    width: 100%;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
    flex-grow: 1;
  }

  .section-intro {
    margin-bottom: 4rem;
  }
  .page-title {
    font-size: clamp(2.25rem, 5.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-foreground);
    margin: 0.75rem 0 1.5rem;
  }
  .lead-text {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-prose-muted);
    max-width: 48rem;
  }

  .section-heading {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    margin-bottom: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-services {
    margin-bottom: 4rem;
  }
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .section-testimonials {
    margin-bottom: 4rem;
  }
  .testimonials-flow {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .section-process {
    margin-bottom: 5rem;
  }
  .process-intro {
    font-size: 0.9375rem;
    color: var(--color-prose);
    line-height: 1.65;
    margin-bottom: 2rem;
  }
  .process-steps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .process-step {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .step-num {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }
  .step-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-foreground);
  }
  .step-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-prose-muted);
    margin: 0;
  }

  .section-calendar {
    margin-bottom: 3rem;
  }
  .calendar-subtitle {
    font-size: 0.875rem;
    color: var(--color-prose-muted);
    margin-bottom: 1.5rem;
  }
  .calendar-embed-wrapper {
    height: 600px;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    overflow: hidden;
  }

  @media (max-width: 1023px) {
    .content-container {
      padding-top: 4rem;
    }
  }

  @media (max-width: 767px) {
    .process-steps-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
