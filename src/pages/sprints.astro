---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import IconArrowRight from '../components/IconArrowRight.astro';
import Terminal from '../components/Terminal.astro';
import { Icon } from 'astro-icon/components';
import { rule } from '../data';
import { getPageMeta } from '../lib/content';
import FaqSection from '../components/FaqSection.astro';

const meta = await getPageMeta('sprints');
const W = "max-w-5xl mx-auto px-6";

const sprintsFaqs = [
  {
    question: "¿Cuál es la diferencia entre un Sprint y un servicio?",
    answer:
      "Un Sprint combina varios servicios en un solo proyecto, con un entregable unificado y un plan de acción priorizado. Los servicios individuales existen por separado si solo necesitas una evaluación específica.",
  },
  {
    question: "¿Puedo contratar un Sprint si ya compré un servicio por separado?",
    answer:
      "Sí. Si ya tienes una auditoría técnica y necesitas la estrategia de catálogo, o viceversa, el Sprint complementa lo que ya tienes y unifica todo en un solo plan de acción.",
  },
  {
    question: "¿Cuánto dura cada Sprint?",
    answer:
      "Depende del alcance. El Shopify SEO Sprint dura aproximadamente una semana. El Sprint Tiendas Nuevas toma entre 8 y 12 días hábiles. En la llamada inicial confirmamos el plazo exacto.",
  },
  {
    question: "¿Los Sprints incluyen implementación?",
    answer:
      "No. El entregable es estratégico: informes y planes listos para implementar. La implementación la realiza tu equipo o tu desarrollador. Si necesitas ayuda con eso, podemos cotizarlo por separado.",
  },
  {
    question: "¿Qué pasa si no sé cuál Sprint necesito?",
    answer:
      "Agenda una llamada gratuita de 30 minutos. Evaluamos tu situación y te recomendamos el proyecto adecuado sin compromiso.",
  },
];

const sprints = [
  {
    slug: "shopify-seo-sprint",
    badge: "Oferta de lanzamiento",
    icon: "ph:target",
    title: "Shopify SEO Sprint",
    description:
      "Un proyecto de una semana que combina una Auditoría SEO Técnica y una Estrategia de Catálogo en un plan de acción para tu tienda Shopify.",
    price: "$500 USD",
    cta: "Ver Sprint",
    href: "/sprints/shopify-seo-sprint/",
  },
  {
    slug: "tiendas-nuevas",
    badge: null,
    icon: "ph:storefront",
    title: "Tiendas Nuevas",
    description:
      "Lanza tu tienda Shopify con una base SEO sólida desde el día uno: arquitectura de información, estructura de colecciones y mejores prácticas técnicas.",
    price: "$900 USD",
    cta: "Ver Sprint",
    href: "/sprints/tiendas-nuevas/",
  },
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Sprints de SEO para Shopify",
  description:
    "Proyectos cortos, con alcance definido y entregables claros para tiendas Shopify.",
};
---

<Base
  title={meta.title}
  description={meta.description}
  image={meta.image}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>
  <Nav />
  <main>
    <section style="padding-top: 10rem; padding-bottom: 4rem; background: #fff">
      <div class={`${W} reveal`}>
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 3.5rem">
          <div style="flex: 1; height: 1px; background: rgba(21,96,189,0.10)" />
          <Eyebrow>Sprints</Eyebrow>
        </div>

        <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.04em; color: #0d1f3c; margin: 0 0 1.5rem; max-width: 20ch">
          Sprints de SEO hechos para priorizar lo que cambiará a tu tienda
        </h1>
        <p style="font-size: 1.1rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0 0 1.5rem; max-width: 52ch">
          Proyectos cortos para resolver problemas concretos de SEO en Shopify. Diagnóstico claro, prioridades concretas y trabajo implementable.
        </p>
      </div>
    </section>

    <section style="background: #fff; padding: 0 0 6rem">
      <div class={`${W} reveal`}>
        <div style={rule} />

        <div class="grid md:grid-cols-2 gap-6" style="padding-top: 3rem">
          {sprints.map((s) => (
            <a
              href={s.href}
              class="service-card sprints-index-card"
              style="text-decoration: none; display: flex; flex-direction: column; padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid rgba(21,96,189,0.10); background: var(--color-surface); transition: transform 0.2s, box-shadow 0.2s"
            >
              <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1.25rem">
                <div class="sprint-index-icon">
                  <Icon name={s.icon} width={26} height={26} />
                </div>
                {s.badge && (
                  <span style="font-size: 0.68rem; font-weight: 700; color: #1560bd; background: rgba(21,96,189,0.08); padding: 0.3rem 0.7rem; border-radius: 999px; letter-spacing: 0.04em; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.3rem">
                    <span style="width: 5px; height: 5px; border-radius: 50%; background: #1560bd; box-shadow: 0 0 5px rgba(21,96,189,0.5)" />
                    {s.badge}
                  </span>
                )}
              </div>
              <div style="font-size: 0.72rem; font-weight: 700; color: #1560bd; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.35rem">
                {s.price}
              </div>
              <h2 style="font-size: 1.25rem; font-weight: 700; color: #0d1f3c; letter-spacing: -0.025em; margin: 0 0 0.75rem; line-height: 1.25">
                {s.title}
              </h2>
              <p style="font-size: 0.875rem; color: rgba(13,31,60,0.55); line-height: 1.65; margin: 0 0 1.5rem; flex: 1">
                {s.description}
              </p>
              <span style="display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; font-weight: 600; color: #1560bd">
                {s.cta} <IconArrowRight />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ── Services promo ──────────────────────────────── */}
    <section style="background: #fff; padding: 0 0 4rem">
      <div class={`${W} reveal`}>
        <div style={rule} />
        <div class="promo-strip">
          <div>
            <p style="font-size: 0.9375rem; line-height: 1.7; color: rgba(13,31,60,0.65); margin: 0; max-width: 45ch">
              ¿Necesitas solo una evaluación específica? Los <strong>servicios individuales</strong> están disponibles por separado si tu caso requiere un diagnóstico más acotado.
            </p>
          </div>
          <a href="/servicios/" class="btn btn-primary">
            Ver servicios <IconArrowRight />
          </a>
        </div>
      </div>
    </section>

    {/* ── CLI animation ──────────────────────────────── */}
    <section style="background: #fff; padding: 2.5rem 0 1.5rem">
      <div class={`${W}`}>
        <Terminal title="zsh - shopify-seo" fullwidth>
          <div class="terminal-body">
            <p class="term-line term-delay-1"><span class="term-prompt">$</span> opencode sprint --audit --catalog --site=gunplastore.mx</p>
            <p class="term-line term-delay-2"><span class="term-spinner"></span> Inicializando crawler de Shopify...</p>
            <p class="term-line term-delay-3"><span class="term-bar">[██████████████████████]</span> <span class="term-pct">100%</span></p>
            <p class="term-line term-delay-4"><span class="term-warning">[warning]</span> 142 páginas de tag duplicadas detectadas</p>
            <p class="term-line term-delay-5"><span class="term-success">[success]</span> Core Web Vitals audit: LCP 2.1s · CLS 0.02</p>
            <p class="term-line term-delay-6"><span class="term-prompt">$</span> opencode cluster --vertical="model-kits" --strategy</p>
            <p class="term-line term-delay-7"><span class="term-spinner"></span> Agrupando intención de búsqueda...</p>
            <p class="term-line term-delay-8"><span class="term-success">[success]</span> Jerarquía de 3 niveles generada · 248 colecciones</p>
            <p class="term-line term-delay-9"><span class="term-info">[info]</span> Consolidación de contenido: 34 páginas delgadas</p>
            <p class="term-line term-delay-10"><span class="term-prompt">$</span> opencode plan --merge</p>
            <p class="term-line term-delay-11"><span class="term-spinner"></span> Unificando hallazgos técnicos + estratégicos...</p>
            <p class="term-line term-delay-12"><span class="term-success">[success]</span> Plan priorizado a 90 días generado</p>
            <p class="term-line term-delay-13"><span class="term-success">[success]</span> Sesión de revisión agendada.</p>
          </div>
        </Terminal>
      </div>
    </section>

    {/* ── FAQ ──────────────────────────────────────── */}
    <FaqSection faqs={sprintsFaqs} tone="surface" />

    <CTA
      id="cta"
      heading="¿No sabes qué necesita tu tienda?"
      description="En 30 minutos evaluamos tu situación y te recomendamos el siguiente paso."
      buttonText="Agendar una llamada"
    />
  </main>
  <Footer />
</Base>

<style is="global">
  .sprints-index-card { border-radius: var(--radius-md) !important; }
  .sprint-index-icon { color: var(--color-primary); }
</style>
