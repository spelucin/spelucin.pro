---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { t } from '../i18n/es';
---

<Layout t={t} title="Términos · Alex Spelucin" description="Las reglas básicas para usar este sitio y consultar sus contenidos." noindex>
  <SiteHeader t={t} />
  <main id="main-content">
    <header class="page-head">
      <div class="container-site max-w-[760px]">
        <div class="breadcrumb"><a href="/">Inicio</a><span class="breadcrumb-sep">/</span><span aria-current="page">Términos</span></div>
        <h1 class="page-head-title">Términos de uso</h1>
        <p class="page-head-sub">Las reglas básicas para usar este sitio y consultar sus contenidos.</p>
      </div>
    </header>
    <section class="pb-[80px] md:pb-[110px]">
      <div class="container-site max-w-[760px] prose">
        <h2>Contenido del sitio</h2>
        <p>Los textos e información de spelucin.pro se comparten con fines informativos y profesionales. No constituyen asesoría legal, financiera ni una garantía de resultados.</p>
        <h2>Propiedad intelectual</h2>
        <p>El contenido de este sitio es propiedad de Alex Spelucin salvo que se indique lo contrario. No puede reproducirse con fines comerciales sin permiso.</p>
        <h2>Uso responsable</h2>
        <p>No uses este sitio para enviar contenido ilegal, abusivo o que infrinja derechos de terceros. Si tienes dudas, escríbeme a <a href="mailto:alex@spelucin.pro">alex@spelucin.pro</a>.</p>
      </div>
    </section>
  </main>
  <SiteFooter t={t} />
</Layout>