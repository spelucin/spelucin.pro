---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import CTA from '../../components/CTA.astro';
import IconArrowRight from '../../components/IconArrowRight.astro';
import ServiceReportMockup from '../../components/ServiceReportMockup.astro';
import { rule } from '../../data';
import { getPageMeta } from '../../lib/content';

const meta = await getPageMeta('tiendas-nuevas');
const W = "max-w-5xl mx-auto px-6";

const faqs = [
  {
    question: "¿Cuándo debo contratar este pack?",
    answer: "Idealmente 4 a 6 semanas antes del lanzamiento. Así la arquitectura está lista cuando tu tienda empiece a recibir tráfico y Google comience a rastrear. Si ya lanzaste pero tienes poco contenido y mala estructura, también funciona — el cambio es más barato ahora que con 10,000 URLs indexadas.",
  },
  {
    question: "¿Necesito tener los productos cargados?",
    answer: "No necesariamente. Trabajamos con tu catálogo planificado (incluso en una planilla) para definir la jerarquía y las URLs. Si ya tienes productos cargados, mejor — analizamos la estructura actual y proponemos la versión optimizada.",
  },
  {
    question: "¿El pack incluye la implementación en Shopify?",
    answer: "No. El entregable es el plan documentado: jerarquía de colecciones, estructura de URLs, contenido de cada colección y mapa de enlaces internos. La implementación la hace tu equipo o tu desarrollador. Si necesitas ayuda con eso, podemos cotizarlo aparte.",
  },
  {
    question: "¿Cuánto tiempo toma?",
    answer: "Entre 8 y 12 días hábiles, según la cantidad de categorías. Tiendas con menos de 20 colecciones principales suelen estar listas en 8 días.",
  },
  {
    question: "¿Funciona para tiendas multiidioma?",
    answer: "Sí, pero el alcance depende de la cantidad de mercados. Lo definimos en la llamada inicial para cotizar correctamente.",
  },
];

const processSteps = [
  {
    title: "Llamada de diagnóstico (30 min)",
    description: "Entendemos tu vertical, los competidores, los productos que vas a vender y el estado actual de tu tienda.",
  },
  {
    title: "Análisis de mercado y keywords",
    description: "Investigamos cómo buscan tus clientes potenciales, analizamos competidores y mapeamos la demanda real para tu vertical.",
  },
  {
    title: "Arquitectura + contenidos",
    description: "Diseñamos la jerarquía de colecciones, estructura de URLs, plan de facetas, contenido optimizado para cada colección y mapa de enlaces internos.",
  },
  {
    title: "Revisión y entrega",
    description: "Recibes el plan completo y agendamos una sesión para revisar la propuesta, resolver dudas de implementación y asegurar que todo quede claro para tu equipo.",
  },
];

const pains = [
  "Armas las colecciones con los nombres que usas internamente, no los que escribe tu cliente en Google",
  "Las URLs quedan generadas automáticamente sin una estructura pensada para SEO",
  "Las colecciones no tienen contenido — solo un grid de productos sin contexto para Google",
  "No hay un plan de enlaces internos que distribuya autoridad hacia tus páginas más importantes",
];

const deliverableCards = [
  { eyebrow: "INVESTIGACIÓN", title: "Keyword research vertical", description: "Análisis completo de demanda real para tu categoría. Volúmenes, intención de búsqueda y oportunidades que tu tienda no está aprovechando.", tag: "Documento vivo" },
  { eyebrow: "ANÁLISIS", title: "Análisis de competidores", description: "Benchmarking de estructura, naming y posicionamiento de competidores clave en tu vertical. Sabes contra quién compites y cómo diferenciarte.", tag: "Insights accionables" },
  { eyebrow: "ESTRUCTURA", title: "Jerarquía de colecciones y subcolecciones", description: "Mapa documentado de categorías, relaciones semánticas y naming optimizado para que Google entienda tu catálogo desde el primer crawl.", tag: "Figma + CSV" },
  { eyebrow: "URLS", title: "Estructura de URLs y naming", description: "Reglas de URLs, manejo de facetas y filtros para evitar duplicación masiva y maximizar la indexación de tus páginas importantes.", tag: "Plan de implementación" },
  { eyebrow: "CONTENIDOS", title: "Contenido de colecciones", description: "Título, descripción y metadata optimizada para cada colección. Listo para implementar directo en Shopify.", tag: "Copy + SEO" },
  { eyebrow: "ENLACES", title: "Plan de enlaces internos", description: "Mapa de enlaces internos que distribuye autoridad hacia tus páginas de mayor potencial comercial.", tag: "Arquitectura" },
  { eyebrow: "SESIÓN", title: "Sesión de revisión", description: "Reunión para validar la propuesta, resolver dudas de implementación y alinear a tu equipo técnico.", tag: "Videollamada" },
];

const idealCards = [
  "Estás armando tu catálogo en Shopify y quieres que la estructura esté optimizada desde el primer día",
  "Tienes productos cargados pero la tienda todavía no está en vivo",
  "Migraste de otra plataforma y quieres aprovechar para reestructurar bien",
  "Vas a expandir tu catálogo con nuevas categorías y necesitas una base sólida",
  "Quieres evitar el trabajo de reestructurar después de tener miles de URLs",
  "No sabes cómo nombrar las colecciones para que Google las entienda",
  "Los filtros de tu tienda generan páginas duplicadas sin que lo sepas",
  "Necesitas un plan de enlaces internos antes del lanzamiento",
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Pack Tiendas Nuevas",
  name: "Pack Tiendas Nuevas",
  description: "Arquitectura de catálogo y contenidos para tiendas Shopify que están por lanzar. Keyword research, jerarquía de colecciones, estructura de URLs y contenido optimizado.",
  provider: {
    "@type": "ProfessionalService",
    name: "Alex Spelucin",
    email: "alex@spelucin.pro",
  },
  areaServed: ["MX", "AR", "US", "ES"],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(f => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Base
  title={meta.title}
  description={meta.description}
  image={meta.image}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <Nav />
  <div style="background: #fff">

    {/* ── Hero ──────────────────────────────────────── */}
    <section style="padding-top: 10rem; padding-bottom: 0">
      <div class={`${W} reveal`}>
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 3.5rem">
          <a href="/sprints/" style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(21,96,189,0.45); text-decoration: none; text-transform: uppercase">
            <span style="transform: rotate(180deg); display: inline-block"><IconArrowRight /></span> Sprints
          </a>
          <div style="flex: 1; height: 1px; background: rgba(21,96,189,0.10)" />
          <Eyebrow>Tiendas nuevas</Eyebrow>
        </div>

        <h1 style="font-size: clamp(2.25rem, 5.5vw, 4rem); font-weight: 700; line-height: 1.04; letter-spacing: -0.04em; color: #0d1f3c; margin: 0 0 1.5rem; max-width: 22ch">
          Tu tienda merece la estructura correcta desde el día uno
        </h1>
        <p style="font-size: 1.1rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0 0 2.5rem; max-width: 52ch">
          Arquitectura de catálogo y contenidos optimizados para que Google entienda tu tienda desde el primer crawl. Sin tener que reestructurar todo después.
        </p>
        <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 4rem">
          <Button href="/contacto/">
            Agendar llamada gratuita <IconArrowRight />
          </Button>
          <span style="display: inline-flex; align-items: center; gap: 0.6rem">
            <span style="font-size: 0.875rem; font-weight: 500; color: rgba(13,31,60,0.35); text-decoration: line-through">$1,400 USD</span>
            <span style="font-size: 0.875rem; font-weight: 700; color: #1560bd">$900 USD</span>
          </span>
        </div>
        <div style={rule} />
      </div>
    </section>

    {/* ── El problema ─────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <div class="grid md:grid-cols-12 gap-8">
          <div style="grid-column: span 4">
            <Eyebrow>El problema</Eyebrow>
            <h2 style="font-size: clamp(1.35rem, 2.5vw, 1.65rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 0; line-height: 1.25">
              La mayoría de tiendas nuevas arrancan con la estructura mal hecha
            </h2>
          </div>
          <div style="grid-column: span 8">
            {pains.map((pain, i) => (
              <div>
                <div style="display: flex; gap: 1rem; padding-top: 1.25rem; padding-bottom: 1.25rem">
                  <span style="font-size: 0.7rem; font-weight: 700; color: rgba(21,96,189,0.4); flex-shrink: 0; padding-top: 0.15rem; font-variant-numeric: tabular-nums">0{i + 1}</span>
                  <p style="font-size: 0.9375rem; line-height: 1.7; color: rgba(13,31,60,0.7); margin: 0">{pain}</p>
                </div>
                {i < pains.length - 1 && <div style={rule} />}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── Qué incluye ─────────────────────────────── */}
    <section style="padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Qué incluye</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3rem; line-height: 1.2">
          Todo lo que necesitas para lanzar con la estructura correcta
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {deliverableCards.map((card) => (
            <div style="border: 1px solid rgba(21,96,189,0.08); border-radius: 0.75rem; padding: 2rem; transition: border-color 0.2s ease;">
              <div style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(21,96,189,0.5); margin-bottom: 0.75rem">{card.eyebrow}</div>
              <h3 style="font-size: 1.1rem; font-weight: 700; color: #0d1f3c; margin: 0 0 0.5rem; letter-spacing: -0.02em; line-height: 1.3">{card.title}</h3>
              <p style="font-size: 0.875rem; line-height: 1.65; color: rgba(13,31,60,0.55); margin: 0 0 1.25rem">{card.description}</p>
              <span style="font-size: 0.75rem; font-weight: 600; color: rgba(21,96,189,0.4)">{card.tag}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Para quién es ──────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Para quién es</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3rem; line-height: 1.2">
          Ideal para tiendas que están por lanzar o acaban de hacerlo
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {idealCards.map((sit) => (
            <div style="border: 1px solid rgba(21,96,189,0.08); border-radius: 0.75rem; padding: 1.5rem 2rem; transition: border-color 0.2s ease;">
              <p style="font-size: 0.9375rem; line-height: 1.65; color: rgba(13,31,60,0.7); margin: 0">{sit}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Proceso ────────────────────────────────── */}
    <section style="padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Proceso</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3.5rem; line-height: 1.2">
          Cómo funciona
        </h2>

        <div class="grid md:grid-cols-12 gap-10 items-start">
          <div style="grid-column: span 7">
            {processSteps.map((step, i, arr) => (
              <div style={`display: grid; grid-template-columns: 3rem 1fr; gap: 1.5rem; padding: 1.75rem 0 ${i < arr.length - 1 ? '1.75rem' : '0'}; ${i < arr.length - 1 ? 'border-bottom: 1px solid rgba(21,96,189,0.06)' : ''}`}>
                <span style="font-size: 0.8rem; font-weight: 700; color: rgba(21,96,189,0.35); font-variant-numeric: tabular-nums; padding-top: 0.15rem; letter-spacing: 0.02em">0{i + 1}</span>
                <div>
                  <h3 style="font-size: 1.05rem; font-weight: 700; color: #0d1f3c; margin: 0 0 0.5rem; letter-spacing: -0.02em">{step.title}</h3>
                  <p style="font-size: 0.9rem; line-height: 1.7; color: rgba(13,31,60,0.6); margin: 0; max-width: 52ch">{step.description}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="process-sticky" style="grid-column: span 5;">
            <ServiceReportMockup variant="tiendas-nuevas" />
          </div>
        </div>
      </div>
    </section>

    {/* ── FAQ ────────────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <div style={rule} />
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 3.5rem 0 2.5rem; line-height: 1.2">
          Preguntas frecuentes
        </h2>
        <div style="display: flex; flex-direction: column; gap: 0">
          {faqs.map((item, i) => (
            <>
              {i > 0 && <div style="height: 1px; background: rgba(21,96,189,0.07)" />}
              <div style="padding: 1.5rem 0">
                <div style="font-size: 0.95rem; font-weight: 600; color: #0d1f3c; line-height: 1.4; margin-bottom: 0.5rem">{item.question}</div>
                <p style="font-size: 0.9rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0">{item.answer}</p>
              </div>
            </>
          ))}
        </div>
      </div>
    </section>

    {/* ── CTA ────────────────────────────────────── */}
    <CTA
      id="cta"
      heading="Arranca con la estructura correcta"
      description="Llamada gratuita de 30 minutos. Evaluamos tu catálogo y te proponemos el camino."
      buttonText="Agendar llamada"
    />

  </div>
  <Footer />
</Base>
