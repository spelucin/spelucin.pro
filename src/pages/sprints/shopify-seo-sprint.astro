---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import CTA from '../../components/CTA.astro';
import IconArrowRight from '../../components/IconArrowRight.astro';
import ServiceReportMockup from '../../components/ServiceReportMockup.astro';
import { rule } from '../../data';
import { getPageMeta } from '../../lib/content';

const meta = await getPageMeta('shopify-seo-sprint');
const W = "max-w-5xl mx-auto px-6";

const faqs = [
  {
    question: "¿Qué incluye exactamente el Shopify SEO Sprint?",
    answer: "Combina una Auditoría SEO Técnica con una Estrategia de Catálogo en un solo engagement. Recibes un informe técnico completo, un plan de contenido y arquitectura, un roadmap priorizado a 90 días, recomendaciones de consolidación de contenido y una sesión de strategy walkthrough de 60 minutos.",
  },
  {
    question: "¿Para qué tipo de tiendas Shopify es?",
    answer: "Para tiendas Shopify con más de 50 productos que ya tienen tráfico orgánico pero sienten que están estancadas, que no saben si su problema es técnico, de contenido o de estructura de catálogo. No es para tiendas que recién empiezan sin datos en GSC.",
  },
  {
    question: "¿Necesito tener los dos servicios por separado para contratar el Sprint?",
    answer: "No. El Sprint está diseñado precisamente para eso: recibes ambos diagnósticos integrados en un solo entregable con un roadmap unificado. Sale más barato y es más coherente que comprar los dos servicios por separado.",
  },
  {
    question: "¿Esto reemplaza a la Auditoría SEO Técnica o a la Estrategia de Catálogo?",
    answer: "No. Ambos servicios siguen disponibles por separado si solo necesitas uno de los dos. El Sprint es una oferta temporal que los combina para darte una visión completa.",
  },
  {
    question: "¿Cuánto tiempo dura el Sprint?",
    answer: "Una semana aproximadamente, desde el kickoff hasta la entrega del roadmap. El strategy walkthrough se agenda dentro de los 5 días hábiles posteriores a la entrega.",
  },
  {
    question: "¿Necesito acceso a Google Search Console?",
    answer: "Sí. GSC es la fuente principal de datos para el análisis. También necesito acceso de solo lectura a GA4 y acceso colaborador en Shopify. No requiero acceso a checkout ni datos de clientes.",
  },
  {
    question: "¿Incluye implementación de los cambios?",
    answer: "No. El entregable es estratégico: informes, planes y roadmaps listos para que tu equipo implemente. Si necesitas ayuda con la implementación, podemos cotizarlo como proyecto aparte.",
  },
  {
    question: "¿Puedo contratar solo la auditoría técnica o solo la estrategia de catálogo?",
    answer: "Sí. Ambos servicios están disponibles por separado en sus páginas individuales. El Sprint es una oferta de lanzamiento que los combina por un precio más accesible.",
  },
  {
    question: "¿Por qué el precio de lanzamiento es $500?",
    answer: "Estoy productizando mi proceso de consultoría SEO para Shopify. Durante esta fase de lanzamiento, ofrezco el Sprint completo a un precio inaugural mientras refino el proceso y recojo retroalimentación de los primeros clientes. Una vez que termine esta etapa, el Sprint combinado tendrá un precio distinto.",
  },
  {
    question: "¿Qué pasa cuando termina la oferta de lanzamiento?",
    answer: "Ambos servicios seguirán disponibles por separado a sus tarifas estándar. El Sprint como oferta combinada podría continuar, pero a un precio diferente al inaugural.",
  },
];

const processSteps = [
  {
    title: "Kickoff",
    description: "Entiendo tu tienda, tus prioridades de negocio, tu catálogo y la situación actual de SEO. Coordinamos accesos a GSC, GA4 y Shopify.",
  },
  {
    title: "Research & Analysis",
    description: "Revisión técnica de la tienda, análisis de demanda de búsqueda, evaluación de Google Search Console y auditoría de contenido y catálogo.",
  },
  {
    title: "Strategy & Roadmap",
    description: "Convierto los hallazgos en un plan priorizado con acciones concretas para los próximos 90 días: qué corregir, qué consolidar, qué crear y en qué orden.",
  },
  {
    title: "Strategy Walkthrough",
    description: "Sesión de 60 minutos para explicar los hallazgos, las recomendaciones y las prioridades. Resolvemos dudas y alineamos al equipo.",
  },
];

const pains = [
  "Has producido mucho contenido, pero parte de él compite entre sí por las mismas búsquedas",
  "El blog posiciona para consultas que deberían llevar a categorías o productos de tu tienda",
  "Shopify genera páginas duplicadas o innecesarias que diluyen tu autoridad en Google",
  "No está claro qué categorías, productos o temas tienen demanda real en el mercado",
  "El equipo sigue produciendo contenido sin saber qué debería reescribirse o consolidarse",
  "Google Search Console muestra oportunidades, pero no existe una forma clara de priorizarlas",
];

const outcomes = [
  "Qué está frenando tu crecimiento orgánico — los problemas técnicos, estructurales y de contenido que merecen atención",
  "Qué páginas están compitiendo entre sí — canibalización y oportunidades de consolidación",
  "Qué contenido deberías reescribir — páginas desactualizadas, débiles o desalineadas con la intención de búsqueda",
  "Qué contenido deberías consolidar — páginas superpuestas que deben convertirse en un solo recurso más fuerte",
  "Dónde existe demanda que todavía no estás aprovechando — oportunidades basadas en datos de búsqueda reales",
  "Qué debería hacer tu equipo durante los próximos 90 días — un roadmap priorizado por impacto potencial y esfuerzo",
];

const deliverableCards = [
  {
    eyebrow: "AUDITORÍA",
    title: "Technical SEO Audit",
    description: "Identificamos los problemas técnicos y de Shopify que impiden que Google descubra, entienda e indexe tu tienda eficientemente: indexación, contenido duplicado, crawlabilidad, linking interno, datos estructurados y configuración de Shopify.",
    tag: "Informe completo",
    link: { text: "Ver servicio completo →", href: "/servicios/auditoria-seo-tecnica/" },
  },
  {
    eyebrow: "ESTRATEGIA",
    title: "Catalog Strategy",
    description: "Identificamos qué buscan realmente tus clientes y cómo esa demanda debería reflejarse en tu catálogo: keyword research, intención de búsqueda, mapeo de temas, oportunidades de categorías, productos y contenido.",
    tag: "Plan de implementación",
    link: { text: "Ver servicio completo →", href: "/servicios/estrategia-de-catalogo/" },
  },
  {
    eyebrow: "ROADMAP",
    title: "Roadmap priorizado a 90 días",
    description: "No recibes una lista de tareas. Recibes exactamente qué hacer en los próximos 90 días, ordenado por impacto potencial y esfuerzo de implementación.",
    tag: "Quick Wins + Mediano plazo",
  },
  {
    eyebrow: "CONTENIDO",
    title: "Recomendaciones de consolidación",
    description: "Recomendaciones precisas sobre qué páginas reescribir, cuáles consolidar, cuáles expandir, cuáles eliminar y cuáles mantener. El objetivo no es crear más contenido, sino construir el contenido correcto.",
    tag: "Auditoría de contenido",
  },
  {
    eyebrow: "OPORTUNIDADES",
    title: "Priorización de oportunidades de búsqueda",
    description: "Mapeamos los términos con mayor potencial no aprovechado y te mostramos dónde enfocar tu esfuerzo de contenido para capturar tráfico nuevo.",
    tag: "Análisis de brechas",
  },
  {
    eyebrow: "SESIÓN",
    title: "Strategy Walkthrough de 60 minutos",
    description: "Sesión dedicada a recorrer todos los hallazgos, el roadmap y las recomendaciones. Resolvemos dudas y alineamos prioridades con tu equipo.",
    tag: "Videollamada",
  },
];

const idealCards = [
  "Tu tráfico orgánico lleva meses estancado y no sabes por qué",
  "Tienes problemas técnicos pero también sospechas que tu estructura de catálogo no ayuda",
  "Quieres una visión completa antes de invertir en contenido nuevo o rediseñar la tienda",
  "Estás considerando expandir tu catálogo y necesitas saber qué funciona y qué no",
  "No sabes si tu prioridad debe ser técnica, estratégica o ambas",
  "Has comprado servicios de SEO antes y terminaste con informes que no sabías cómo usar",
  "Tu equipo necesita dirección clara para los próximos meses sin depender de suposiciones",
  "Quieres tomar decisiones informadas sobre contenido, estructura y esfuerzo técnico",
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Shopify SEO Sprint",
  name: "Shopify SEO Sprint",
  description: "Engagement combinado de Technical SEO Audit y Catalog Strategy en un roadmap priorizado para Shopify. Precio inaugural.",
  provider: {
    "@type": "ProfessionalService",
    name: "Alex Spelucin",
    email: "alex@spelucin.pro",
  },
  areaServed: ["MX", "AR", "US", "ES"],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(f => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Base
  title={meta.title}
  description={meta.description}
  image={meta.image}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <Nav />
  <div style="background: #fff">

    {/* ── Hero ──────────────────────────────────────────── */}
    <section style="padding-top: 10rem; padding-bottom: 0">
      <div class={`${W} reveal`}>
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 3.5rem">
          <a href="/sprints/" style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(21,96,189,0.45); text-decoration: none; text-transform: uppercase">
            <span style="transform: rotate(180deg); display: inline-block"><IconArrowRight /></span> Sprints
          </a>
          <div style="flex: 1; height: 1px; background: rgba(21,96,189,0.10)" />
          <Eyebrow>Shopify SEO Sprint</Eyebrow>
        </div>

        <h1 style="font-size: clamp(2.25rem, 5.5vw, 4rem); font-weight: 700; line-height: 1.04; letter-spacing: -0.04em; color: #0d1f3c; margin: 0 0 1.5rem; max-width: 22ch">
          Tu tienda tiene problemas de SEO. ¿Sabes cuáles están frenando su crecimiento?
        </h1>
        <p style="font-size: 1.1rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0 0 2.5rem; max-width: 50ch">
          Un engagement de una semana enfocado en identificar los problemas, las oportunidades y las prioridades que afectan el crecimiento orgánico de tu tienda Shopify.
        </p>
        <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 4rem">
          <Button href="/contacto/">
            Agendar el Sprint <IconArrowRight />
          </Button>
          <span style="display: inline-flex; align-items: center; gap: 0.6rem">
            <span style="font-size: 0.7rem; font-weight: 500; color: rgba(13,31,60,0.3)">$2,100+ valor por separado</span>
            <span style="font-size: 1rem; font-weight: 700; color: #1560bd">$500</span>
            <span style="font-size: 0.68rem; font-weight: 600; color: #1560bd; background: rgba(21,96,189,0.08); padding: 0.25rem 0.6rem; border-radius: 999px; letter-spacing: 0.02em">Lanzamiento</span>
          </span>
        </div>
        <div style={rule} />
      </div>
    </section>

    {/* ── Positioning ──────────────────────────────────── */}
    <section style="padding: 6rem 0">
      <div class={`${W} reveal`}>
        <div class="grid md:grid-cols-12 gap-8 items-center">
          <div style="grid-column: span 5">
            <span style="font-size: 3rem; line-height: 1; color: rgba(21,96,189,0.08); font-weight: 700; letter-spacing: -0.06em; display: block; margin-bottom: 1rem">//</span>
            <p style="font-size: 1.15rem; line-height: 1.65; color: rgba(13,31,60,0.6); margin: 0; font-style: italic">
              El SEO técnico no sirve de mucho si no sabes qué debería existir en tu tienda.
            </p>
          </div>
          <div style="grid-column: 7 / -1">
            <p style="font-size: 0.9375rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0">
              Una tienda puede estar técnicamente bien y aun así invertir en contenido que no genera demanda, crear páginas que compiten entre sí o hacer crecer el blog mientras sus categorías y productos quedan atrás.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── El problema ───────────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <div class="grid md:grid-cols-12 gap-8">
          <div style="grid-column: span 4">
            <Eyebrow>El problema</Eyebrow>
            <h2 style="font-size: clamp(1.35rem, 2.5vw, 1.65rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 0; line-height: 1.25">
              Mucho contenido no significa una mejor estrategia de búsqueda
            </h2>
          </div>
          <div style="grid-column: span 8">
            {pains.map((pain, i) => (
              <div>
                <div style="display: flex; gap: 1rem; padding-top: 1.25rem; padding-bottom: 1.25rem">
                  <span style="font-size: 0.7rem; font-weight: 700; color: rgba(21,96,189,0.4); flex-shrink: 0; padding-top: 0.15rem; font-variant-numeric: tabular-nums">0{i + 1}</span>
                  <p style="font-size: 0.9375rem; line-height: 1.7; color: rgba(13,31,60,0.7); margin: 0">{pain}</p>
                </div>
                {i < pains.length - 1 && <div style={rule} />}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── Lo que sabrás ──────────────────────────────── */}
    <section style="padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Lo que sabrás después del sprint</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3rem; line-height: 1.2">
          Claridad para tomar decisiones, no un informe para archivar
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {outcomes.map((item) => (
            <div style="display: flex; gap: 0.75rem; align-items: flex-start; border: 1px solid rgba(21,96,189,0.08); border-radius: 0.75rem; padding: 1.25rem 1.5rem">
              <span style="flex-shrink: 0; margin-top: 0.1rem">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1560bd" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <p style="font-size: 0.9rem; line-height: 1.6; color: rgba(13,31,60,0.7); margin: 0">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Qué incluye ──────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Qué incluye</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3rem; line-height: 1.2">
          Los dos diagnósticos que necesitas, en un solo Sprint
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {deliverableCards.map((card) => (
            <div style="border: 1px solid rgba(21,96,189,0.08); border-radius: 0.75rem; padding: 2rem; transition: border-color 0.2s ease;">
              <div style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(21,96,189,0.5); margin-bottom: 0.75rem">{card.eyebrow}</div>
              <h3 style="font-size: 1.1rem; font-weight: 700; color: #0d1f3c; margin: 0 0 0.5rem; letter-spacing: -0.02em; line-height: 1.3">{card.title}</h3>
              <p style="font-size: 0.875rem; line-height: 1.65; color: rgba(13,31,60,0.55); margin: 0 0 1rem">{card.description}</p>
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem">
                <span style="font-size: 0.75rem; font-weight: 600; color: rgba(21,96,189,0.4)">{card.tag}</span>
                {card.link && (
                  <a href={card.link.href} style="font-size: 0.78rem; font-weight: 600; color: #1560bd; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem">
                    {card.link.text}
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Para quién es ──────────────────────────────── */}
    <section style="padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Para quién es</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3rem; line-height: 1.2">
          Ideal para tiendas que necesitan salir del estancamiento y tener un plan claro
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {idealCards.map((sit) => (
            <div style="border: 1px solid rgba(21,96,189,0.08); border-radius: 0.75rem; padding: 1.5rem 2rem; transition: border-color 0.2s ease;">
              <p style="font-size: 0.9375rem; line-height: 1.65; color: rgba(13,31,60,0.7); margin: 0">{sit}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Proceso ────────────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <Eyebrow>Proceso</Eyebrow>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0.5rem 0 3.5rem; line-height: 1.2">
          Cómo funciona el Sprint
        </h2>

        <div class="grid md:grid-cols-12 gap-10 items-start">
          <div style="grid-column: span 7">
            {processSteps.map((step, i, arr) => (
              <div style={`display: grid; grid-template-columns: 3rem 1fr; gap: 1.5rem; padding: 1.75rem 0 ${i < arr.length - 1 ? '1.75rem' : '0'}; ${i < arr.length - 1 ? 'border-bottom: 1px solid rgba(21,96,189,0.06)' : ''}`}>
                <span style="font-size: 0.8rem; font-weight: 700; color: rgba(21,96,189,0.35); font-variant-numeric: tabular-nums; padding-top: 0.15rem; letter-spacing: 0.02em">0{i + 1}</span>
                <div>
                  <h3 style="font-size: 1.05rem; font-weight: 700; color: #0d1f3c; margin: 0 0 0.5rem; letter-spacing: -0.02em">{step.title}</h3>
                  <p style="font-size: 0.9rem; line-height: 1.7; color: rgba(13,31,60,0.6); margin: 0; max-width: 52ch">{step.description}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="process-sticky" style="grid-column: span 5;">
            <ServiceReportMockup variant="shopify-seo-sprint" />
          </div>
        </div>
      </div>
    </section>

    {/* ── Launch Offer ──────────────────────────────── */}
    <section style="padding: 7rem 0; background: #fff">
      <div class={`${W} reveal`}>
        <div class="launch-offer-glass" style="margin-top: 3.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; max-width: 52rem; position: relative; overflow: hidden; border-radius: 1.25rem; padding: 3rem; border: 1px solid rgba(21,96,189,0.14); box-shadow: 0 4px 24px rgba(21,96,189,0.06), inset 0 1px 0 rgba(255,255,255,0.8); background: linear-gradient(135deg, rgba(21,96,189,0.06) 0%, rgba(21,96,189,0.02) 50%, rgba(124,58,237,0.04) 100%); background-image: radial-gradient(circle, rgba(21,96,189,0.18) 1px, transparent 1px), linear-gradient(135deg, rgba(21,96,189,0.06) 0%, rgba(21,96,189,0.02) 50%, rgba(124,58,237,0.04) 100%); background-size: 20px 20px, 100% 100%; background-position: 0 0, 0 0">
          <div style="position: relative; z-index: 1">
            <Eyebrow>Launch Offer</Eyebrow>
            <p style="font-size: 1rem; line-height: 1.7; color: rgba(13,31,60,0.65); margin: 1rem 0 0; max-width: 36ch">
              Estoy productizando mi proceso de consultoría SEO para Shopify. Por tiempo limitado, estoy abriendo un número reducido de Sprints a un precio inaugural mientras refino el proceso y recojo retroalimentación.
            </p>
          </div>

          <div style="position: relative; z-index: 1; border-radius: 1rem; padding: 2.5rem; background: rgba(255,255,255,0.6); backdrop-filter: blur(4px); border: 1px solid rgba(21,96,189,0.10)">
            <div style="font-size: 0.8rem; color: rgba(13,31,60,0.4); line-height: 1.6; margin-bottom: 1.5rem">
              <span style="font-size: 0.95rem; font-weight: 700; color: #0d1f3c; display: block; margin-bottom: 0.35rem">Valor cuando se compran por separado</span>
              <span style="font-size: 1.3rem; font-weight: 700; color: rgba(13,31,60,0.25); text-decoration: line-through">$2,100+</span>
              <div style="font-size: 0.72rem; color: rgba(13,31,60,0.35); margin-top: 0.25rem">
                Auditoría SEO Técnica: desde $1,200&nbsp;·&nbsp;Estrategia de Catálogo: desde $900
              </div>
            </div>

            <div style={rule} />

            <div style="margin-top: 1.5rem; margin-bottom: 1.5rem">
              <div style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #1560bd; margin-bottom: 0.5rem">Precio de lanzamiento</div>
              <div style="font-size: clamp(2.5rem, 4vw, 3rem); font-weight: 700; color: #0d1f3c; letter-spacing: -0.03em; line-height: 1">$500</div>
              <div style="font-size: 0.8rem; color: rgba(13,31,60,0.45); margin-top: 0.35rem">Número limitado de engagements durante el lanzamiento</div>
            </div>

            <Button href="/contacto/">
              Agendar el Sprint <IconArrowRight />
            </Button>
          </div>
        </div>
      </div>
    </section>

    <style>
      .launch-offer-glass::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.55);
        pointer-events: none;
        border-radius: inherit;
      }
    </style>

    {/* ── FAQ ────────────────────────────────────────── */}
    <section style="background: var(--color-surface); padding: 7rem 0">
      <div class={`${W} reveal`}>
        <div style={rule} />
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 3.5rem 0 2.5rem; line-height: 1.2">
          Preguntas frecuentes
        </h2>
        <div style="display: flex; flex-direction: column; gap: 0">
          {faqs.map((item, i) => (
            <>
              {i > 0 && <div style="height: 1px; background: rgba(21,96,189,0.07)" />}
              <div style="padding: 1.5rem 0">
                <div style="font-size: 0.95rem; font-weight: 600; color: #0d1f3c; line-height: 1.4; margin-bottom: 0.5rem">{item.question}</div>
                <p style="font-size: 0.9rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0">{item.answer}</p>
              </div>
            </>
          ))}
        </div>
      </div>
    </section>

    {/* ── Final pre-CTA ─────────────────────────────── */}
    <section style="padding: 5rem 0; background: #fff">
      <div class={`${W} reveal`}>
        <div style="text-align: center; max-width: 42rem; margin: 0 auto">
          <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em; color: #0d1f3c; margin: 0 0 1rem; line-height: 1.2">
            Deja de adivinar qué debería hacer tu equipo de SEO.
          </h2>
          <p style="font-size: 1rem; line-height: 1.7; color: rgba(13,31,60,0.55); margin: 0 0 2rem; max-width: 48ch">
            Sal del Sprint con una visión clara de qué está frenando tu tienda, qué oportunidades existen y qué debería priorizar tu equipo durante los próximos 90 días.
          </p>
          <Button href="/contacto/" size="lg">
            Agendar el Sprint <IconArrowRight />
          </Button>
        </div>
      </div>
    </section>

    {/* ── CTA ────────────────────────────────────────── */}
    <CTA
      id="cta"
      heading="¿No sabes si este Sprint es para tu tienda?"
      description="Llamada gratuita de 30 minutos. Evaluamos tu situación y te confirmamos si el Sprint es el engagement correcto."
      buttonText="Agendar llamada"
    />

  </div>
  <Footer />
