---
export async function getStaticPaths() {
  const categories = ['SEO Técnico', 'Shopify', 'AI Search', 'Estrategia', 'Procesos'];
  return categories.map(category => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props;
const targetUrl = `/escritura/?categoria=${encodeURIComponent(category)}`;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={targetUrl} />
    <title>Redireccionando...</title>
  </head>
  <body>
    <p>Redireccionando a la categoría... Si no eres redirigido, <a href={targetUrl}>haz clic aquí</a>.</p>
    <script define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
  </body>
</html>
